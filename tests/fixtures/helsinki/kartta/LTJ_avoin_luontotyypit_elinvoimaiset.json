ull,"lsl_lt_nimi":null,"vesilakikohde":null,"vesilaki_lt_nimi":null,"arvoluokka_helsinki":"I*","arvoluokan_selite":null,"selvitys":"Kallahden rantaniityn luontotyyppi- ja kasvillisuusselvitys sekä virkistyskäyttöselvitys","kuvionumero":75,"yritys":"Ramboll Finland Oy"}},{"type":"Feature","id":"LTJ_avoin_luontotyypit_elinvoimaiset.3545","geometry":{"type":"MultiPolygon","coordinates":[[[[25.092123,60.165731],[25.092137,60.165723],[25.091935,60.165708],[25.091767,60.165713],[25.091552,60.165728],[25.091306,60.165765],[25.091249,60.165804],[25.091188,60.165896],[25.091242,60.165974],[25.091276,60.166044],[25.091277,60.166045],[25.091837,60.165852],[25.092017,60.16579],[25.092123,60.165731]]]]},"geometry_name":"geom","properties":{"id":3545,"paaryhma":"Kalliot ja kivikot, Metsät","luontotyyppi":"Karut poronjäkälä-sammalkalliot, Kalliometsät","lt_koodi":null,"iucn_e":"LC, NT","iucn_e_teksti":"Säilyvät, Silmälläpidettävät","luokittelu":"LuTU (2018)","vuosi":"2019","pvm_alku":null,"pvm_loppu":null,"kohde_nimi":"Itäniityn laakso 3d","tunnus":null,"luonnontila_lk":2,"kuluneisuus_lk":null,"edustavuus_lk":3,"luonnontila":"Vähän heikentynyt","kuluneisuus":null,"edustavuus":"Kohtalainen","kuvaus":"Varsinkin selvitysalueen pohjoisosan kallioilla on avokalliolaikkuja, mutta enimmäkseen kallioilla kasvaa harvaa kalliomännikköä, joka voidaan latvuspeittävyyden perusteella luokitella kalliometsäksi. Männikkö on pääosin kitukasvuista ja pientä, mutta harvan ylimmän latvuskerroksen rinnankorkeusläpimitta vaihtelee välillä 10–25 cm. Siellä täällä on vanhoja kilpikaarnaisia mäntyjä ja keloja. Selvitysalueen eteläreunan kalliometsässä tavataan lisäksi sivupuina vähän kuusta ja koivua. Kallioilla on vähäistä kuluneisuutta, mutta lajisto vastaa melko hyvin luontotyypin kuvausta. Pensaskerroksessa kasvaa katajaa. Kenttäkerroksessa runsaita lajeja ovat metsälauha, puolukka, ahosuolaheinä, kanerva, kangasmaitikka, mustikka ja kallioimarre. Paikoittaista keskiravinteisuutta ilmentää mm. kalliokielon, isomaksaruohon, lehtoarhon, keto-orvokin, haisukurjenpolven ja tuoksusimakkeen esiintyminen. Paikoin on myös kookkaita kivikkoalvejuuren kasvustoja. Pohjakerroksessa kasvaa poronjäkälää, seinäsammalta, tierasammalia, kangaskarhunsammalta sekä valuvesipinnoilla kangasrahkasammalta. Poronjäkälikkö ei ole kallioilla erityisen paksu.","lisatieto":null,"suositukset":null,"pinta_ala":0.09690576698761433,"pituus":null,"indikaattorilajit":null,"huomionarvoiset_lajit":null,"vieraslaji_pros":null,"vieraslajit":null,"lahopuu":null,"raporttilinkki":null,"natura_luontotyyppi":null,"natura_koodi":null,"natura_edustavuus_lk":null,"lsl_luontotyyppi":null,"lsl_lt_nimi":null,"vesilakikohde":null,"vesilaki_lt_nimi":null,"arvoluokka_helsinki":null,"arvoluokan_selite":null,"selvitys":"Luontoselvitykset Helsingin Laajasalon ja Jollaksen luonnonsuojelualueilla ja kaupungin luonnonsuojeluohjelman kohteilla vuonna 2019","kuvionumero":null,"yritys":null}},{"type":"Feature","id":"LTJ_avoin_luontotyypit_elinvoimaiset.54","geometry":{"type":"MultiPolygon","coordinates":[[[[25.164685,60.184683],[25.164767,60.184576],[25.164866,60.184483],[25.165001,60.184381],[25.165159,60.184215],[25.165244,60.184136],[25.165362,60.183996],[25.165546,60.184019],[25.165715,60.183937],[25.165723,60.183864],[25.165573,60.183837],[25.165653,60.183732],[25.165762,60.183655],[25.165837,60.183615],[25.165899,60.183555],[25.165897,60.183513],[25.165885,60.183477],[25.165838,60.183433],[25.165827,60.183384],[25.165821,60.183332],[25.165846,60.18329],[25.165926,60.183307],[25.165983,60.183339],[25.166062,60.183374],[25.166112,60.183442],[25.166122,60.183507],[25.166141,60.183575],[25.166093,60.183634],[25.166032,60.183681],[25.16593,60.183718],[25.165915,60.183751],[25.165881,60.183797],[25.165935,60.183894],[25.165865,60.183989],[25.165753,60.184064],[25.165553,60.184146],[25.16542,60.184181],[25.165483,60.184256],[25.165375,60.184311],[25.165241,60.184318],[25.165165,60.184356],[25.16506,60.18446],[25.165003,60.184557],[25.164856,60.184633],[25.164839,60.184692],[25.164685,60.184683]]]]},"geometry_name":"geom","properties":{"id":54,"paaryhma":"Kalliot ja kivikot","luontotyyppi":"Karut ja keskiravinteiset merenrantakalliot","lt_koodi":null,"iucn_e":"LC","iucn_e_teksti":"Säilyvät","luokittelu":"LuTU (2018)","vuosi":"2018","pvm_alku":null,"pvm_loppu":null,"kohde_nimi":"Kalliosaaren itärannan kalliot ","tunnus":"944/2018","luonnontila_lk":2,"kuluneisuus_lk":2,"edustavuus_lk":2,"luonnontila":"Vähän heikentynyt","kuluneisuus":"Kulumista havaittavissa","edustavuus":"Hyvä","kuvaus":"Itärannan yhtenäinen rantakallio, jossa muutamia soraikkokohtia. Kapeat kalliot, joiden takana metsämaa. Pääasiassa kasvittomia silokallioita. Rannassa myös lohkareikkoa. Jäkälät puuttuvat lähes täysin kallioiden yläosaa lukuun ottamatta, jossa karpeet yleisiä. ","lisatieto":"Saarissa erittäin haasteellinen luontotyyppipari on karut merenrantakalliot ja keskiravinteiset merenrantakalliot. Näiden erottaminen toisistaan on hyvin vaikeaa luontotyyppikuvausten perusteella. Inventoinnissa kohteet on yhdistetty yhdeksi luontotyypiksi ”Karut ja keskiravinteiset merenrantakalliot”, koska luontotyyppien erottaminen toisistaan on vaikeaa. Yhdistetyn luontotyypin uhanalaisuusluokaksi on merkitty säilyvä (LC).","suositukset":null,"pinta_ala":0.21294735942503903,"pituus":null,"indikaattorilajit":"keltamaksaruoho, kataja, mänty, maitohorsma, suolavihvilä, ruokohelpi, mesiangervo, rauduskoivu, rantakukka, rantatädyke, ketohanhikki","huomionarvoiset_lajit":null,"vieraslaji_pros":"0 %","vieraslajit":"Ei havaittu","lahopuu":null,"raporttilinkki":"https://ptp.hel.fi/ltj_documents/html/linkitetyt_ltj/Luontotyypit/lt_2018_944.pdf","natura_luontotyyppi":null,"natura_koodi":null,"natura_edustavuus_lk":null,"lsl_luontotyyppi":null,"lsl_lt_nimi":null,"vesilakikohde":null,"vesilaki_lt_nimi":null,"arvoluokka_helsinki":null,"arvoluokan_selite":null,"selvitys":"Helsingin uhanalaisten luontotyyppien inventoinnit 2018","kuvionumero"