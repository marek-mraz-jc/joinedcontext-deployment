ikkatietohakemisto/metadata/?id=162&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_arvokkaat_geologiset_aluemaiset.137175","geometry":{"type":"Polygon","coordinates":[[[25.040301,60.16247],[25.040239,60.162487],[25.040156,60.162485],[25.040139,60.162451],[25.040144,60.162356],[25.040158,60.162271],[25.040195,60.162204],[25.040262,60.16214],[25.040405,60.162052],[25.040533,60.161955],[25.040587,60.16188],[25.040675,60.16186],[25.040761,60.161874],[25.04088,60.161886],[25.040962,60.161907],[25.040971,60.16194],[25.040948,60.16199],[25.040881,60.16204],[25.040838,60.162087],[25.040834,60.16214],[25.040824,60.162159],[25.040753,60.16222],[25.040677,60.162289],[25.04053,60.162354],[25.040301,60.16247]]]},"geometry_name":"geometry1","properties":{"id":137175,"tunnus":"11-016","luokkatunnus":"GK","luokan_nimi":"Geologisesti tai geomorfologisesti arvokas kohde","nimi":"Granaattikarsi, Vuorilahti","kuvaus":"Karsimuodostuma. Kallio osin lähes pelkkää andradiittia (Ca-Fe-granaatti). Myös diopsidi-hedenbergiittiä, sarvivälkettä ja epidoottia. Lisäksi näkyy mustaliuskekerros, jossa pelkistynyttä keltaista rikkiä ja ruostetta. Graniittijuonia.","huom":"Harvinainen muodostuma. Arvo tieteellinen ja opetuksellinen.","pinta_ala_ha":0.17,"kohdeteksti":"Sijainti: Laajasalo, Vuorilahden uimarannan eteläpuolinen kallio. Karsiosuuden koko 40 m x 100 m. Puhdas merenrantakallio, saavutettavuus hyvä. Myös granaattilouhos (kohde 1510). Tila 23.4.2002 hyvä. Tunnus julkaisussa Kananoja & Grönholm 1993: 52.","arvoluokka":"b, a, 2","arvoluokan_selite":"Suojeluarvo: maakunnallinen, Maisema-arvo: merkittävä, Geologinen arvo: kohtalainen","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=162&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_arvokkaat_geologiset_aluemaiset.137158","geometry":{"type":"Polygon","coordinates":[[[24.882728,60.18421],[24.8823