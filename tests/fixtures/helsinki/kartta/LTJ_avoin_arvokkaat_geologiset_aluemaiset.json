24.95692,60.15405],[24.956805,60.154031],[24.95679,60.153966],[24.956816,60.153938],[24.956865,60.15393],[24.956938,60.153957],[24.957015,60.153994],[24.957078,60.153982],[24.957147,60.153987],[24.957197,60.154004],[24.957227,60.154017],[24.957199,60.154036],[24.957199,60.154053]]]},"geometry_name":"geometry1","properties":{"id":137159,"tunnus":"11-003","luokkatunnus":"GK","luokan_nimi":"Geologisesti tai geomorfologisesti arvokas kohde","nimi":"Migmatiittinen gneissi, Kaivopuisto","kuvaus":"Alkuperältään vulkaaninen gneissi, jossa on lapilleja ja graniittisuonia. Pysty poimurakenne.","huom":"Saavutettavuus erinomainen ja pinta puhdas ja tasainen. Arvo tieteellinen ja opetuksellinen.","pinta_ala_ha":0.022917692052023753,"kohdeteksti":"<p>Sijainti: Kaivopuisto. Koko: 3-4 m x 12 m ja 4 m x 5 m. Paikalla my&ouml;s pieni rapakivigraniittinen siirtolohkare. Tila 2015 hyv&auml;.<br />\r\n<br />\r\n<img alt=\"Geologinen kohde 11-03\" src=\"https://ptp.hel.fi/ltj_documents/html/linkitetyt_ltj/Kuvat/Geologiset_kohteet/11_003_a_Antti_Salla_2015.JPG\" style=\"width:100%\" /><br />\r\nKuva: Antti Salla 2015.<br />\r\n<br />\r\n<img alt=\"Geologinen kohde 11-03\" src=\"https://ptp.hel.fi/ltj_documents/html/linkitetyt_ltj/Kuvat/Geologiset_kohteet/11_003_b_Antti_Salla_2015.JPG\" style=\"width:100%\" /><br />\r\nKuva: Antti Salla 2015.</p>","arvoluokka":"a, 1, a, a","arvoluokan_selite":"Suojeluarvo: kansainvälinen, Geologinen arvo: suuri, Maisema-arvo: merkittävä, Suojeluarvo: Rauhoitettu","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=162&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_arvokkaat_geologiset_aluemaiset.137165","geometry":{"type":"MultiPolygon","coordinates":[[[[25.048195,60.184524],[25.047491,60.184966],[25.047138,60.185152],[25.046834,60.18529],[25.04631,60.185528],[25.045948,60.185637],[25.045843,60.185637],[25.04651,60.185361],[25.046971,60.185125],[25.047652,60.184762],[25.0479