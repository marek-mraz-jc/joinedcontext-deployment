säksi mm. ulpukkaa, limaskaa ja pajuja. Lammelle johtavat pitkospuut joiden päähän on tehty katselutasanne. Lampi on osa arvokasta lepakkoaluetta ja linnustollisesti arvokasta kohdetta. \r\n","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=165&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_vesi_lammet.178496","geometry":{"type":"Polygon","coordinates":[[[25.150323,60.229179],[25.150252,60.229227],[25.150108,60.229191],[25.150108,60.229108],[25.150131,60.229049],[25.150011,60.228954],[25.150011,60.228895],[25.150058,60.228835],[25.150344,60.22874],[25.150391,60.228645],[25.15063,60.228656],[25.150798,60.228739],[25.150798,60.228786],[25.150632,60.228882],[25.150656,60.228953],[25.150584,60.228977],[25.150465,60.228977],[25.150465,60.229001],[25.150466,60.229108],[25.150395,60.229155],[25.150323,60.229179]]]},"geometry_name":"geometry1","properties":{"id":178496,"tunnus":"LAM11","luokkatunnus":"LAM","luokan_nimi":"Lammet","nimi":"Syvälampi","kuvaus":null,"huom":null,"pinta_ala_ha":0.15,"kohdeteksti":"Mustavuoren lampi on entisen kalkkikaivoksen paikalla. Se on\r\npääosin jyrkkärantainen. Ympärillä kasvaa lehtimetsää ja läheltä, selvästi lampea ylempää, kulkee hiekkatie. Jyrkkien rantojen vuoksi suurvesikasvillisuutta on hyvin niukasti. Lampi kuuluu Niinisaarentien kalliojakson pohjoisosan arvokkaaseen kasvillisuusalueeseen (luokka I).","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=165&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_vesi_lammet.182099","geometry":{"type":"Polygon","coordinates":[[[25.182403,60.269372],[25.182618,60.26943],[25.182753,60.26943],[25.183042,60.269343],[25.183447,60.269406],[25.183476,60.269436],[25.18345,60.269473],[25.183247,60.269478],[25.183126,60.269492],[25.183035,60.269534],[25.182929,60.269535],[25.182865,60.269512],[25.182734,60.26954],[25.182731,60.269578],[2