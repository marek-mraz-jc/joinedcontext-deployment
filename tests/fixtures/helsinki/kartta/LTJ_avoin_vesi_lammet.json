0.190073],[24.936055,60.19006],[24.936096,60.190029],[24.936091,60.18998],[24.936091,60.18992],[24.936091,60.18991],[24.936065,60.189899],[24.936055,60.189899],[24.936023,60.18991],[24.935971,60.189993],[24.935929,60.190008],[24.935867,60.190053],[24.935861,60.19006],[24.935861,60.190081],[24.935924,60.190094],[24.935997,60.190073]]]},"geometry_name":"geometry1","properties":{"id":178256,"tunnus":"LAM23","luokkatunnus":"LAM","luokan_nimi":"Lammet","nimi":"Alppipuiston lammet","kuvaus":null,"huom":null,"pinta_ala_ha":0.22,"kohdeteksti":"Alppipuistossa on kaksi lampea. Lammet ovat entisiä jätevedenpuhdistamon altaita. Nykyisissä lammissa on asfaltilla vuorattu pohja. Kävelytiet kulkevat molemmin puolin lampia ja lehtipuita kasvaa aivan rannassa luoden varjoisan\r\ntunnelman. Lammet ovat yhteydessä toisiinsa ja näyttävä suihkulähde koristaa ja samalla ilmastaa toista niistä.","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=165&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_vesi_lammet.178037","geometry":{"type":"Polygon","coordinates":[[[25.034919,60.1408],[25.03477,60.140733],[25.034648,60.140685],[25.034444,60.140605],[25.034295,60.140578],[25.034254,60.140537],[25.034267,60.140172],[25.034387,60.139727],[25.034481,60.139483],[25.034724,60.13924],[25.0349,60.139159],[25.035089,60.139145],[25.035387,60.139057],[25.035522,60.13905],[25.035847,60.138955],[25.036091,60.138935],[25.036321,60.138881],[25.036538,60.138867],[25.036578,60.138894],[25.036633,60.138995],[25.036701,60.139076],[25.036945,60.139225],[25.037068,60.13938],[25.037149,60.139508],[25.037205,60.139839],[25.037205,60.139988],[25.037206,60.140143],[25.037111,60.140285],[25.03699,60.140407],[25.036949,60.140474],[25.036855,60.140555],[25.036706,60.140603],[25.036219,60.140657],[25.035894,60.140657],[25.03565,60.140685],[25.035407,60.140786],[25.035285,60.140847],[25.035122,60.140861],[25.034987,60.140834],[25.034919,60.1408]]]},"geometry_name":"geometry1","properties":{"id":178037,"tunnus":"LAM08","luokkatunnus":"LAM","luokan_nimi":"Lammet","nimi":"Likolampi","kuvaus":null,"huom":null,"pinta_ala_ha":2.737390313061514,"kohdeteksti":"<p>Santahaminan toinen lampi, Likolampi, on suojaisalla paikalla lehtimets&auml;n ymp&auml;r&ouml;im&auml;n&auml;. Likolammen l&auml;heisyyteen on 1950-luvun alkuvuosina istutettu mm. hybridihaapaa, tammea, saarnia ja vaahteraa. Vuosina 1964 ja 1965 lammen lounaispuolelle tehtiin my&ouml;s laajoja havupuuistutuksia. Kauempana lammesta kulkee v&auml;h&auml;n liikenn&ouml;ity hiekkatie. Luoteiskulmaan on karttaan merkitty yksi tulo-oja. Lampi on aikanaan kaivettu j&auml;tevesien saostusaltaaksi. Se on otettu t&auml;h&auml;n k&auml;ytt&ouml;&ouml;n vuonna 1963 ja k&auml;ytt&ouml; on lopetettu 1981.<br />\r\n<br />\r\nLampi on kauttaaltaan hentokarvalehden (Ceratophyllum submersum) valtaama. T&auml;m&auml; on toistaiseksi vasta kolmas varmistettu hentokarvalehden esiintym&auml; Suomessa. Lis&auml;ksi lammessa on mm. uistinvitaa (Potamogeton natans) ja pikkulimaskaa (Lemna minor) sek&auml; rannoilla vehkaa.<br />\r\n<br />\r\nHelsingin kaupungin ymp&auml;rist&ouml;keskuksen luontotietoj&auml;rjestelm&auml;n mukaan alue on linnustoltaan arvokas (luokka II). Lajeiksi mainitaan luhtakerttunen, lapasorsa (Anas clypeata), tavi (Anas crecca), liejukana (Gallinula chloropus), kultarinta, siritt&auml;j&auml; (Phylloscopus sibilatrix), mustakurkku-uikku, ristisorsa, mets&auml;viklo (Tringa ochropus) ja peukaloinen. Kes&auml;ll&auml; lammella olikin paljon linnunpoikasia. Kaloja lammessa ei tiett&auml;v&auml;sti ole, mutta sammakoiden kurnutus raikaa lammella kev&auml;isin.</p>","metadata":"https://kartta.hel.fi/paikkatietohakemisto/metadata/?id=165&l=fi","datanomistaja":"Helsinki/LTJ","paivitetty_tietopalveluun":"2026-10-24"}},{"type":"Feature","id":"LTJ_avoin_vesi_lammet.178676","geometry":{"type":"MultiPolygon","coordinates":[[[[25.160586,60.21803],[25.160371,60.217