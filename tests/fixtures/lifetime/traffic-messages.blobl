# The step jc_manifest::lifetime::step renders for the spec.lifetime of the traffic-messages seed pipeline
# (platform 279df879), which the reconciler runs after the mapping (T-5353). Rerender it when that
# spec.lifetime or the platform's generator changes.
# spec.lifetime (PL-80…PL-82), generated by jcctl: the end times, after the author's steps.
map jc_lifetime {
  root = this
  if this.type == "Alert" {
    let start = this.validTo.value.(v -> if v.type() == "object" { v."@value" } else { v }).ts_unix().catch(null)
    let end = if $start != null { [$start + 0, timestamp_unix() + 3600].min() } else { timestamp_unix() + 3600 }
    if $end != null {
      root.expiresAt = $end.ts_format("2006-01-02T15:04:05Z", "UTC")
    }
    if $start == null {
      root._jc_lifetime_from = true
    }
  }
}
let jc_out = if this.type() == "array" { this.map_each(e -> if e.type() == "object" { e.apply("jc_lifetime") } else { e }) } else if this.type() == "object" { this.apply("jc_lifetime") } else { this }
let jc_failed = if $jc_out.type() == "array" { $jc_out.any(e -> e.type() == "object" && e._jc_lifetime_from.or(false) == true) } else { $jc_out.type() == "object" && $jc_out._jc_lifetime_from.or(false) == true }
if $jc_failed {
  meta jc_problem = "lifetime-from"
}
root = if $jc_out.type() == "array" { $jc_out.map_each(e -> if e.type() == "object" { e.without("_jc_lifetime_from") } else { e }) } else if $jc_out.type() == "object" { $jc_out.without("_jc_lifetime_from") } else { $jc_out }
