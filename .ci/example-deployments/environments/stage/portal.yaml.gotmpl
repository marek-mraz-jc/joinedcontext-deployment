---
portal:
  portal:
    # A Pipeline's `secretRef` decrypts with SOPS and this instance's own age identity (T-6443),
    # never dev's or prod's. Operator-supplied, created once from the identity kept in `.secrets/`:
    #
    #   kubectl -n stage create secret generic portal-age-identity \
    #     --from-file=keys.txt=<stage age key>
    #
    # Without it every reference is refused with "the age identity is unreadable" (fail closed).
    sopsAgeSecret: portal-age-identity
    # As smartcity (T-4717): the timer is the only sync, this Portal has no forge webhook secret.
    syncInterval: 120
