---
# jc-dev: one jc instance on the dev cluster (owner 2026-11-09 19:2xZ, tasks/GOAL-jc-dev.md
# 'Dev cluster rebuild'). Namespace jc-dev, host jc.jcdev.dev.joinedcontext.com, its own
# CloudNativePG cluster (kaisatsu's role names are fixed, so two instances cannot share one
# Postgres) reconciled by the dev environment's operator, which watches every namespace, and its own
# APISIX edge behind the kit's Traefik.
components:
  - prepare
  - secrets
  - networkpolicies
  - postgres
  - apisix
  # The server WASM Apps (jc-app-hosts slice 2): their store and database before jc, whose Portal
  # writes what each shard mounts, and the shards after it (tests/test_wasm_host.py).
  - artifact-store
  - apps-db
  - jc
  - wasm-host

global:
  # Its own domain under dev's wildcard A record: jc answers on jc.jcdev.dev.joinedcontext.com (slug
  # mode), the bare jcdev.dev.joinedcontext.com only on the edge's ACME path. dev's own apex stays dev's.
  domain: jcdev.dev.joinedcontext.com
  orgDomain: hel.fi
  instanceSlug: jc-dev
  profile: development
  # The installation's logo as old prod's smartcity branding named it: jc's catalogue footer mark,
  # favicon and /logo.svg ([dataroom.branding], components/jc/values/server).
  branding:
    logo: logo.svg
    favicon: logo.svg
    logoSvg: |
{{ readFile "branding/logo.svg" | indent 6 }}
  securityTxt:
    contact: mailto:contact@marek-mraz.com
    expires: "2027-09-24T00:00:00Z"
  serviceMesh:
    allowUnauthenticatedIngress: true
  ingress:
    enabled: true
    clusterIssuer: 'letsencrypt-prod'
    ingressClass: 'traefik'
  kubeApiCidrs: [10.255.0.101/32]

# The operator is the dev environment's (namespace dev, clusterWide since this change).
postgres:
  operator:
    enabled: false
  # One instance of three on a 16 GB node: jc's three stores ask for a third of dev's request and keep
  # its 2Gi ceiling (measure with kubectl top after the import and set the request from it).
  cluster:
    rawValues:
      cluster:
        resources:
          requests:
            cpu: 100m
            memory: 640Mi
          limits:
            memory: 2Gi


# The server WASM Apps' store and database (jc-app-hosts slice 2). Prod's `apps` bucket held 18 MB
# and apps-db 30 MB (final export, 2026-11-09), so 2Gi each. The store archives no WAL here (dev's
# 832Mi request is its WAL objects, T-5926): its idle working set, 96-105Mi on dev before the
# archive (T-4473), with room for a publish of the ten components.
artifact-store:
  store:
    storage:
      size: 2Gi
    rawValues:
      # A claim not made yet: it outlives its deletion (T-6718, local-path-retain).
      storage:
        storageClass: local-path-retain
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

jc:
  server:
    trustedProxies:
      - "10.42.0.0/16"
    # jc-prod's embedder, shared (components/embedder in jc-prod, callerNamespaces): the assistant
    # signs in with this realm's jc-assistant token; no model loads in this jc.
    embedder:
      url: http://embedder.jc-prod.svc.cluster.local:8089
      namespace: jc-prod
    # prod's publisher badges and words (owner 2026-10-12, release 23a43801 components/ckan/values/catalogue/
    # development-values.yaml.gotmpl `organizations`), copied from the monorepo's
    # bins/jc/docs/dataroom-publishers.toml: CKAN's own picture or description still wins.
    dataroomPublishers:
      hel-fi:
        initials: HEL
        colour: '#0000bf'
        description:
          en: 'Open data of the Helsinki region, live from HSL public transport, Fintraffic parking and the city''s own services, through joinedcontext endpoints.'
          sk: 'Otvorené údaje regiónu Helsinki, naživo z verejnej dopravy HSL, parkovísk Fintraffic a mestských služieb, cez endpointy joinedcontext.'
      praha:
        initials: PHA
        colour: '#b4232a'
        description:
          en: 'Open data of the City of Prague, published through joinedcontext endpoints.'
          sk: 'Otvorené údaje hlavného mesta Prahy, publikované cez endpointy joinedcontext.'
      zilina:
        initials: ZA
        colour: '#1f6f43'
        description:
          en: 'Open data of the City of Žilina and the University of Žilina, published through joinedcontext endpoints.'
          sk: 'Otvorené údaje mesta Žilina a Žilinskej univerzity, publikované cez endpointy joinedcontext.'
      barcelona:
        initials: BCN
        colour: '#c8102e'
        description:
          en: 'Open data of Barcelona City Council (Open Data BCN, CC BY 4.0), published through joinedcontext endpoints.'
          sk: 'Otvorené údaje mesta Barcelona (Open Data BCN, CC BY 4.0), publikované cez endpointy joinedcontext.'
      bratislava:
        initials: BA
        colour: '#e30613'
        description:
          en: 'Open data of the City of Bratislava (data.bratislava.sk, CC BY 4.0), published through joinedcontext endpoints.'
          sk: 'Otvorené údaje hlavného mesta SR Bratislavy (data.bratislava.sk, CC BY 4.0), publikované cez endpointy joinedcontext.'
      banskabystrica:
        initials: BB
        colour: '#00579c'
      bbsk:
        initials: BBSK
        colour: '#7a1f5c'
      slovensko:
        initials: SK
        colour: '#0b4ea2'
        description:
          en: 'Open data about the whole of Slovakia, collected by the joinedcontext platform.'
          sk: 'Otvorené údaje za celé Slovensko, ktoré zbiera platforma joinedcontext.'
    # Both instances beside dev's kept components on 13.5 GiB (8.1 GiB used after the removal,
    # owner 20:0xZ): per instance jc 384Mi/1280Mi, Postgres 640Mi/2Gi, APISIX 176Mi/512Mi, so
    # requests 1.2 GiB and limits 3.75 GiB each. Measure with kubectl top after the import.
    rawValues:
      # jc-files is not made in jc-dev yet: it outlives its deletion (T-6718, local-path-retain).
      persistence:
        storageClass: local-path-retain
      resources:
        requests:
          cpu: 100m
          memory: 384Mi
        limits:
          cpu: '2'
          memory: 1280Mi

# jc carries identity itself (kaisatsu): this edge proxies to jc alone and has no Keycloak to log in
# to, so the edge's Keycloak dependency does not hold here.
componentDependencies:
  apisix: [secrets]

networkpolicies:
  # The CloudNativePG operator runs in namespace dev (clusterWide): it reads each instance's status
  # on 8000 and connects on 5432. Both halves, with the Linkerd proxy port.
  apps-db-from-dev-operator:
    _component: apps-db
    podSelector:
      cnpg.io/cluster: apps-db
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  postgres-from-dev-operator:
    _component: postgres
    podSelector:
      cnpg.io/cluster: postgres-cluster
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  dev-operator-egress-to-jc-dev:
    _component: postgres
    namespace: dev
    podSelector:
      app.kubernetes.io/name: cloudnative-pg
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
          # apps-db, the wasm Apps' own cluster (components/apps-db), managed by the same operator.
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchLabels:
                cnpg.io/cluster: apps-db
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143

# The Apps' database has no claim yet: it outlives its deletion (T-6718, local-path-retain).
apps-db:
  cluster:
    rawValues:
      cluster:
        storage:
          storageClass: local-path-retain
