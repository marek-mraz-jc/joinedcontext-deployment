---
# jc-dev: one jc instance on the dev cluster (owner 2026-11-09 19:2xZ, tasks/GOAL-jc-dev.md
# 'Dev cluster rebuild'). Namespace jc-dev, host jc.jcdev.dev.joinedcontext.com, its own
# CloudNativePG cluster (kaisatsu's role names are fixed, so two instances cannot share one
# Postgres) reconciled by the dev environment's operator, which watches every namespace, and its own
# APISIX edge behind the kit's Traefik.
components:
  - prepare
  - secrets
  - networkpolicies
  - postgres
  - apisix
  # The server WASM Apps (jc-app-hosts slice 2): their store and database before jc, whose Portal
  # writes what each shard mounts, and the shards after it (tests/test_wasm_host.py).
  - artifact-store
  - apps-db
  - jc
  - wasm-host
  # jc's ServiceMonitor (admin /metrics behind its token) and the Postgres PodMonitors, read by dev's
  # Prometheus (namespace dev) as jc-prod's are (T-7469).
  - monitoring

global:
  # Its own domain under dev's wildcard A record: jc answers on jc.jcdev.dev.joinedcontext.com (slug
  # mode), the bare jcdev.dev.joinedcontext.com only on the edge's ACME path. dev's own apex stays dev's.
  domain: jcdev.dev.joinedcontext.com
  orgDomain: hel.fi
  instanceSlug: jc-dev
  profile: development
  # The installation's logo as old prod's smartcity branding named it: jc's catalogue footer mark,
  # favicon and /logo.svg ([dataroom.branding], components/jc/values/server).
  branding:
    logo: logo.svg
    favicon: logo.svg
    logoSvg: |
{{ readFile "branding/logo.svg" | indent 6 }}
  securityTxt:
    contact: mailto:contact@marek-mraz.com
    expires: "2027-09-24T00:00:00Z"
  serviceMesh:
    allowUnauthenticatedIngress: true
  ingress:
    enabled: true
    clusterIssuer: 'letsencrypt-prod'
    ingressClass: 'traefik'
  kubeApiCidrs: [10.255.0.101/32]

# The operator is the dev environment's (namespace dev, clusterWide since this change).
postgres:
  operator:
    enabled: false
  # One instance of three on a 16 GB node: jc's three stores ask for a third of dev's request.
  # Option A of T-7498 (supervisor 2026-11-22T13:4xZ): the pools count 52 with the role Jobs' logins and
  # the Portal's three standing sessions, x 1.2 + 3 reserved = 66 (tests/test_postgres_connection_budget.py);
  # the worst case at 66 is 1882MiB, under 80 % of 2400Mi (tests/test_postgres_memory_budget.py). The
  # request stays: the working set peaks at the limit with RSS about 1 GiB, the rest page cache (T-7498).
  cluster:
    rawValues:
      cluster:
        resources:
          requests:
            cpu: 100m
            memory: 640Mi
          limits:
            memory: 2400Mi
        postgresql:
          parameters:
            max_connections: "66"
            # pg_stat_statements as on jc-prod (T-7517: the reap's DELETE read after the pin; T-7519 compares).
            # 1000 top-level entries, about 2 MiB, inside the 38Mi left under 80 % of 2400Mi; CNPG's
            # ALTER ROLE password statements stay out of it (track_utility off, T-7498).
            pg_stat_statements.max: "1000"
            pg_stat_statements.track: "top"
            pg_stat_statements.track_utility: "off"


# The server WASM Apps' store and database (jc-app-hosts slice 2). Prod's `apps` bucket held 18 MB
# and apps-db 30 MB (final export, 2026-11-09), so 2Gi each. The store archives no WAL here (dev's
# 832Mi request is its WAL objects, T-5926): its idle working set, 96-105Mi on dev before the
# archive (T-4473), with room for a publish of the ten components.
artifact-store:
  store:
    storage:
      size: 2Gi
    rawValues:
      # A claim not made yet: it outlives its deletion (T-6718, local-path-retain).
      storage:
        storageClass: local-path-retain
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

jc:
  server:
    trustedProxies:
      - "10.42.0.0/16"
    # dev's move into jc-dev (GOAL-jc-dev, T-6723): dev's realm from bundle dev-20261109T1924Z, applied
    # at start from Secrets jc-realm and jc-realm-secrets the deployer made from its realm render
    # (staging/jc-dev/make-secrets.sh, never in Git), and dev's age identity (Secret jc-age) for the
    # projects' SOPS files. Dev keeps the last 24 h of temporal history (owner 2026-11-09), KPI whole.
    realmImport:
      realm: dev
      secret: jc-realm
      secretsSecret: jc-realm-secrets
      # Streams sign in as their Pipeline's own client by its secret, as on jc-prod: dev's realm
      # lists its <project>-pl-<pipeline> clients in pipeline-clients.txt. Unset, they signed in as
      # the imported <project>-pipelines, whose audience lacks banskabystrica-otvorene-data, and every
      # od-* upsert answered 401 (T-6899). A Pipeline made later gets its client from jc (T-6899).
      pipelineIdentity: pipeline-secret
    ageKeySecret: jc-age
    retainHours: 24
    # Separate services (owner 2026-11-16 16:5xZ, T-7009): shako, daiya and dataroom each in a
    # Deployment of its own, Antares' bus on NATS (components/jc default-environment `split`).
    split: true
    # daiya's Organizations as the running daiya numbered them (T-7509, export 2026-11-22T15:08Z,
    # evidence/T-7509/jc-dev-export-20261122T1508Z.tsv; all 24 equal the stored org_id rows). A project
    # made later takes the next free number: export again before a pin that changes daiya.
    daiyaOrganizations:
      - { id: 2, name: banskabystrica }
      - { id: 3, name: banskabystrica-mcp-check }
      - { id: 4, name: barcelona }
      - { id: 5, name: barcelona-mcp-check }
      - { id: 6, name: bbsk }
      - { id: 7, name: bbsk-mcp-check }
      - { id: 8, name: bratislava }
      - { id: 9, name: bratislava-mcp-check }
      - { id: 10, name: ctl-a-mcp-check }
      - { id: 11, name: ctl-b-mcp-check }
      - { id: 12, name: demo-mcp-air }
      - { id: 13, name: hel-mcp-check }
      - { id: 14, name: helsinki }
      - { id: 15, name: praha }
      - { id: 16, name: praha-mcp-check }
      - { id: 17, name: sharing }
      - { id: 18, name: sharing-other }
      - { id: 19, name: slovensko }
      - { id: 20, name: slovensko-mcp-check }
      - { id: 21, name: t6025-full }
      - { id: 22, name: t7380-walk }
      - { id: 23, name: zilina }
      - { id: 24, name: zilina-mcp-check }
    # TOTP for every person on jc-dev (owner 2026-11-14 "TURN ON TOTP FOR NOW"; T-6894, SHA1 enrolments).
    secondFactor: required
    # Six Organizations on hosts of their own (T-7005 phase A, owner 2026-11-15 12:1xZ; the dev layout of
    # evidence/T-6991/design.md): labels under jcdev.dev.joinedcontext.com; mcp. because jc refuses one host
    # for api and mcp. Each catalogue is new (jc-dev has no harvest seed to move into it); the datasets stay
    # in the shared one until the Portal publishes there. The other Organizations stay in slug form on jc.
    # until `host = "auto"` reaches jc-dev's pin (phase B).
    # The 24 host certificates of the six below order in one apply (T-7005; joinedcontext.com had 2
    # new certificates in the week to 2026-11-15, so 24 fit under Let's Encrypt's 50).
    certificateStage: 24
    # The 24 Certificates of the four hosts each (T-7005), issued: only the `idm.` ones of T-7001 are new.
    issuedCertificates:
      - jc-org-smartcity-bbsk
      - jc-org-opendata-bbsk
      - jc-org-api-bbsk
      - jc-org-mcp-bbsk
      - jc-org-smartcity-hel
      - jc-org-opendata-hel
      - jc-org-api-hel
      - jc-org-mcp-hel
      - jc-org-smartcity-marek-mraz
      - jc-org-opendata-marek-mraz
      - jc-org-api-marek-mraz
      - jc-org-mcp-marek-mraz
      - jc-org-smartcity-banskabystrica
      - jc-org-opendata-banskabystrica
      - jc-org-api-banskabystrica
      - jc-org-mcp-banskabystrica
      - jc-org-smartcity-bratislava
      - jc-org-opendata-bratislava
      - jc-org-api-bratislava
      - jc-org-mcp-bratislava
      - jc-org-smartcity-praha
      - jc-org-opendata-praha
      - jc-org-api-praha
      - jc-org-mcp-praha
      # The idm. hosts of T-7001, issued 2026-11-16T21:05Z.
      - jc-org-idm-bbsk
      - jc-org-idm-hel
      - jc-org-idm-marek-mraz
      - jc-org-idm-banskabystrica
      - jc-org-idm-bratislava
      - jc-org-idm-praha
      # T-7009 batch 1, issued 2026-11-18.
      - jc-org-smartcity-barcelona
      - jc-org-opendata-barcelona
      - jc-org-api-barcelona
      - jc-org-mcp-barcelona
      - jc-org-idm-barcelona
      - jc-org-smartcity-zilina
      - jc-org-opendata-zilina
      - jc-org-api-zilina
      - jc-org-mcp-zilina
      - jc-org-idm-zilina
    # The deployment host's people (their connectors, connector calls and preferences) belong to
    # marek-mraz, the owner's Organization: the Portal keys the 35 connectors, 637 calls and 8
    # preference rows of jc-dev under its reserved project before migration 0088 forces the key
    # (T-7282, supervisor decision 2026-11-19T03:50Z). Merge before the jc-dev pin that carries 0088.
    installationOrganization: marek-mraz
    organizations:
      - name: bbsk
        catalogueId: 00000000-0000-7000-8000-0000000000b1
        hosts: { portal: smartcity.bbsk, opendata: opendata.bbsk, api: api.bbsk, mcp: mcp.bbsk, idm: idm.bbsk }
      - name: hel
        catalogueId: 00000000-0000-7000-8000-0000000000b2
        hosts: { portal: smartcity.hel, opendata: opendata.hel, api: api.hel, mcp: mcp.hel, idm: idm.hel }
      - name: marek-mraz
        catalogueId: 00000000-0000-7000-8000-0000000000b3
        hosts: { portal: smartcity.marek-mraz, opendata: opendata.marek-mraz, api: api.marek-mraz, mcp: mcp.marek-mraz, idm: idm.marek-mraz }
      - name: banskabystrica
        catalogueId: 00000000-0000-7000-8000-0000000000b4
        hosts: { portal: smartcity.banskabystrica, opendata: opendata.banskabystrica, api: api.banskabystrica, mcp: mcp.banskabystrica, idm: idm.banskabystrica }
      - name: bratislava
        catalogueId: 00000000-0000-7000-8000-0000000000b5
        hosts: { portal: smartcity.bratislava, opendata: opendata.bratislava, api: api.bratislava, mcp: mcp.bratislava, idm: idm.bratislava }
      - name: praha
        catalogueId: 00000000-0000-7000-8000-0000000000b6
        hosts: { portal: smartcity.praha, opendata: opendata.praha, api: api.praha, mcp: mcp.praha, idm: idm.praha }
      # T-7201 (deployer 2026-11-17, supervisor order 18:56Z): the Organizations jc-dev's Projects name in Git but the
      # registry lacked, so their rows get a project key before 0080 forces it. `resolved: []`: no Certificate yet
      # (36 would pass certificateStage and eat the Let's Encrypt week); list a host there when it needs TLS.
      # T-7009 batch 1 (deployer 2026-11-18): barcelona and zilina get every host, 10 new Certificates (the
      # cluster issued 30 in the week to 2026-11-18T00:4xZ, so 40 of 50); the other four follow from 2026-11-22.
      # T-7391 batch 2 (deployer 2026-11-22): ctl-a and ctl-b get every host, 10 new Certificates (32 issued
      # in the week to 2026-11-22T12Z, so 42 of 50); demo-mcp and slovensko follow from 2026-11-25, when
      # the 17 of 2026-11-18 leave the window.
      - name: barcelona
        catalogueId: 00000000-0000-7000-8000-0000000000b7
        hosts: { portal: smartcity.barcelona, opendata: opendata.barcelona, api: api.barcelona, mcp: mcp.barcelona, idm: idm.barcelona }
      - name: ctl-a
        catalogueId: 00000000-0000-7000-8000-0000000000b8
        hosts: { portal: smartcity.ctl-a, opendata: opendata.ctl-a, api: api.ctl-a, mcp: mcp.ctl-a, idm: idm.ctl-a }
      - name: ctl-b
        catalogueId: 00000000-0000-7000-8000-0000000000b9
        hosts: { portal: smartcity.ctl-b, opendata: opendata.ctl-b, api: api.ctl-b, mcp: mcp.ctl-b, idm: idm.ctl-b }
      - name: demo-mcp
        catalogueId: 00000000-0000-7000-8000-0000000000ba
        hosts: { portal: smartcity.demo-mcp, opendata: opendata.demo-mcp, api: api.demo-mcp, mcp: mcp.demo-mcp, idm: idm.demo-mcp }
        resolved: []
      - name: slovensko
        catalogueId: 00000000-0000-7000-8000-0000000000bb
        hosts: { portal: smartcity.slovensko, opendata: opendata.slovensko, api: api.slovensko, mcp: mcp.slovensko, idm: idm.slovensko }
        resolved: []
      - name: zilina
        catalogueId: 00000000-0000-7000-8000-0000000000bc
        hosts: { portal: smartcity.zilina, opendata: opendata.zilina, api: api.zilina, mcp: mcp.zilina, idm: idm.zilina }
    # The model key for Applications' Generate and the assistant (T-7009 step 0, owner 2026-11-16):
    # Secret jc-model-key in jc-dev, copied from jc-prod's by the deployer, never in Git. The
    # OpenRouter key's own limit caps spend.
    assistant:
      modelKeySecret: jc-model-key
    # jc-prod's embedder, shared (components/embedder in jc-prod, callerNamespaces): the assistant
    # signs in with this realm's jc-assistant token; no model loads in this jc.
    embedder:
      url: http://embedder.jc-prod.svc.cluster.local:8089
      namespace: jc-prod
    # prod's publisher badges and words (owner 2026-10-12, release 23a43801 components/ckan/values/catalogue/
    # development-values.yaml.gotmpl `organizations`), copied from the monorepo's
    # bins/jc/docs/dataroom-publishers.toml: CKAN's own picture or description still wins.
    dataroomPublishers:
      hel-fi:
        initials: HEL
        colour: '#0000bf'
        description:
          en: 'Open data of the Helsinki region, live from HSL public transport, Fintraffic parking and the city''s own services, through joinedcontext endpoints.'
          sk: 'Otvorené údaje regiónu Helsinki, naživo z verejnej dopravy HSL, parkovísk Fintraffic a mestských služieb, cez endpointy joinedcontext.'
      praha:
        initials: PHA
        colour: '#b4232a'
        description:
          en: 'Open data of the City of Prague, published through joinedcontext endpoints.'
          sk: 'Otvorené údaje hlavného mesta Prahy, publikované cez endpointy joinedcontext.'
      zilina:
        initials: ZA
        colour: '#1f6f43'
        description:
          en: 'Open data of the City of Žilina and the University of Žilina, published through joinedcontext endpoints.'
          sk: 'Otvorené údaje mesta Žilina a Žilinskej univerzity, publikované cez endpointy joinedcontext.'
      barcelona:
        initials: BCN
        colour: '#c8102e'
        description:
          en: 'Open data of Barcelona City Council (Open Data BCN, CC BY 4.0), published through joinedcontext endpoints.'
          sk: 'Otvorené údaje mesta Barcelona (Open Data BCN, CC BY 4.0), publikované cez endpointy joinedcontext.'
      bratislava:
        initials: BA
        colour: '#e30613'
        description:
          en: 'Open data of the City of Bratislava (data.bratislava.sk, CC BY 4.0), published through joinedcontext endpoints.'
          sk: 'Otvorené údaje hlavného mesta SR Bratislavy (data.bratislava.sk, CC BY 4.0), publikované cez endpointy joinedcontext.'
      banskabystrica:
        initials: BB
        colour: '#00579c'
      bbsk:
        initials: BBSK
        colour: '#7a1f5c'
      slovensko:
        initials: SK
        colour: '#0b4ea2'
        description:
          en: 'Open data about the whole of Slovakia, collected by the joinedcontext platform.'
          sk: 'Otvorené údaje za celé Slovensko, ktoré zbiera platforma joinedcontext.'
    # Both instances beside dev's kept components on 13.5 GiB (8.1 GiB used after the removal,
    # owner 20:0xZ): per instance jc 384Mi/1280Mi, Postgres 640Mi/2Gi, APISIX 176Mi/512Mi, so
    # requests 1.2 GiB and limits 3.75 GiB each. Measure with kubectl top after the import.
    rawValues:
      # jc-files is not made in jc-dev yet: it outlives its deletion (T-6718, local-path-retain).
      persistence:
        storageClass: local-path-retain
      # With dev's data jc needs about what jc-prod's measured (jc-memory-1g: peak RSS 2.13-2.28 GiB,
      # import VmHWM ~3 GiB): Burstable under jc-prod's Guaranteed pod, so on node pressure jc-dev
      # goes first. T-6723 step 2 sets the request from jc-dev's own measured peak after the import:
      # working set 1315 Mi 12 min and 1768 Mi 54 min after a start (2026-11-15), so 2 GiB.
      # Split (T-7009): T-7014 measured the split at 1.8x one process (core 419 + daiya 101 + dataroom
      # 144 + shako 134 of 798 MiB), about 1.9 GiB on jc-dev; the core's 52 % of it is about 1 GiB,
      # requested at 1.25x. The three roles request theirs on jc.shako/daiya/dataroom (defaults).
      resources:
        requests:
          cpu: 100m
          memory: 1280Mi
        limits:
          cpu: '2'
          memory: 3Gi
  # The split's role Deployments and NATS (values/role, values/nats).
  shako: { enabled: true }
  daiya: { enabled: true }
  dataroom: { enabled: true }
  nats: { enabled: true }

# jc carries identity itself (kaisatsu): this edge proxies to jc alone and has no Keycloak to log in
# to, so the edge's Keycloak dependency does not hold here.
componentDependencies:
  apisix: [secrets]

# Metrics (T-7469): dev's Prometheus scrapes jc-dev's jc (admin 9091, behind its token) and the
# Postgres exporters (9187). The targets admit it by prometheusNamespace (the jc, postgres and apps-db
# charts' own rules); dev's half is dev-prometheus-egress-to-jc-dev below. jc-prod's PrometheusRule carries
# the cluster's alerts, so jc-dev renders none.
monitoring:
  monitoring:
    # On without global.metrics.enabled, which would also render the CloudNativePG chart's rules.
    enabled: true
    prometheusNamespace: dev
    rawValues:
      alertGroups: []

networkpolicies:
  # dev's Prometheus to jc-dev's scrape targets: jc's admin listener skips the mesh proxy (9091
  # alone, 4143 would reach 8080 too), the Postgres exporters sit behind theirs (4143).
  dev-prometheus-egress-to-jc-dev:
    _component: jc
    namespace: dev
    podSelector:
      app.kubernetes.io/name: prometheus
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-server
                app.kubernetes.io/instance: jc-server
        ports:
          - protocol: TCP
            port: 9091
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchExpressions:
                - key: cnpg.io/cluster
                  operator: In
                  values: [postgres-cluster, apps-db]
        ports:
          - protocol: TCP
            port: 9187
          - protocol: TCP
            port: 4143
  # The CloudNativePG operator runs in namespace dev (clusterWide): it reads each instance's status
  # on 8000 and connects on 5432. Both halves, with the Linkerd proxy port.
  apps-db-from-dev-operator:
    _component: apps-db
    podSelector:
      cnpg.io/cluster: apps-db
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  postgres-from-dev-operator:
    _component: postgres
    podSelector:
      cnpg.io/cluster: postgres-cluster
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  dev-operator-egress-to-jc-dev:
    _component: postgres
    namespace: dev
    podSelector:
      app.kubernetes.io/name: cloudnative-pg
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
          # apps-db, the wasm Apps' own cluster (components/apps-db), managed by the same operator.
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-dev
            podSelector:
              matchLabels:
                cnpg.io/cluster: apps-db
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143

# The Apps' database has no claim yet: it outlives its deletion (T-6718, local-path-retain).
apps-db:
  cluster:
    rawValues:
      cluster:
        storage:
          storageClass: local-path-retain
