---
ckan:
  catalogue:
    # Every catalogue page offers the public assistant of Banská Bystrica and its region
    # (T-3058, AG-114, T-4252); its manifest is the seed's banskabystrica-assistant-public.yaml,
    # whose allowedOrigins names this host.
    assistant: banskabystrica
    # Slovak first (owner, 2026-10-16, T-4280): the catalogue's publishers are Slovak, Czech and
    # Finnish bodies, so the catalogue offers their languages while the Portal stays English.
    languages:
      default: sk
      offered: [sk, en, cs, fi]
