---
# jc-prod: one jc instance on the dev cluster (owner 2026-11-09 19:2xZ, tasks/GOAL-jc-dev.md
# 'Dev cluster rebuild'). Namespace jc-prod, under prod's own host names in host mode (owner 19:5xZ,
# GOAL-prod-decommission 'Cutover tomorrow morning': the owner moves DNS to this node), its own
# CloudNativePG cluster (kaisatsu's role names are fixed, so two instances cannot share one
# Postgres) reconciled by the dev environment's operator, which watches every namespace, and its own
# APISIX edge behind the kit's Traefik.
components:
  - prepare
  - secrets
  - networkpolicies
  - postgres
  - apisix
  - jc
  # Scrape configuration only (ServiceMonitor/PodMonitor in this namespace), read by dev's
  # Prometheus; no rule set of its own, which dev's Prometheus would evaluate a second time.
  - monitoring

global:
  # Prod's names. Until the owner moves DNS they reach this node only by Host header or a hosts
  # override; the edge certificate is prod's own, copied into Secret apisix-edge-tls by the
  # prod-deployer, and cert-manager renews it after the move.
  domain: smartcity.joinedcontext.com
  orgDomain: hel.fi
  instanceSlug: jc-prod
  profile: development
  securityTxt:
    contact: mailto:contact@marek-mraz.com
    expires: "2027-09-24T00:00:00Z"
  serviceMesh:
    allowUnauthenticatedIngress: true
  ingress:
    enabled: true
    clusterIssuer: 'letsencrypt-prod'
    ingressClass: 'traefik'
  kubeApiCidrs: [10.255.0.101/32]

# The operator is the dev environment's (namespace dev, clusterWide since this change).
postgres:
  operator:
    enabled: false
  # One instance of three on a 16 GB node: jc's three stores ask for a third of dev's request and keep
  # its 2Gi ceiling (measure with kubectl top after the import and set the request from it).
  cluster:
    rawValues:
      cluster:
        resources:
          requests:
            cpu: 100m
            memory: 640Mi
          limits:
            memory: 2Gi


jc:
  metricsProxy:
    enabled: true
    upstream: http://prometheus-operated.dev.svc.cluster.local:9090
  server:
    mode: host
    # Prod's edge certificate names (kubectl get ingress -n smartcity apisix, 2026-11-09): the same
    # set, so the copied certificate stays Ready. status. and tiles. are no jc modules (prod serves
    # them from status-page and basemap-tiles): `hostUpstreams` sends them to the ones dev kept
    # (supervisor 20:2xZ), opened to this edge by the policies below.
    hostUpstreams:
      status: status-page.dev.svc.cluster.local:8080
      tiles: basemap-tiles.dev.svc.cluster.local:8080
    hosts: ["", api, assistant, data, idm, opendata, portal, status, tiles, viz]
    # The dev node (Traefik's LoadBalancer address): drop it once DNS has moved.
    edgeAddress: 116.203.134.249
    trustedProxies:
      - "10.42.0.0/16"
    # Both instances beside dev's kept components on 13.5 GiB (8.1 GiB used after the removal,
    # owner 20:0xZ): per instance jc 384Mi/1280Mi, Postgres 640Mi/2Gi, APISIX 176Mi/512Mi, so
    # requests 1.2 GiB and limits 3.75 GiB each. Measure with kubectl top after the import.
    rawValues:
      # dev's Prometheus is meshed: through jc's Linkerd inbound port (4143) it would reach every
      # port of the pod, the public 8080 included. The admin listener skips the proxy instead, so
      # the policy below opens 9091 alone (the token still guards /metrics).
      podAnnotations:
        config.linkerd.io/skip-inbound-ports: "9091"
      resources:
        requests:
          cpu: 100m
          memory: 384Mi
        limits:
          cpu: '2'
          memory: 1280Mi

# Metrics (jc-prod-metrics, Decided (supervisor, owner may override)): no second Prometheus on the
# 16 GB node. Dev's Prometheus (namespace dev) scrapes this namespace's jc, APISIX and Postgres
# exporters; jc's daiya reads it only through the metricsProxy part, which pins every query to
# namespace="jc-prod" (dev's and jc-dev's series stay out of reach). While dev's Prometheus runs no
# pod (environments/dev/prometheus.yaml.gotmpl, owner order 2026-11-03) the panels stay empty.
monitoring:
  monitoring:
    # On without global.metrics.enabled, which would also render the CloudNativePG chart's rules.
    enabled: true
    # Admits dev's Prometheus to the Postgres exporter (namespaceFrom in components/postgres).
    prometheusNamespace: dev
    rawValues:
      alertGroups: []
apisix:
  apisix:
    rawValues:
      apisix:
        prometheus:
          enabled: true
      metrics:
        serviceMonitor:
          enabled: true

# jc carries identity itself (kaisatsu): this edge proxies to jc alone and has no Keycloak to log in
# to, so the edge's Keycloak dependency does not hold here.
componentDependencies:
  apisix: [secrets]

# This edge to dev's status page and tile server (hostUpstreams above), both halves, the Linkerd
# proxy port beside the app port.
networkpolicies:
  apisix-egress-to-dev-status-tiles:
    _component: apisix
    podSelector:
      app.kubernetes.io/name: apisix
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/instance: probes-status
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/instance: basemap-tiles
                app.kubernetes.io/component: server
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  dev-status-page-from-jc-prod-edge:
    _component: apisix
    namespace: dev
    podSelector:
      app.kubernetes.io/instance: probes-status
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  dev-basemap-from-jc-prod-edge:
    _component: apisix
    namespace: dev
    podSelector:
      app.kubernetes.io/instance: basemap-tiles
      app.kubernetes.io/component: server
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  # The CloudNativePG operator runs in namespace dev (clusterWide): it reads each instance's status
  # on 8000 and connects on 5432. Both halves, with the Linkerd proxy port.
  postgres-from-dev-operator:
    _component: postgres
    podSelector:
      cnpg.io/cluster: postgres-cluster
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  dev-operator-egress-to-jc-prod:
    _component: postgres
    namespace: dev
    podSelector:
      app.kubernetes.io/name: cloudnative-pg
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  # Metrics: jc's daiya -> the proxy -> dev's Prometheus, and dev's Prometheus -> the exporters of
  # jc (admin 9091, behind its token), APISIX (9091) and Postgres (9187, by prometheusNamespace
  # above). Both halves of each hop, the Linkerd proxy port beside the app port; nothing else
  # reaches the proxy or the metrics ports.
  jc-egress-to-metrics-proxy:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-server
      app.kubernetes.io/instance: jc-server
    policyTypes:
      - Egress
    egress:
      - to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-metrics-proxy
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  jc-metrics-proxy:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-metrics-proxy
    policyTypes:
      - Ingress
      - Egress
    ingress:
      - from:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-server
                app.kubernetes.io/instance: jc-server
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: kube-system
            podSelector:
              matchLabels:
                k8s-app: kube-dns
        ports:
          - protocol: UDP
            port: 53
          - protocol: TCP
            port: 53
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9090
          - protocol: TCP
            port: 4143
  dev-prometheus-from-jc-prod-proxy:
    _component: jc
    namespace: dev
    podSelector:
      app.kubernetes.io/name: prometheus
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-metrics-proxy
        ports:
          - protocol: TCP
            port: 9090
          - protocol: TCP
            port: 4143
  dev-prometheus-egress-to-jc-prod:
    _component: jc
    namespace: dev
    podSelector:
      app.kubernetes.io/name: prometheus
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-server
                app.kubernetes.io/instance: jc-server
        ports:
          - protocol: TCP
            port: 9091
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 9091
          - protocol: TCP
            port: 4143
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
        ports:
          - protocol: TCP
            port: 9187
          - protocol: TCP
            port: 4143
  # 9091 alone: it skips jc's mesh proxy (podAnnotations above), and 4143 would reach 8080 too.
  jc-admin-from-dev-prometheus:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-server
      app.kubernetes.io/instance: jc-server
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9091
  apisix-metrics-from-dev-prometheus:
    _component: apisix
    podSelector:
      app.kubernetes.io/name: apisix
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9091
          - protocol: TCP
            port: 4143
