---
# jc-prod: one jc instance on the dev cluster (owner 2026-11-09 19:2xZ, tasks/GOAL-jc-dev.md
# 'Dev cluster rebuild'). Namespace jc-prod, under prod's own host names in host mode (owner 19:5xZ,
# GOAL-prod-decommission 'Cutover tomorrow morning': the owner moves DNS to this node), its own
# CloudNativePG cluster (kaisatsu's role names are fixed, so two instances cannot share one
# Postgres) reconciled by the dev environment's operator, which watches every namespace, and its own
# APISIX edge behind the kit's Traefik.
components:
  - prepare
  - secrets
  - networkpolicies
  - postgres
  - apisix
  # The server WASM Apps (jc-app-hosts slice 2): their store and database before jc, whose Portal
  # writes what each shard mounts, and the shards after it (tests/test_wasm_host.py).
  - artifact-store
  - apps-db
  - jc
  - wasm-host
  # Prod's three MQTT edge brokers (ADR-N-048), stamped by jc's Portal from the chart's template
  # into a namespace of their own (jc-prod-mqtt, not jc-prod: the gateway's Linkerd rule admits
  # every identity of that namespace to jc's internal port).
  - mqtt-brokers
  # Scrape configuration only (ServiceMonitor/PodMonitor in this namespace), read by dev's
  # Prometheus; no rule set of its own, which dev's Prometheus would evaluate a second time.
  - monitoring

global:
  # Prod's names. Until the owner moves DNS they reach this node only by Host header or a hosts
  # override; the edge certificate is prod's own, copied into Secret apisix-edge-tls by the
  # prod-deployer, and cert-manager renews it after the move.
  domain: smartcity.joinedcontext.com
  orgDomain: hel.fi
  instanceSlug: jc-prod
  profile: development
  securityTxt:
    contact: mailto:contact@marek-mraz.com
    expires: "2027-09-24T00:00:00Z"
  serviceMesh:
    allowUnauthenticatedIngress: true
  ingress:
    enabled: true
    clusterIssuer: 'letsencrypt-prod'
    ingressClass: 'traefik'
    # Prod's App hosts (kubectl get ingress,certificate -n smartcity app-*, 2026-11-09: 38, one
    # host and Secret app-{name}-tls each). The prod-deployer copies each Secret before DNS moves.
    appHosts:
      - air-quality
      - air-weather-explorer
      - alerts-desk
      - alerts-heatmap
      - banskabystrica-data
      - banskabystrica-mapa
      - banskabystrica-ovzdusie
      - banskabystrica-skoly
      - banskabystrica-zaznamy
      - bbsk-data
      - bbsk-mapa
      - bbsk-mosty
      - bbsk-podujatia
      - bbsk-ukazovatele
      - bbsk-zaznamy
      - bike-rebalancing
      - bike-stations
      - bike-weather-demand
      - data-quality-inspector
      - district-compare
      - event-day-planner
      - helsinki-alerts
      - helsinki-bikes
      - helsinki-data
      - helsinki-events
      - helsinki-kartta
      - hsl-transport
      - kpi-forecast
      - news-topics
      - praha-data
      - praha-mapa
      - praha-mesto
      - praha-odpad
      - transit-reach
      - zilina-mapa
      - zilina-ukazovatele
      - zilina-vyskum
      - zilina-zaznamy
  kubeApiCidrs: [10.255.0.101/32]

# The operator is the dev environment's (namespace dev, clusterWide since this change).
postgres:
  operator:
    enabled: false
  # One instance of three on a 16 GB node: jc's three stores ask for a third of dev's request and keep
  # its 2Gi ceiling (measure with kubectl top after the import and set the request from it).
  cluster:
    rawValues:
      cluster:
        resources:
          requests:
            cpu: 100m
            memory: 640Mi
          limits:
            memory: 2Gi


# The server WASM Apps' store and database (jc-app-hosts slice 2). Prod's `apps` bucket held 18 MB
# and apps-db 30 MB (final export, 2026-11-09), so 2Gi each. The store archives no WAL here (dev's
# 832Mi request is its WAL objects, T-5926): its idle working set, 96-105Mi on dev before the
# archive (T-4473), with room for a publish of the ten components.
artifact-store:
  store:
    storage:
      size: 2Gi
    rawValues:
      resources:
        requests:
          cpu: 50m
          memory: 128Mi
        limits:
          cpu: 500m
          memory: 512Mi

jc:
  metricsProxy:
    enabled: true
    upstream: http://prometheus-operated.dev.svc.cluster.local:9090
  server:
    mode: host
    # Prod's edge certificate names (kubectl get ingress -n smartcity apisix, 2026-11-09): the same
    # set, so the copied certificate stays Ready. status. and tiles. are no jc modules (prod serves
    # them from status-page and basemap-tiles): `hostUpstreams` sends them to the ones dev kept
    # (supervisor 20:2xZ), opened to this edge by the policies below.
    hostUpstreams:
      status: status-page.dev.svc.cluster.local:8080
      tiles: basemap-tiles.dev.svc.cluster.local:8080
      # prod's BBSK demo landing alone (demos/bbsk-landing, namespace bbsk-landing).
      bbsk: demo-bbsk-landing.bbsk-landing.svc.cluster.local:8080
    # bbsk. keeps prod's own certificate (Secret demo-bbsk-tls, copied by prod-deployer): off the
    # edge certificate's SAN list, so the copied apisix-edge-tls stays Ready.
    hostTls:
      bbsk: demo-bbsk-tls
    hosts: ["", api, assistant, bbsk, data, idm, opendata, portal, status, tiles, viz]
    # The dev node (Traefik's LoadBalancer address): drop it once DNS has moved.
    edgeAddress: 116.203.134.249
    trustedProxies:
      - "10.42.0.0/16"
    # prod's public assistant (assistant.{domain}, /api/v1/d/<deployment>/chat): jc's own model proxy
    # over Secret jc-model-key (key `key`), which the deployer copies from the dev OpenRouter key's
    # Secret, never into Git. Each Deployment's costPerDayUsd in the imported projects caps it; the
    # OpenRouter key's own limit (80 USD, owner) stops every call when reached.
    assistant:
      modelKeySecret: jc-model-key
    # The release's SOPS files name dev's age recipient (CLUSTER-IMPORT.md 2.4): Secret jc-age, copied
    # by the deployer from the secrets mount, never in Git.
    ageKeySecret: jc-age
    # The cutover's realm (CLUSTER-IMPORT.md 3-4): Secrets jc-realm and jc-realm-secrets, made by the
    # deployer from the bundle's realm render (realm prod-final-20261109T1958Z), never in Git.
    realmImport:
      realm: smartcity
      secret: jc-realm
      secretsSecret: jc-realm-secrets
    # prod's catalog dataset moved to zilina-catalog (bins/jc RENAMES.md, rehearsal.py aliases).
    # prod's harvests of hub-bbsk and nkod-banskabystrica (jc-catalogue-17).
    catalogueHarvest: true
    # The owner's 24 h temporal rule (2026-11-09 20:1xZ), KeyPerformanceIndicator whole.
    retainHours: 24
    dataroomAliases:
      catalog: zilina-catalog
    # prod's publish-gate hidden list, copied from the monorepo's bins/jc/docs/catalogue-hidden.toml at
    # 8b31df00 (100 datasets): dataroom leaves each out of search and the DCAT feed.
    catalogueHidden:
      "bb-adresy": "ngsi-ld: the Endpoint answered 403 TooManyResults"
      "bb-aktuality": "ngsi-ld: no entity on dev"
      "bb-dtm-bb-funkcne-vyuzitie-uzemia": "ngsi-ld: removed in the mapping: no smart data model: dataModel.UrbanPlanning holds no model yet; no other subject holds a land-use plan's zones, limits or planned works"
      "bb-dtm-bb-polohopis-a-vyskopis-bodoveho-pola": "ngsi-ld: not ingestible (T-4324 deletes it): 240638 rows, more than the 100000 this round loads into the one broker"
      "bb-dtm-bb-register-adries": "ngsi-ld: the Endpoint answered 403 TooManyResults"
      "bb-dtm-bb-register-chodnikov-a-verejnych-priestranstiev": "ngsi-ld: removed in the mapping: no smart data model: Transportation/BikeLane is a lane on a road; no model holds a footway or a pavement"
      "bb-dtm-bb-register-miestnych-komunikacii-a-vyssich-tried": "ngsi-ld: removed in the mapping: no smart data model: Transportation/Road requires name and roadClass; a DTM road point has neither, only a surface code"
      "bb-dtm-bb-register-stavby": "ngsi-ld: removed in the mapping: no smart data model: Building/Building requires address and category; the register has neither (municipality and district only)"
      "bb-dtm-bb-register-stlpov-vo": "ngsi-ld: removed in the mapping: no smart data model: Streetlighting/Streetlight requires status (ok, defectiveLamp, columnIssue, brokenLantern); the DTM records whether a pole is operated, not the state of its lamp"
      "bb-dtm-bb-register-ulic": "ngsi-ld: removed in the mapping: no smart data model: Transportation/RoadSegment requires refRoad, startPoint, endPoint and allowedVehicleType, which a street register has not"
      "bb-dtm-bb-register-verejnej-zelene-1": "accurate: 4000 entities for 8546 source rows (-53.2%) | source row 0 has no entity | source row 2136 has no entity | source row 8545 has no entity"
      "bb-dtm-bb-register-verejnej-zelene-2": "ngsi-ld: removed in the mapping: no smart data model: ParksAndGardens has Garden, FlowerBed and GreenspaceRecord (a measurement); no model holds a single tree"
      "bb-dtm-bb-register-verejnej-zelene-3": "ngsi-ld: removed in the mapping: no smart data model: ParksAndGardens/Garden is the area; no model holds the line around it"
      "bb-dtm-bb-register-vodorovneho-dopravneho-znacenia": "ngsi-ld: no-data-source in the mapping: a ZIP of 1 .pdf (193 KiB): a PDF map sheet, and no layer of the city's ArcGIS services holds its data"
      "bb-dtm-bb-register-zvisleho-dopravneho-znacenia": "ngsi-ld: removed in the mapping: no smart data model: no subject of the official list (2026-07-19) holds a traffic sign but OpenStreetMap's"
      "bb-dtm-bb-regulativy-a-limity-funkcneho-vyuzitia-uzemia": "ngsi-ld: removed in the mapping: no smart data model: dataModel.UrbanPlanning holds no model yet; no other subject holds a land-use plan's zones, limits or planned works"
      "bb-dtm-bb-tvorba-krajiny-a-ochrana-prirody": "ngsi-ld: removed in the mapping: no smart data model: dataModel.UrbanPlanning holds no model yet; no other subject holds a land-use plan's zones, limits or planned works"
      "bb-dtm-bb-verejne-dopravne-a-technicke-vybavenie": "ngsi-ld: removed in the mapping: no smart data model: dataModel.UrbanPlanning holds no model yet; no other subject holds a land-use plan's zones, limits or planned works"
      "bb-dtm-bb-verejnoprospesne-stavby": "ngsi-ld: removed in the mapping: no smart data model: dataModel.UrbanPlanning holds no model yet; no other subject holds a land-use plan's zones, limits or planned works"
      "bb-dtm-bb-vodne-toky-a-plochy": "ngsi-ld: removed in the mapping: no smart data model: OpenChannelManagement/OpenChannel is a hydraulic model of a channel (cross sections, flow); Environment/WaterObserved is a measurement; no model holds a stream or a reservoir"
      "bb-dtm-bb-vyskopis-teran": "ngsi-ld: removed in the mapping: no smart data model: no subject of the official list (2026-07-19) holds contour lines or terrain edges"
