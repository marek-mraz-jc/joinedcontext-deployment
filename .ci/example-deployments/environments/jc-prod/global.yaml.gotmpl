    # Prod's three MqttBroker releases (frozen bundle prod-final-20261109T1958Z, mqtt-<project>-<name>),
    # each with its project: ekiben's DataSources of that project alone read its 1883.
    mqttBrokers:
      - {project: banskabystrica, release: mqtt-banskabystrica-ovzdusie}
      - {project: helsinki, release: mqtt-helsinki-sensors}
      - {project: helsinki, release: mqtt-helsinki-vehicles}
    # Both instances beside dev's kept components on 13.5 GiB (8.1 GiB used after the removal,
    # owner 20:0xZ): per instance jc 384Mi/1280Mi, Postgres 640Mi/2Gi, APISIX 176Mi/512Mi, so
    # requests 1.2 GiB and limits 3.75 GiB each. Measure with kubectl top after the import.
    # Supervisor 2026-11-10 06:5xZ from evidence/jc-memory-1g/REPORT.md (prod data): peak RSS 2.13 GiB
    # after start, 2.28 GiB under gate load, allocator-resident 2.60 GiB, idle 1.63 GiB.
    rawValues:
      # dev's Prometheus is meshed: through jc's Linkerd inbound port (4143) it would reach every
      # port of the pod, the public 8080 included. The admin listener skips the proxy instead, so
      # the policy below opens 9091 alone (the token still guards /metrics).
      podAnnotations:
        config.linkerd.io/skip-inbound-ports: "9091"
      resources:
        requests:
          cpu: 100m
          memory: 2Gi
        limits:
          cpu: '2'
          memory: 3Gi
  # The server functions of generated Apps (supervisor 06:3xZ): their own runtime in jc-prod, on
  # realm smartcity and jc-prod's gateway; dev's jc-functions trusts dev's realm and gateway only.
  functions:
    enabled: true

# Metrics (jc-prod-metrics, Decided (supervisor, owner may override)): no second Prometheus on the
# 16 GB node. Dev's Prometheus (namespace dev) scrapes this namespace's jc, APISIX and Postgres
# exporters; jc's daiya reads it only through the metricsProxy part, which pins every query to
# namespace="jc-prod" (dev's and jc-dev's series stay out of reach). While dev's Prometheus runs no
# pod (environments/dev/prometheus.yaml.gotmpl, owner order 2026-11-03) the panels stay empty.
monitoring:
  monitoring:
    # On without global.metrics.enabled, which would also render the CloudNativePG chart's rules.
    enabled: true
    # Admits dev's Prometheus to the Postgres exporter (namespaceFrom in components/postgres).
    prometheusNamespace: dev
    rawValues:
      alertGroups: []
apisix:
  apisix:
    rawValues:
      apisix:
        prometheus:
          enabled: true
      metrics:
        serviceMonitor:
          enabled: true

# Prod's hsl-transport pod (components/app-pods), proxied by jc's Portal on its App host. Its
# Endpoint is prod's `app-hsl-transport` of space helsinki (the App's JC_APP_CONFIG on prod). The
# component joins `components:` with the first digest image-apps.yml signs (components/app-pods/images.yaml).
app-pods:
  hsl-transport:
    endpointSlug: sv4ibpmhwowb6gnzqy6vp2b3iy

# jc carries identity itself (kaisatsu): this edge proxies to jc alone and has no Keycloak to log in
# to, so the edge's Keycloak dependency does not hold here. jc's gateway answers the brokers'
# CONNECT check, its ekiben reads them and its Portal stamps them.
componentDependencies:
  apisix: [secrets]
  mqtt-brokers: [jc, networkpolicies]

mqtt-brokers:
  brokers:
    # The three TLS Secrets mqtt-<project>-<name>-tls are copied here from jc-prod before DNS
    # moves (evidence/jc-prod/RUNBOOK-apply.md), so each broker's certificate serves at once.
    namespace: jc-prod-mqtt

# This edge to dev's status page and tile server (hostUpstreams above), both halves, the Linkerd
# proxy port beside the app port.
networkpolicies:
  apisix-egress-to-dev-status-tiles:
    _component: apisix
    podSelector:
      app.kubernetes.io/name: apisix
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/instance: probes-status
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/instance: basemap-tiles
                app.kubernetes.io/component: server
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: bbsk-landing
            podSelector:
              matchLabels:
                app.kubernetes.io/name: demo-bbsk-landing
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  dev-status-page-from-jc-prod-edge:
    _component: apisix
    namespace: dev
    podSelector:
      app.kubernetes.io/instance: probes-status
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  dev-basemap-from-jc-prod-edge:
    _component: apisix
    namespace: dev
    podSelector:
      app.kubernetes.io/instance: basemap-tiles
      app.kubernetes.io/component: server
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  # The CloudNativePG operator runs in namespace dev (clusterWide): it reads each instance's status
  # on 8000 and connects on 5432. Both halves, with the Linkerd proxy port.
  apps-db-from-dev-operator:
    _component: apps-db
    podSelector:
      cnpg.io/cluster: apps-db
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  postgres-from-dev-operator:
    _component: postgres
    podSelector:
      cnpg.io/cluster: postgres-cluster
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: cloudnative-pg
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  dev-operator-egress-to-jc-prod:
    _component: postgres
    namespace: dev
    podSelector:
      app.kubernetes.io/name: cloudnative-pg
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
          # apps-db, the wasm Apps' own cluster (components/apps-db), managed by the same operator.
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                cnpg.io/cluster: apps-db
        ports:
          - protocol: TCP
            port: 8000
          - protocol: TCP
            port: 5432
          - protocol: TCP
            port: 4143
  # Metrics: jc's daiya -> the proxy -> dev's Prometheus, and dev's Prometheus -> the exporters of
  # jc (admin 9091, behind its token), APISIX (9091) and Postgres (9187, by prometheusNamespace
  # above). Both halves of each hop, the Linkerd proxy port beside the app port; nothing else
  # reaches the proxy or the metrics ports.
  jc-egress-to-metrics-proxy:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-server
      app.kubernetes.io/instance: jc-server
    policyTypes:
      - Egress
    egress:
      - to:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-metrics-proxy
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
  jc-metrics-proxy:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-metrics-proxy
    policyTypes:
      - Ingress
      - Egress
    ingress:
      - from:
          - podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-server
                app.kubernetes.io/instance: jc-server
        ports:
          - protocol: TCP
            port: 8080
          - protocol: TCP
            port: 4143
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: kube-system
            podSelector:
              matchLabels:
                k8s-app: kube-dns
        ports:
          - protocol: UDP
            port: 53
          - protocol: TCP
            port: 53
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9090
          - protocol: TCP
            port: 4143
  dev-prometheus-from-jc-prod-proxy:
    _component: jc
    namespace: dev
    podSelector:
      app.kubernetes.io/name: prometheus
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-metrics-proxy
        ports:
          - protocol: TCP
            port: 9090
          - protocol: TCP
            port: 4143
  dev-prometheus-egress-to-jc-prod:
    _component: jc
    namespace: dev
    podSelector:
      app.kubernetes.io/name: prometheus
    policyTypes:
      - Egress
    egress:
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: jc-server
                app.kubernetes.io/instance: jc-server
        ports:
          - protocol: TCP
            port: 9091
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                app.kubernetes.io/name: apisix
        ports:
          - protocol: TCP
            port: 9091
          - protocol: TCP
            port: 4143
      - to:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: jc-prod
            podSelector:
              matchLabels:
                cnpg.io/cluster: postgres-cluster
        ports:
          - protocol: TCP
            port: 9187
          - protocol: TCP
            port: 4143
  # 9091 alone: it skips jc's mesh proxy (podAnnotations above), and 4143 would reach 8080 too.
  jc-admin-from-dev-prometheus:
    _component: jc
    podSelector:
      app.kubernetes.io/name: jc-server
      app.kubernetes.io/instance: jc-server
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9091
  apisix-metrics-from-dev-prometheus:
    _component: apisix
    podSelector:
      app.kubernetes.io/name: apisix
    policyTypes:
      - Ingress
    ingress:
      - from:
          - namespaceSelector:
              matchLabels:
                kubernetes.io/metadata.name: dev
            podSelector:
              matchLabels:
                app.kubernetes.io/name: prometheus
        ports:
          - protocol: TCP
            port: 9091
          - protocol: TCP
            port: 4143
