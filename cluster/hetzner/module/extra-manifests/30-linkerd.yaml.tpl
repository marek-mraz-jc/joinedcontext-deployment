# Linkerd service mesh — mTLS for CIVITAS (global.serviceMesh.type: linkerd).
# Trust anchor + issuer are generated by terraform (tls provider, see kube.tf)
# and injected here via extra_kustomize_parameters.
apiVersion: v1
kind: Namespace
metadata:
  name: linkerd
  labels:
    linkerd.io/is-control-plane: "true"
    config.linkerd.io/admission-webhooks: disabled
  annotations:
    linkerd.io/inject: disabled
---
apiVersion: v1
kind: Secret
metadata:
  name: linkerd-identity-issuer
  namespace: linkerd
type: kubernetes.io/tls
stringData:
  ca.crt: |
    ${linkerd_trust_anchor_cert_4}
  tls.crt: |
    ${linkerd_issuer_cert_4}
  tls.key: |
    ${linkerd_issuer_key_4}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: linkerd-crds
  namespace: kube-system
spec:
  repo: https://helm.linkerd.io/edge
  chart: linkerd-crds
  # Pinned: unpinned charts float to whatever upstream published this week on
  # every NEW cluster. Bump deliberately (helm search repo -l), then re-verify.
  version: "2026.10.1"
  targetNamespace: linkerd
---
# cniEnabled (prod 2026-10-19T00:38Z, T-4678): PSS-restricted namespaces refuse linkerd-init's
# NET_ADMIN, so the redirect comes from 25-linkerd-cni.yaml.tpl. valuesContent is kept byte-equal to
# the live chart: any change re-runs the helm install.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: linkerd-control-plane
  namespace: kube-system
spec:
  repo: https://helm.linkerd.io/edge
  chart: linkerd-control-plane
  version: "2026.10.1" # keep in lockstep with linkerd-crds above
  targetNamespace: linkerd
  valuesContent: |-
    cniEnabled: true
    identityTrustAnchorsPEM: |
      ${linkerd_trust_anchor_cert_6}
    identity:
      issuer:
        scheme: kubernetes.io/tls
    proxy:
      # Native (initContainer) sidecars: one-shot Jobs complete instead of
      # hanging on a never-exiting proxy container. CIVITAS docs require this.
      nativeSidecar: true
