# Agent worktrees, never part of the repository
.claude/

# pytest leaves this behind when the suite runs in the checkout
.pytest_cache/

# The render the golden check compares against; CI writes it into the checkout and so does
# anyone reproducing a golden failure by hand (ci.yml, `just golden-update`).
/golden-check.yaml

# The catalogue smoke's tables (T-4716): the next run rotates from the newest one.
/.smoke/

# Playwright runs of components/viz/tests (T-5129): installed browsers driver and result shots, never committed.
node_modules/
test-results/
# scripts/temporal-audit.py writes its report here by default (ci.yml uploads it as an artifact)
/temporal-audit.json
