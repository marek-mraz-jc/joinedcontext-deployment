managedSecrets:
  {{ include "jc.configFiles" (dict "components" .Values.components "file" "secrets.yaml") }}

  # One generated password per demo realm user (development profile only, see
  # components/keycloak/demo-users.yaml). Only the outer values (global, components) are
  # visible here, so the file is read directly. `special: true` guarantees the
  # upper/lower/digit mix the realm password policy demands.
  {{- $demoUsers := dict }}
  {{- if and (has "keycloak" .Values.components) (eq .Values.global.profile "development") }}
  {{- $demoUsers = readFile "../../components/keycloak/demo-users.yaml" | fromYaml }}
  {{- end }}
  {{- /* The owner's account of a production realm with dev's seeds (T-4678). */}}
  {{- if and (has "keycloak" .Values.components) (eq .Values.global.profile "production") .Values.global.valuesProfile }}
  keycloakUser-initial:
    generated:
      keycloak-user-initial:
        password:
          length: 32
          generate: true
          special: true
        componentNamespaces:
          - keycloak
  {{- end }}
  {{- range $name, $user := $demoUsers }}
  keycloakUser-{{ $name | replace "." "-" }}:
    generated:
      keycloak-user-{{ $name | replace "." "-" }}:
        password:
          length: 32
          generate: true
          special: true
        {{- /* The TOTP seed of a person the realm asks for a second factor (T-5120,
               components/keycloak/values/config/base-values.yaml.gotmpl). */}}
        {{- if or (has "platform-admin" ($user.realmRoles | default list)) (and (ne (toString $.Values.global.approverMfa) "false") (has "portal-approver" ($user.realmRoles | default list))) }}
        totp:
          length: 32
          generate: true
        {{- end }}
        componentNamespaces:
          - keycloak
  {{- end }}

  # Every ContextBroker beside `main` (T-3989, ADR-N-046 §2.5): its database login, read by its
  # broker and by CloudNativePG for the owner it creates, and its `/q` admin token, read by its
  # broker and the Portal's view writer, as components/context-broker/secrets.yaml for `main`.
  {{- if has "context-broker" .Values.components }}
  {{- range $b := .Values.global.contextBrokers | default list }}
  contextBroker-{{ $b.name }}:
    generated:
      db-antares-{{ $b.name }}:
        username: 'antares'
        password:
          length: 32
          generate: true
        componentNamespaces:
          - context-broker
      context-broker-{{ $b.name }}-admin-token:
        token:
          length: 48
          generate: true
        componentNamespaces:
          - context-broker
          - portal
  {{- end }}
  {{- end }}

  # Every catalogue beside `catalogue` (T-4636, global.catalogues): its own database logins, CKAN
  # `SECRET_KEY` and site administrator, as components/ckan/secrets.yaml for the default instance,
  # so no instance can sign another's sessions or log in to another's databases.
  {{- if has "ckan" .Values.components }}
  {{- range $c := .Values.global.catalogues | default list }}
  {{- $n := $c.name | replace "-" "_" }}
  ckan-{{ $c.name }}:
    generated:
      db-ckan-{{ $c.name }}:
        username: 'ckan_{{ $n }}'
        password:
          length: 32
          generate: true
        componentNamespaces:
          - ckan
          - postgres
      db-ckan-datastore-read-{{ $c.name }}:
        username: 'ckan_datastore_read_{{ $n }}'
        password:
          length: 32
          generate: true
        componentNamespaces:
          - ckan
          - postgres
      ckan-session-{{ $c.name }}:
        secret:
          length: 32
          generate: true
        componentNamespaces:
          - ckan
      ckan-admin-credentials-{{ $c.name }}:
        username: 'ckan_admin'
        email: 'ckan-admin-{{ $c.name }}@joinedcontext.invalid'
        password:
          length: 32
          generate: true
          special: true
        componentNamespaces:
          - ckan
  {{- end }}
  {{- end }}

  # Auto-generate confidential Keycloak client secrets from component keycloak-clients.yaml files.
  {{- $root := .Values }}
  {{- range $component := .Values.components }}
    {{- $addonPath := printf "../../deployment/addons/%s" $component }}
    {{- $componentPath := printf "../../components/%s/keycloak-clients.yaml" $component }}
    {{- $filePath := $componentPath }}
    {{- if isDir $addonPath }}
      {{- $filePath = printf "%s/keycloak-clients.yaml" $addonPath }}
    {{- end }}
    {{- if isFile $filePath }}
      {{- $componentValuesKey := $component }}
      {{- if not (hasKey $root $componentValuesKey) }}
        {{- range $rootKey, $rootVal := $root }}
          {{- if and (kindIs "map" $rootVal) (eq ($rootKey | kebabcase) ($component | kebabcase)) }}
            {{- $componentValuesKey = $rootKey }}
          {{- end }}
        {{- end }}
      {{- end }}
      {{- $clients := readFile $filePath | fromYaml | default dict }}
      {{- range $clientId, $client := $clients }}
        {{- $rawValues := index $client "rawValues" | default dict }}
        {{- $isPublicClient := index $rawValues "publicClient" | default false }}
        {{- $profiles := index $client "profiles" | default list }}
        {{- /* A federated client (PF-47) proves itself with its pod's projected token: no secret. */}}
        {{- if and (not $isPublicClient) (not (index $client "federated")) (or (not $profiles) (has ($root.global.valuesProfile | default $root.global.profile) $profiles)) (not (and (eq $root.global.profile "production") (index $client "test"))) }}
          {{- $targetComponents := index $client "componentNamespaces" | default (list $componentValuesKey) }}
  keycloakClient-{{ $component | kebabcase }}-{{ $clientId }}:
    generated:
      keycloak-client-{{ $clientId }}:
        client-secret:
          length: 32
          generate: true
        componentNamespaces:
          - keycloak
          {{- range $targetComponent := $targetComponents }}
          - {{ $targetComponent }}
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}
