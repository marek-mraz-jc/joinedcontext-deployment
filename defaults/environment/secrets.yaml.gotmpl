managedSecrets:
  {{ include "jc.configFiles" (dict "components" .Values.components "file" "secrets.yaml") }}

  # One generated password per demo realm user (development profile only, see
  # components/keycloak/demo-users.yaml). Only the outer values (global, components) are
  # visible here, so the file is read directly. `special: true` guarantees the
  # upper/lower/digit mix the realm password policy demands.
  {{- $demoUsers := dict }}
  {{- if and (has "keycloak" .Values.components) (eq .Values.global.profile "development") }}
  {{- $demoUsers = readFile "../../components/keycloak/demo-users.yaml" | fromYaml }}
  {{- end }}
  {{- range $name, $_ := $demoUsers }}
  keycloakUser-{{ $name | replace "." "-" }}:
    generated:
      keycloak-user-{{ $name | replace "." "-" }}:
        password:
          length: 32
          generate: true
          special: true
        componentNamespaces:
          - keycloak
  {{- end }}

  # Auto-generate confidential Keycloak client secrets from component keycloak-clients.yaml files.
  {{- $root := .Values }}
  {{- range $component := .Values.components }}
    {{- $addonPath := printf "../../deployment/addons/%s" $component }}
    {{- $componentPath := printf "../../components/%s/keycloak-clients.yaml" $component }}
    {{- $filePath := $componentPath }}
    {{- if isDir $addonPath }}
      {{- $filePath = printf "%s/keycloak-clients.yaml" $addonPath }}
    {{- end }}
    {{- if isFile $filePath }}
      {{- $componentValuesKey := $component }}
      {{- if not (hasKey $root $componentValuesKey) }}
        {{- range $rootKey, $rootVal := $root }}
          {{- if and (kindIs "map" $rootVal) (eq ($rootKey | kebabcase) ($component | kebabcase)) }}
            {{- $componentValuesKey = $rootKey }}
          {{- end }}
        {{- end }}
      {{- end }}
      {{- $clients := readFile $filePath | fromYaml | default dict }}
      {{- range $clientId, $client := $clients }}
        {{- $rawValues := index $client "rawValues" | default dict }}
        {{- $isPublicClient := index $rawValues "publicClient" | default false }}
        {{- $profiles := index $client "profiles" | default list }}
        {{- if and (not $isPublicClient) (or (not $profiles) (has $root.global.profile $profiles)) }}
          {{- $targetComponents := index $client "componentNamespaces" | default (list $componentValuesKey) }}
  keycloakClient-{{ $component | kebabcase }}-{{ $clientId }}:
    generated:
      keycloak-client-{{ $clientId }}:
        client-secret:
          length: 32
          generate: true
        componentNamespaces:
          - keycloak
          {{- range $targetComponent := $targetComponents }}
          - {{ $targetComponent }}
          {{- end }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}
