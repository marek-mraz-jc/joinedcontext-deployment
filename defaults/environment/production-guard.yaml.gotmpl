{{- /*
  CC-73, T-1720: a production instance is named by its own domain. The defaults carry the
  development placeholder `joinedcontext.test` (RFC 2606), and dev runs on dev.joinedcontext.com
  (the node's sslip.io host before T-2806); a production render that inherits any of them is dev
  under another name, so it stops here and says which value to set.
*/}}
{{- if eq .Values.global.profile "production" }}
{{- range $key := list "domain" "orgDomain" }}
{{- $value := index $.Values.global $key | default "" | toString }}
{{- if or (eq $value "") (hasSuffix ".test" $value) (hasSuffix ".localhost" $value) (eq $value "localhost") (contains "sslip.io" $value) (eq $value "dev.joinedcontext.com") (hasSuffix ".dev.joinedcontext.com" $value) }}
{{- fail (printf "global.%s is %q: a production instance names its own domain, not the development placeholder or a dev cluster host (CC-73, T-1720)" $key $value) }}
{{- end }}
{{- end }}
{{- range $key := list "contact" "expires" }}
{{- if eq (index $.Values.global.securityTxt $key | default "" | toString) "" }}
{{- fail (printf "global.securityTxt.%s is empty: a production instance serves security.txt with its own contact and expiry (RFC 9116, OPS-52, T-1721)" $key) }}
{{- end }}
{{- end }}
{{- end }}
{}
