<%# The platform's assistant on every public page (T-6449): the launcher of the deployment the
    environment names, in the page's language. Decidim's override point for the layout head. %>
<% if ENV["ASSISTANT_ORIGIN"].present? %>
  <%# Below 640 px the cookie banner's buttons fill the width: room under them for the launcher. %>
  <style>@media (max-width: 640px) { .cookies__container { padding-bottom: 76px; } }</style>
  <%= tag.script(src: "#{ENV["ASSISTANT_ORIGIN"]}/d/#{ENV.fetch("ASSISTANT_PUBLIC_ID")}/embed.js", defer: true, data: { lang: I18n.locale }) %>
<% end %>
