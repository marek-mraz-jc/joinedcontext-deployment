{{- /*
  The demo's catalogue (T-4687): the platform's CKAN chart and pins, with only Banská Bystrica and
  the region. Their harvest sources and the publish gate's hidden packages are read from the
  platform's own catalogue values, so a correction made there reaches the demo with no copy to
  keep in step; nothing of another publisher is taken.
*/}}
{{- $publishers := list "banskabystrica" "bbsk" }}
{{- $images := (readFile "../../../components/ckan/images.yaml" | fromYaml).ckan }}
{{- $platform := readFile "../../../components/ckan/values/catalogue/development-values.yaml.gotmpl" | fromYaml }}
{{- $security := (readFile "../../../defaults/environment/security.yaml.gotmpl" | fromYaml).securityDefaults }}
{{- $sources := list }}
{{- range $platform.harvest.sources }}
{{- if has .name $publishers }}{{ $sources = append $sources . }}{{ end }}
{{- end }}
{{- if ne (len $sources) (len $publishers) }}
{{- fail (printf "demo-bbsk: the platform's catalogue harvests %d of %v (T-4687)" (len $sources) $publishers) }}
{{- end }}
{{- $ribbon := "DEMO · ukážka, nie oficiálna stránka BBSK" }}
fullnameOverride: ckan-demo-bbsk
siteUrl: https://{{ .Values.host }}

ckan:
  image:
    {{- toYaml $images.catalogue | nindent 4 }}
  locales:
    default: sk
    offered: [sk, en]
  storage:
    size: 2Gi
  resources:
    requests: { cpu: 100m, memory: 352Mi }
    limits: { cpu: '1', memory: 1Gi }

solr:
  image:
    {{- toYaml $images.solr | nindent 4 }}
  heap: 256m
  storage:
    size: 2Gi
  resources:
    requests: { cpu: 50m, memory: 512Mi }
    limits: { cpu: '1', memory: 1Gi }

redis:
  image:
    {{- toYaml $images.redis | nindent 4 }}
  resources:
    requests: { cpu: 10m, memory: 32Mi }
    limits: { cpu: 200m, memory: 128Mi }

# The demo's own Postgres (chart/templates/postgres.yaml) and the Secrets beside it, by the names
# the chart reads by default.
database:
  host: demo-bbsk-db.demo-bbsk.svc.cluster.local

# Our design, not BBSK's (the region's logo and colours are theirs): the platform's tokens, the
# demo's name, and the DEMO line on top of every page, in its footer and in its title.
branding:
  instanceName: "DEMO · Banskobystrický samosprávny kraj"
  shortName: "DEMO BBSK"
  siteTitle: "DEMO · Banskobystrický samosprávny kraj"
  tagline: "Ukážka: AI asistent nad otvorenými dátami Banskobystrického kraja a mesta Banská Bystrica."
  organisation: joinedcontext
  domain: {{ .Values.domain }}
  ribbon: {{ $ribbon | quote }}
  noindex: true
  footerLines:
    - {{ $ribbon | quote }}
    - "Odpovede tvorí umelá inteligencia z verejných stránok a otvorených dát. Môžu obsahovať chyby, overte si dôležité informácie v uvedených zdrojoch."
  colours:
    primary: '#0000bf'
    secondary: '#0072c6'
    accent: '#ffe977'
    background: '#ffffff'
    text: '#1a1a1a'
  fonts:
    heading: system-ui, sans-serif
    body: system-ui, sans-serif
  languages:
    default: sk
    offered: [sk, en]

organizations:
  {{- toYaml (pick $platform.organizations "banskabystrica" "bbsk") | nindent 2 }}

hidden:
{{- range $package, $why := $platform.hidden }}
{{- if or (hasPrefix "bb-" $package) (hasPrefix "bbsk-" $package) }}
  {{ $package | quote }}: {{ $why | quote }}
{{- end }}
{{- end }}

harvest:
  gateway: https://api.{{ .Values.domain }}
  datasetsBase: {{ $platform.harvest.datasetsBase | quote }}
  sources:
    {{- toYaml $sources | nindent 4 }}

# The region's demo assistant, docked on every page (T-4685); its AssistantDeployment allows this
# host as an origin (components/context-gateway/seed/bbsk/bbsk-assistant-demo.yaml).
assistantWidget: https://assistant.{{ .Values.domain }}/d/bbsk-demo/widget
mapBasemap:
  style: https://tiles.{{ .Values.domain }}/styles/light-sk.json

podSecurityContext:
  {{- toYaml $security.podSecurityContext | nindent 2 }}
securityContext:
  {{- toYaml $security.securityContext | nindent 2 }}
serviceMesh:
  enabled: false
