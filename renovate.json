{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Bump PRs for what this repository pins (docs/analysis/iac-practices.md R1, R3, R4): remote chart versions in components/*/charts.yaml and the helmfiles, third-party images by tag and digest in components/*/images.yaml and the Dockerfiles, GitHub Actions by commit SHA, tool versions in tools.env. Nothing is proposed before it is 7 days old. Our own ghcr.io/marek-mraz-jc images are pinned by .github/workflows/pin-images.yml, not here.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile",
    "github-actions",
    "helmfile"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "renovate",
      "security"
    ]
  },
  "separateMajorMinor": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts from HTTP(S) repositories in components/*/charts.yaml; the helmfile repository alias is stripped because chart names in the repository index do not contain it",
      "managerFilePatterns": [
        "/^components/[^/]+/charts\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<registryUrl>https?://[^\\s'\"]+)['\"]?\\s*\\n\\s*chart:\\s*['\"]?(?:[^\\s/'\"]+/)?(?<depName>[^\\s/'\"]+)['\"]?\\s*\\n\\s*version:\\s*['\"]?(?<currentValue>[^'\"\\n]+)['\"]?"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "OCI Helm charts in components/*/charts.yaml",
      "managerFilePatterns": [
        "/^components/[^/]+/charts\\.yaml$/"
      ],
      "matchStrings": [
        "chart:\\s*['\"]?oci://(?<depName>[^\\s'\"]+)['\"]?\\s*\\n\\s*version:\\s*['\"]?(?<currentValue>[^'\"\\n]+)['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Container images in components/*/images.yaml: repository, tag and digest in that order, comment lines allowed between them; the PR moves tag and digest together",
      "managerFilePatterns": [
        "/^components/[^/]+/images\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*['\"]?(?<depName>[^\\s'\"]+)['\"]?\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s*tag:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s*digest:\\s*['\"]?(?<currentDigest>sha256:[a-f0-9]{64})['\"]?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Tool versions in tools.env, each under a '# renovate:' comment naming its datasource",
      "managerFilePatterns": [
        "/^tools\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n[A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Our own images: pin-images.yml pins them by digest on every build",
      "matchPackageNames": [
        "ghcr.io/marek-mraz-jc/**"
      ],
      "enabled": false
    },
    {
      "description": "One PR per kind for minor and patch bumps; majors stay one PR each",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchFileNames": [
        "components/*/charts.yaml",
        "components/*/helmfile.yaml.gotmpl",
        ".ci/kyverno/**",
        "demos/**"
      ],
      "groupName": "helm charts"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchFileNames": [
        "components/*/images.yaml",
        "images/**"
      ],
      "groupName": "container images"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "A tool bump also needs its new sha256 in tools.env, which the PR leaves stale: CI fails at the download until a reviewer pins it",
      "matchFileNames": [
        "tools.env"
      ],
      "groupName": "ci tools",
      "addLabels": [
        "needs-checksum"
      ]
    }
  ]
}
