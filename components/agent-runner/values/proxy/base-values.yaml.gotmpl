---
{{- $thisProxy := index .Values "agent-runner" "proxy" -}}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> /healthz
# - [x] Graceful shutdown
# - [x] Standard labels
# - [x] ServiceAccount with least privilege where required -> no API token
# - [x] Named ports -> 8080 container mapped to 8080 service
# - [ ] Ingress with TLS -> not applicable, reached from the Portal alone

fullnameOverride: agent-proxy
nameOverride: agent-runner-proxy

{{- $images := index .Values.images "agent-runner" "proxy" }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

# The image's entrypoint is the gateway; the proxy is the binary beside it.
command:
  - /usr/local/bin/jc-agent-proxy

containerPort: 8080

service:
  enabled: true
  type: ClusterIP
  port: 8080
  targetPort: 8080
  name: http

probes:
  readiness:
    path: /healthz
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /healthz
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 5

# Every credential the proxy holds, and none of them reaches a workspace (AG-50): the
# Keycloak client secret and the internal-listener bearer are generated by the secrets
# component, the forge token is minted by the forge's bootstrap Job, the model key is the
# operator's.
envSecret:
  JC_OIDC_CLIENT_SECRET:
    secret: keycloak-client-{{ $thisProxy.project }}-agent-proxy
    key: client-secret
  JC_MODEL_KEY:
    secret: {{ $thisProxy.modelKeySecret }}
    key: key
{{- if has "gitea" .Values.components }}
  # ponytail: the Portal's own forge token, until the bootstrap Job mints one per consumer;
  # a `static` run commits through the Portal and never through this route.
  JC_FORGE_TOKEN:
    secret: gitea-token-portal
    key: token
{{- end }}

env:
  JC_PROXY_BIND: "0.0.0.0:8080"
  # The Portal's internal listener (AG-52): the run behind a ticket, and the events a run
  # posts. Port 9090, which the edge does not route.
  JC_PORTAL_BASE: "http://portal.{{ .Values.portal.portal.namespace }}.svc.cluster.local:9090"
  JC_GATEWAY_BASE: "http://context-gateway.{{ index .Values "context-gateway" "gateway" "namespace" }}.svc.cluster.local:8080"
{{- if has "gitea" .Values.components }}
  JC_FORGE_BASE: "http://gitea-http.{{ .Values.gitea.forge.namespace }}.svc.cluster.local:3000"
  JC_FORGE_REPO: "{{ $global.configRepo.owner }}/{{ $global.configRepo.name }}"
{{- end }}
  JC_OIDC_ISSUER: "https://idm.{{ $global.domain }}/realms/{{ $global.instanceSlug }}"
  # Where this proxy asks for a token, which is not the issuer: the issuer is the address a browser
  # uses, and a pod cannot dial its own cluster's ingress hostname (T-2272). Every token this proxy
  # mints goes through here — the endpoint tokens of a run, and its own for the Portal's internal
  # listener (T-2271).
  JC_OIDC_TOKEN_URL: "http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local:80{{ .Values.keycloak.app.pathPrefix | trimSuffix "/" }}/realms/{{ $global.instanceSlug }}/protocol/openid-connect/token"
  JC_OIDC_CLIENT_ID: "{{ $thisProxy.project }}-agent-proxy"
  JC_MODEL_BASE: {{ $thisProxy.modelBase | quote }}
  JC_MODEL_PROVIDER: {{ $thisProxy.modelProvider | quote }}

# The token endpoint on the cluster's public host and the model provider are both the
# proxy's own TLS to hosts outside the mesh, the hop the Portal's values describe: 443 leaves
# the outbound redirect, every in-cluster call stays meshed.
podAnnotations:
  config.linkerd.io/skip-outbound-ports: "443"

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
