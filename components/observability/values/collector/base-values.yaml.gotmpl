---
{{- $global := .Values.global }}
# Checklist:
# - [x] Runs as non-root with `readOnlyRootFilesystem` -> config is a read-only ConfigMap mount
# - [x] Health probes -> the health_check extension on 13133, which is the container port
# - [x] Graceful shutdown -> the collector drains its queue on SIGTERM
# - [x] Standard labels
# - [x] ServiceAccount with least privilege -> no Kubernetes API access at all
# - [x] Named ports -> otlp-grpc 4317, otlp-http 4318, metrics 8888, health 13133
# - [ ] Ingress with TLS -> not applicable, no route publishes it (Deployment/05 section 5)

fullnameOverride: observability-collector
nameOverride: observability-collector

{{- $image := index .Values.images "observability" "collector" }}
image:
  repository: {{ $image.repository }}
  tag: {{ $image.tag | quote }}
  digest: {{ $image.digest }}
  pullPolicy: IfNotPresent

args:
  - --config=/etc/otelcol/config.yaml

# The health_check extension, not an OTLP port: a probe on 4318 would ask the OTLP receiver
# for a path it does not serve and read the 404 as a dead pod. The chart probes
# `containerPort`, so that is the one the container declares.
containerPort: 13133

service:
  enabled: true
  type: ClusterIP
  name: otlp-grpc
  port: 4317
  targetPort: 4317
  extraPorts:
    - name: otlp-http
      port: 4318
      targetPort: 4318
      protocol: TCP

metrics:
  enabled: true
  name: metrics
  port: 8888

probes:
  readiness:
    path: /
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 10

# The client secret of the Keycloak ServiceAccount client, generated by the secrets component.
# The collector reads it through `${env:...}` in its config; a secret written into the
# ConfigMap would be a plaintext credential in a rendered manifest.
envSecret:
  JC_ACTIVITY_CLIENT_SECRET:
    secret: keycloak-client-activity-ingest
    key: client-secret

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}
  # The upstream image's own user; the collector writes nothing outside /tmp.
  runAsUser: 10001
  fsGroup: 10001

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}

configMap:
  enabled: true
  name: observability-collector-config
  mountPath: /etc/otelcol
  data:
    config.yaml: |
      extensions:
        health_check:
          endpoint: 0.0.0.0:13133
        # Client credentials against the realm, refreshed by the collector. The token the
        # Portal's ingest route checks is bound to the portal-api audience by a mapper on
        # this client, so a token minted for anything else is refused there.
        oauth2client:
          client_id: activity-ingest
          client_secret: ${env:JC_ACTIVITY_CLIENT_SECRET}
          token_url: "http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local:80{{ .Values.keycloak.app.pathPrefix | trimSuffix "/" }}/realms/{{ $global.instanceSlug }}/protocol/openid-connect/token"

      receivers:
        otlp:
          protocols:
            grpc:
              endpoint: 0.0.0.0:4317
            http:
              endpoint: 0.0.0.0:4318

      processors:
        # A collector that runs out of memory takes the telemetry of every component with it,
        # so it refuses data before the kernel refuses the process.
        memory_limiter:
          check_interval: 1s
          limit_percentage: 75
          spike_limit_percentage: 20

        # An activity event names its project. A record that names none cannot be shown to
        # anyone without guessing whose it is, so it is dropped here rather than stored and
        # filtered later, and the same for a record with no kind.
        filter/activity:
          error_mode: ignore
          logs:
            log_record:
              - 'attributes["project"] == nil'
              - 'attributes["kind"] == nil'

        # The allow-list of OPS-48. `keep_keys` deletes every attribute not named, so a new
        # attribute anywhere upstream is invisible until somebody adds it to this list on
        # purpose. The body goes too: `summary` is an attribute, and a log body is exactly
        # where a raw request would arrive.
        transform/allowlist:
          error_mode: ignore
          log_statements:
            - context: resource
              statements:
                - keep_keys(attributes, ["service.name"])
            - context: log
              statements:
                - set(body, "")
                - keep_keys(attributes, ["project", "space", "kind", "source", "summary", "severity", "correlationId", "details"])

        batch:
          timeout: 5s
          send_batch_size: 512

      exporters:
        otlphttp/portal:
          # The Portal owns the activity table and is its only writer (Deployment/05 section 5).
          logs_endpoint: "http://portal.{{ .Values.portal.portal.namespace }}.svc.cluster.local:8080/api/v1/activity"
          encoding: json
          auth:
            authenticator: oauth2client

      service:
        extensions: [health_check, oauth2client]
        pipelines:
          logs:
            receivers: [otlp]
            processors: [memory_limiter, filter/activity, transform/allowlist, batch]
            exporters: [otlphttp/portal]
        telemetry:
          metrics:
            readers:
              - pull:
                  exporter:
                    prometheus:
                      host: 0.0.0.0
                      port: 8888
