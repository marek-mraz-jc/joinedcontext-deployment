---
apps-db:
  cluster:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "apps-db") }}
    name: apps-db
    # How many shards jc-wasm-host runs (AP-143): each gets its login role `wasm_host_<shard>`
    # and its own password. Raising it adds roles; lowering it is a migration of the Apps placed
    # on the shards that go (ADR-N-044 §2.1), never a value change alone.
    shards: 2
    # WAL archiving and daily base backups to the object store, as the platform's cluster does
    # (components/postgres, OPS-09). Off until an operator supplies the bucket's credentials in
    # the Secret `existingSecret` names; never templated here.
    backups:
      enabled: false
      provider: 's3'
      endpointURL: ''
      destinationPath: ''
      region: ''
      bucket: ''
      path: '/'
      # '' names an external store by the keys above; 'artifact-store' archives to the platform's own (T-5662).
      target: ''
      existingSecret: 'apps-db-backup-s3'
      retentionPolicy: '30d'
      schedule: '0 30 3 * * *'
  backup:
    # The release is the dump (and the chart's stat-statements Job); an instance whose apps-db
    # archives to an object store (cluster.backups above) leaves it off.
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "apps-db") }}
    # As postgres.databases.localBackup. apps-db held 30 MB on smartcity (2026-10-25), so 1Gi
    # keeps a week of dumps; 15 min after the platform cluster's dump.
    localBackup:
      enabled: true
      schedule: '45 2 * * *'
      keepDays: 7
      size: 1Gi
      excludeDatabases: []
      # As postgres.databases.localBackup.ageRecipients: the dev age key of .sops.yaml.
      ageRecipients: [age1dwqmmfzz3d953uawww9nzp56vhl9j4ljg3l06mrzp8xuwu6l09cq3mwj55]
