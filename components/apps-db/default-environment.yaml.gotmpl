---
apps-db:
  cluster:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "apps-db") }}
    name: apps-db
    # How many shards jc-wasm-host runs (AP-143): each gets its login role `wasm_host_<shard>`
    # and its own password. Raising it adds roles; lowering it is a migration of the Apps placed
    # on the shards that go (ADR-N-044 §2.1), never a value change alone.
    shards: 2
    # WAL archiving and daily base backups to the object store, as the platform's cluster does
    # (components/postgres, OPS-09). Off until an operator supplies the bucket's credentials in
    # the Secret `existingSecret` names; never templated here.
    backups:
      enabled: false
      provider: 's3'
      endpointURL: ''
      destinationPath: ''
      region: ''
      bucket: ''
      path: '/'
      existingSecret: 'apps-db-backup-s3'
      retentionPolicy: '30d'
      schedule: '0 30 3 * * *'
