---
# One instance on the dev node, sized for its first hundred Apps; T-3345 measures what
# ten thousand need before production is sized.
cluster:
  instances: 1
  resources:
    requests:
      cpu: 50m
      # T-4473: dev, kubectl top 2026-10-17 21:22-22:22Z: median 97, peak 111Mi.
      memory: 128Mi
    limits:
      cpu: '1'
      memory: 768Mi
  storage:
    size: 2Gi
