---
{{- $this := .Values.apisix.configuration -}}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [ ] Health probes -> not applicable
# - [x] Graceful shutdown
# - [x] Standard labels
# - [ ] ServiceAccount with least privilege where required
# - [ ] Named ports -> not applicable
# - [ ] Ingress with TLS -> not (yet) applicable

plugins:
{{- range $component, $config := .Values.plugins }}
  {{ $component }}:
{{ $config | toYaml | nindent 4 }}
{{- end }}

routes:
{{- range $component, $config := .Values.routes }}
  {{ $component }}:
{{ $config | toYaml | nindent 4 }}
{{- end }}

domain: {{ $global.domain }}
realm: {{ $global.instanceSlug }}

# The SAN list is the apex plus every routed subdomain, derived from the same route map the
# ConfigMap is built from, so a new route can never end up on an uncovered hostname. Several
# routes share one subdomain (the Portal's three), so the list is de-duplicated.
{{- $subDomains := list }}
{{- range $component, $config := .Values.routes }}
{{- if hasKey $config "subDomain" }}
{{- $subDomains = append $subDomains $config.subDomain }}
{{- end }}
{{- end }}
{{- $subDomains = $subDomains | uniq | sortAlpha }}
edge:
  enabled: {{ $global.ingress.enabled }}
  secretName: apisix-edge-tls
  clusterIssuer: {{ $global.ingress.clusterIssuer | quote }}
  ingressClass: {{ $global.ingress.ingressClass | quote }}
  hosts:
    - {{ $global.domain | quote }}
    {{- range $subDomains }}
    - {{ printf "%s.%s" . $global.domain | quote }}
    {{- end }}

# Authorize the ingress edge to reach the APISIX data plane when the
# namespace enforces mandatory mTLS via the Linkerd default-inbound-policy.
# `allowUnauthenticatedIngress` mirrors the global setting: true accepts plaintext
# from an unmeshed ingress, false requires the ingress controller to be meshed.
{{- $allowUnauthIngress := false }}
{{- if hasKey ($global.serviceMesh | default dict) "allowUnauthenticatedIngress" }}
{{- $allowUnauthIngress = $global.serviceMesh.allowUnauthenticatedIngress }}
{{- end }}
serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
  allowUnauthenticatedIngress: {{ $allowUnauthIngress }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}
