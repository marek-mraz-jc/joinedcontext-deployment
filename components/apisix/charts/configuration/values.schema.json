{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values of configuration (T-4956: an unknown key is a typo and fails the render)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plugins": {
      "type": "object"
    },
    "routes": {
      "type": "object"
    },
    "maxRequestBodyMegabytes": {
      "type": "number"
    },
    "domain": {
      "type": "string"
    },
    "realm": {
      "type": "string"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        },
        "clusterIssuer": {
          "type": "string"
        },
        "ingressClass": {
          "type": "string"
        },
        "hosts": {
          "type": "array"
        },
        "stagingHosts": {
          "type": "array"
        },
        "appsWildcard": {
          "type": "string"
        },
        "appHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        },
        "websocketHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untrustedHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "loginHost": {
          "type": "string"
        },
        "issuedCertificates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "organizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "catalogueId": {
                "type": "string"
              },
              "host": {
                "enum": [
                  "auto"
                ]
              },
              "domain": {
                "type": "string",
                "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
              },
              "hosts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "portal"
                ],
                "properties": {
                  "portal": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                  },
                  "opendata": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                  },
                  "api": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                  },
                  "mcp": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                  },
                  "idm": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                  }
                }
              },
              "resolved": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
                }
              },
              "certificate": {
                "enum": [
                  "hosts",
                  "organization"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "host"
                ],
                "not": {
                  "required": [
                    "hosts"
                  ]
                }
              },
              {
                "required": [
                  "hosts"
                ],
                "not": {
                  "required": [
                    "host"
                  ]
                }
              }
            ]
          }
        },
        "dns01": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "validationZone": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
                }
              ]
            },
            "provider": {
              "enum": [
                "",
                "cloudflare",
                "rfc2136"
              ]
            },
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "rfc2136": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "nameserver": {
                  "type": "string"
                },
                "tsigKeyName": {
                  "type": "string"
                },
                "tsigAlgorithm": {
                  "type": "string"
                }
              }
            }
          }
        },
        "certificateStage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "serviceMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "podSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app.kubernetes.io/name": {
              "type": "string"
            }
          }
        },
        "dataPlanePort": {
          "type": "number"
        },
        "allowUnauthenticatedIngress": {
          "type": "boolean"
        }
      }
    },
    "composer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccount": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "global": {
      "type": "object"
    }
  }
}
