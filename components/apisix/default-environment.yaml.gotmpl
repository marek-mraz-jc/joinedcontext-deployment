---
apisix:
  apisix:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "apisix") }}
    subdomain: "apisix"
    pathPrefix: "/"
    # Where the hop in front of APISIX lives, so nginx rewrites the caller's address out of
    # `X-Forwarded-For` instead of logging and rate-limiting the ingress controller's pod
    # (T-0929). k3s and kube-hetzner both hand pods 10.42.0.0/16; a cluster with another pod
    # network overrides this in its environment.
    trustedProxyCidr: "10.42.0.0/16"
  configuration:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "apisix") }}
  # The DNS-01 solver runs beside cert-manager, which calls it (ADR-N-037 §6, T-3013).
  {{- $wildcard := dig "ingress" "appsWildcard" dict .Values.global }}
  dns01:
    enabled: {{ and (dig "ingress" "enabled" false .Values.global) (dig "enabled" false $wildcard) }}
    namespace: {{ dig "certManagerNamespace" "cert-manager" $wildcard | quote }}
