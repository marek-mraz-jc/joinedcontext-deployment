{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values of dashboards (T-4956: an unknown key is a typo and fails the render)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "configMapName": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "global": {
      "type": "object"
    },
    "projectsConfigMapName": {
      "type": "string"
    },
    "gatewayUrl": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "groups",
          "endpoints"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^/[a-z0-9/-]+$"
            }
          },
          "endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "slug"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z2-7]{26,}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
