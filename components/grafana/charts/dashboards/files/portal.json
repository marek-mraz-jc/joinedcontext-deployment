{
  "uid": "jc-portal",
  "title": "Portal — traffic and proposals",
  "description": "The Portal as it sees itself (T-0463). The proposal counters are the interesting half: a change classified into the green lane is applied by the Portal, an amber or red one waits for a person, and the edge cannot tell the three apart.",
  "tags": [
    "joinedcontext",
    "portal"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "The route label is the matched path pattern, so the API and the UI separate without a per-project series.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jc_portal_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Answers by status",
      "description": "Statuses the Portal produced. The scrape and the health probe are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jc_portal_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Service time, p95 by route",
      "description": "A save that writes to Git is the slow one here; a read served from the mirror is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(jc_portal_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Changes proposed per second, by lane",
      "description": "Where the classifier put each proposal. A green lane that stops moving while amber grows is a rule change or a project that started editing something riskier (CC-63).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jc_portal_changes_total[5m])) by (lane)",
          "legendFormat": "{{lane}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Proposals in the window, by kind",
      "description": "Which manifest kinds people are actually editing. The kind vocabulary is closed, so this is bounded however many projects exist.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(8, sum(increase(jc_portal_changes_total[6h])) by (kind))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "At the edge: requests per second by route",
      "description": "APISIX's counters for the Portal's two routes, for the requests that never reached the process.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(apisix_http_status{route=~\"portal-api|portal-ui\"}[1m])) by (route)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
