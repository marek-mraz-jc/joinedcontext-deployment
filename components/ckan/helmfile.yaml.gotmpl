---
bases:
  - "../../defaults/helm-defaults.yaml"
---
{{- $componentData := (readFile "./component.yaml" | fromYaml) }}

{{- $root := .Values }}
{{- $component := $componentData.component }}
{{- $parts :=  $componentData.parts }}

repositories:
{{- $alreadyAdded := dict }}
{{- range $parts }}
  {{- $part := . }}
  {{- $repoUrl := index $root.charts $component $part.name "repository" | default "" }}
  {{- if ne $repoUrl "" }}
    {{- $chart := index $root.charts $component $part.name "chart" }}
    {{- $chartParts := splitList "/" $chart }}
    {{- $repoName := index $chartParts 0 }}
    {{- if not (hasKey $alreadyAdded $repoName) }}
      {{- $_ := set $alreadyAdded $repoName true }}
  - name: cc2-{{ $repoName }}
    url: {{ $repoUrl }}
    {{- end }}
  {{- end }}
{{- end }}

releases:
  {{- range $parts }}
  {{- $part := . }}
  {{- $releaseName := printf "%s-%s" ($component | kebabcase) $part.name }}
  {{- $repoUrl := index $root.charts $component $part.name "repository" | default "" }}
  - name: {{ $releaseName }}
    labels:
      release: {{ $releaseName }}
      {{- range $key, $value := (index $part "extraLabels" | default dict) }}
      {{ $key }}: {{ $value }}
      {{- end }}
    namespace: {{ index $root $component $part.name "namespace" }}
    {{- if ne $repoUrl "" }}
    chart: cc2-{{ index $root.charts $component $part.name "chart" }}
    {{- else }}
    chart: {{ index $root.charts $component $part.name "chart" }}
    {{- end }}
    {{- if index $root.charts $component $part.name "version" }}
    version: {{ index $root.charts $component $part.name "version" }}
    {{- end }}
    createNamespace: {{ $root.global.createNamespaces }}
    {{- if index $part "timeout" }}
    timeout: {{ $part.timeout }}
    {{- end }}
    installed: {{ index $root $component $part.name "enabled" }}
    condition: {{ $component }}.{{ $part.name }}.enabled
    {{- if index $part "needs" }}
    needs:
      {{ range index $part "needs" }}
        {{- $items := splitList "." . -}}
        {{- $depComponent := index $items 0 -}}
        {{- $depPart := index $items 1 -}}
      - {{ index $root $depComponent $depPart "namespace" }}/{{ printf "%s-%s" ($depComponent | kebabcase) $depPart }}
      {{- end }}
    {{- end }}
    {{- if index $part "hooks" }}
    hooks:
      {{- range index $part "hooks" }}
      - {{ . | toYaml | nindent 8 }}
      {{- end }}
    {{- end }}
    values:
      - values/{{ $part.name | kebabcase }}/base-values.yaml.gotmpl
      - values/{{ $part.name | kebabcase }}/{{ $root.global.profile }}-values.yaml.gotmpl
      - {{- index $root $component $part.name "rawValues" | default dict | toYaml | nindent 8 }}
  {{- end }}

  {{- /* Every catalogue beside `catalogue` (T-4636; global.catalogues, checked by
         defaults/environment/catalogues-guard.yaml.gotmpl): a CKAN release of its own beside the
         default instance, with its own Solr, Redis, storage, Secrets and databases. base-values
         reads the instance's words from `ckan.<name>` by the release's `catalogue` label; its
         publishers and sizes are values/<name>/. */}}
  {{- $catalogue := $root.ckan.catalogue }}
  {{- range $c := $root.global.catalogues | default list }}
    {{- $name := $c.name }}
    {{- $release := printf "ckan-%s" $name }}
    {{- if eq $c.subDomain $catalogue.subDomain }}
      {{- fail (printf "global.catalogues: %s: subDomain %q is the default catalogue's (T-4636)" $name $c.subDomain) }}
    {{- end }}
    {{- $n := $name | replace "-" "_" }}
  - name: {{ $release }}
    labels:
      release: {{ $release }}
      catalogue: {{ $name }}
    namespace: {{ $catalogue.namespace }}
    chart: {{ index $root.charts $component "catalogue" "chart" }}
    createNamespace: {{ $root.global.createNamespaces }}
    installed: {{ $catalogue.enabled }}
    values:
      - values/catalogue/base-values.yaml.gotmpl
      - values/{{ $name }}/{{ $root.global.profile }}-values.yaml.gotmpl
      - fullnameOverride: {{ $release }}
        database:
          name: ckan_{{ $n }}
          user: ckan_{{ $n }}
          datastoreName: ckan_datastore_{{ $n }}
          secret:
            name: db-ckan-{{ $name }}
          datastoreRead:
            user: ckan_datastore_read_{{ $n }}
            secret:
              name: db-ckan-datastore-read-{{ $name }}
        secrets:
          session:
            name: ckan-session-{{ $name }}
          admin:
            name: ckan-admin-credentials-{{ $name }}
        apiToken:
          secret: {{ $release }}-api-token
  {{- end }}

commonLabels:
  component: {{ $component }}
