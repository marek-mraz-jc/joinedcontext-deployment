---
# Checklist:
# - [x] Minimal Resources
# - [x] Minimal storage
# - [x] 1 Replica

ckan:
  replicaCount: 1
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: '2'
      memory: 2Gi

solr:
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: '1'
      memory: 1Gi

redis:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 200m
      memory: 128Mi

# The demo's publishers (owner, 2026-10-12: "Pridaj obrázky"): a plain badge with initials, no
# coat of arms, since the instance is a demo and not affiliated with any of them; the words
# stand where a publisher set none in CKAN.
organizations:
  hel-fi:
    initials: HEL
    colour: '#0000bf'
    description:
      en: Open data of the Helsinki region, live from HSL public transport, Fintraffic parking and the city's own services, through joinedcontext endpoints.
      sk: Otvorené údaje regiónu Helsinki, naživo z verejnej dopravy HSL, parkovísk Fintraffic a mestských služieb, cez endpointy joinedcontext.
  praha:
    initials: PHA
    colour: '#b4232a'
    description:
      en: Open data of the City of Prague, published through joinedcontext endpoints.
      sk: Otvorené údaje hlavného mesta Prahy, publikované cez endpointy joinedcontext.
  zilina:
    initials: ZA
    colour: '#1f6f43'
    description:
      en: Open data of the City of Žilina and the University of Žilina, published through joinedcontext endpoints.
      sk: Otvorené údaje mesta Žilina a Žilinskej univerzity, publikované cez endpointy joinedcontext.
  banskabystrica:
    initials: BB
    colour: '#00579c'
  bbsk:
    initials: BBSK
    colour: '#7a1f5c'

# The city's 43 datasets in the national catalogue, harvested nightly into `banskabystrica`
# (T-4151). The corrections are docs Research/banska-bystrica-open-data-sources.md §7 and §8:
# four titles link another dataset's file, which is ingested once under the title its columns
# match; the dog registry locates people; contracts, orders and subsidies keep only the rows that
# carry an IČO. HTML and PDF answers where JSON is declared are found by the fetch itself.
harvest:
  sources:
    - name: banskabystrica
      sparql: https://data.slovensko.sk/api/sparql
      publisher: https://data.gov.sk/id/legal-subject/00313271
      publisherName: Mesto Banská Bystrica
      organization: banskabystrica
      namePrefix: bb-
      allowedHosts: [egov.banskabystrica.sk, dtm-banskabystrica.tmapserver.sk, www.banskabystrica.sk]
      # NKOD records the bare host, which 301s to www.
      rewriteHosts: {banskabystrica.sk: www.banskabystrica.sk}
      skip:
        Ulice: {state: mislinked, reason: 'not ingested, link points to Počet občanov podľa dňa narodenia (732 rows of Deň, Pohlavie, Počet)'}
        Počet občanov podľa mena: {state: mislinked, reason: 'not ingested, link points to Počet občanov podľa veku (105 rows of ages)'}
        Členovia orgánov samosprávy: {state: mislinked, reason: 'not ingested, link points to Evidencia psov (3 299 dog records)'}
        Počet občanov podľa ulíc BB: {state: mislinked, reason: 'not ingested, link points to Prírastky a úbytky občanov za jednotlivé roky (27 rows of years)'}
        Evidencia psov: {state: personal, reason: 'not ingested, street, house, flat and floor of each dog owner (Open data integration rules §1)'}
      requireColumn:
        Zmluvy BB: Zmluvné_strany_s_údajom_IČO
        Objednávky BB: IČO
        Dotácie: IČO_žiadateľa
