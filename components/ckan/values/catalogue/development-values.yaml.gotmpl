---
# Checklist:
# - [x] Minimal Resources
# - [x] Minimal storage
# - [x] 1 Replica

ckan:
  replicaCount: 1
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: '2'
      memory: 2Gi

solr:
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: '1'
      memory: 1Gi

redis:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 200m
      memory: 128Mi

# The demo's publishers (owner, 2026-10-12: "Pridaj obrázky"): a plain badge with initials, no
# coat of arms, since the instance is a demo and not affiliated with any of them; the words
# stand where a publisher set none in CKAN.
organizations:
  hel-fi:
    initials: HEL
    colour: '#0000bf'
    description:
      en: Open data of the Helsinki region, live from HSL public transport, Fintraffic parking and the city's own services, through joinedcontext endpoints.
      sk: Otvorené údaje regiónu Helsinki, naživo z verejnej dopravy HSL, parkovísk Fintraffic a mestských služieb, cez endpointy joinedcontext.
  praha:
    initials: PHA
    colour: '#b4232a'
    description:
      en: Open data of the City of Prague, published through joinedcontext endpoints.
      sk: Otvorené údaje hlavného mesta Prahy, publikované cez endpointy joinedcontext.
  zilina:
    initials: ZA
    colour: '#1f6f43'
    description:
      en: Open data of the City of Žilina and the University of Žilina, published through joinedcontext endpoints.
      sk: Otvorené údaje mesta Žilina a Žilinskej univerzity, publikované cez endpointy joinedcontext.
  banskabystrica:
    initials: BB
    colour: '#00579c'
  bbsk:
    initials: BBSK
    colour: '#7a1f5c'
  slovensko:
    initials: SK
    colour: '#0b4ea2'
    description:
      en: Open data about the whole of Slovakia, collected by the joinedcontext platform.
      sk: Otvorené údaje za celé Slovensko, ktoré zbiera platforma joinedcontext.

# The city's 43 datasets in the national catalogue, harvested nightly into `banskabystrica`
# (T-4151). The corrections are docs Research/banska-bystrica-open-data-sources.md §7 and §8:
# four titles link another dataset's file, which is ingested once under the title its columns
# match; the dog registry locates people; contracts, orders and subsidies keep only the rows that
# carry an IČO. HTML and PDF answers where JSON is declared are found by the fetch itself.
harvest:
  # Where the converted datasets' distributions point (T-4279): each dataset's od Endpoint on
  # the dev gateway, in every standard the platform serves.
  gateway: https://dev.joinedcontext.com
  sources:
    - name: banskabystrica
      sparql: https://data.slovensko.sk/api/sparql
      publisher: https://data.gov.sk/id/legal-subject/00313271
      publisherName: Mesto Banská Bystrica
      organization: banskabystrica
      namePrefix: bb-
      allowedHosts: [egov.banskabystrica.sk, dtm-banskabystrica.tmapserver.sk, www.banskabystrica.sk]
      # NKOD records the bare host, which 301s to www.
      rewriteHosts: {banskabystrica.sk: www.banskabystrica.sk}
      skip:
        Ulice: {state: mislinked, reason: 'not ingested, link points to Počet občanov podľa dňa narodenia (732 rows of Deň, Pohlavie, Počet)'}
        Počet občanov podľa mena: {state: mislinked, reason: 'not ingested, link points to Počet občanov podľa veku (105 rows of ages)'}
        Členovia orgánov samosprávy: {state: mislinked, reason: 'not ingested, link points to Evidencia psov (3 299 dog records)'}
        Počet občanov podľa ulíc BB: {state: mislinked, reason: 'not ingested, link points to Prírastky a úbytky občanov za jednotlivé roky (27 rows of years)'}
        Evidencia psov: {state: personal, reason: 'not ingested, street, house, flat and floor of each dog owner (Open data integration rules §1)'}
      requireColumn:
        Zmluvy BB: Zmluvné_strany_s_údajom_IČO
        Objednávky BB: IČO
        Dotácie: IČO_žiadateľa
    # The region's open data from its ArcGIS Hub into organization `bbsk` (T-4152, docs
    # Research/banska-bystrica-open-data-sources.md sections 6 to 8). The Hub's search API is the
    # list (103 datasets); its DCAT feeds are per layer and name the publisher `{{"{{"}}source{{"}}"}}`.
    - name: bbsk
      kind: hub
      hub: https://opendata.bbsk.sk
      allowedHosts: [opendata.bbsk.sk, services-eu1.arcgis.com, www.arcgis.com]
      organization: bbsk
      publisherName: Banskobystrický samosprávny kraj
      publisherUri: https://data.gov.sk/id/legal-subject/37828100
      publisherDescription: Otvorené údaje Banskobystrického samosprávneho kraja (IČO 37828100) z opendata.bbsk.sk, prevzaté a opravené.
      skip:
        # Names, e-mails and phones of personal-assistance providers, 277 of them people (section 8).
        b5486911cb0342e48d475130d1d5e960: personal data (section 8), a count per okres at most
      spelling:
        Bystrinská: Bystrianska
      # Each census title is published twice, once per okres (13 rows) and once per obec (516
      # rows), read from each layer's fields on 2026-10-15: two datasets, not a duplicate.
      titles:
        c0f097d92ceb4a90b006fdee8af6da1d: Obyvateľstvo podľa materinského jazyka (2011), obce
        59064392c3e248d39199c0376ba56d22: Obyvateľstvo podľa materinského jazyka (2011), okresy
        fc02ff58590647ed98f1df29d18e617f: Obyvateľstvo podľa materinského jazyka (2021), obce
        404a3d55408b439891269e5985056db9: Obyvateľstvo podľa materinského jazyka (2021), okresy
        81576bdd05ea48a6b660a217a61097c8: Obyvateľstvo podľa náboženského vyznania (2011), obce
        3844c8ed6ade4c2e96e547005c5f2178: Obyvateľstvo podľa náboženského vyznania (2011), okresy
        4d7df96609bd49deabf028eca4fdf301: Obyvateľstvo podľa náboženského vyznania (2021), okresy
        5fb2e96e5c57464183dab40a727a6db4: Obyvateľstvo podľa náboženského vyznania (2021), obce
        a36024d023cf47e9bf5759bc43f8e585: Obyvateľstvo podľa národnosti (2011), obce
        09f7d6aed66349f2b3a1bf53dc2eb771: Obyvateľstvo podľa národnosti (2011), okresy
        d559c2bdffab4e4dae7b1383913e42e8: Obyvateľstvo podľa národnosti (2021), okresy
        bf372d72bb444e40a8ecd7f15b8a9329: Obyvateľstvo podľa národnosti (2021), obce
        04e229d8b39b415497081c63a74c94f9: Obyvateľstvo podľa rodinného stavu (2021), okresy
        40138c783eaa46cd8cd3c8e09ab67127: Obyvateľstvo podľa rodinného stavu (2021), obce
        2819023d949e4f14be1fe0b72de157aa: Obyvateľstvo podľa vekovej štruktúry (2011, 2021), obce
        5e08d37332034f87be19ebc116ee9df5: Obyvateľstvo podľa vekovej štruktúry (2011, 2021), okresy
        54bc2cca50824f64ba0343873257cbe6: Obyvateľstvo podľa ďalšej národnosti (2021), okresy
        11667a5630ce459ca19479f5eb1413bd: Obyvateľstvo podľa ďalšej národnosti (2021), obce

# The publish gate's verdict of 2026-10-16T10:31Z (T-4318, owner 2026-10-16: "only leave data that is
# acurate and can be in ngsi-ld and for AI assitent to query"): each package and the first check
# it failed. Hidden, not deleted; regenerate from evidence/worker-1/T-4318/publish-gate.json of the
# next run (joinedcontext-conformance tests/assistant/publish_gate.py) and a package passes back in.
hidden:
  bb-adresy: "accurate: 16304 entities for 16902 source rows (-3.5%)"
  bb-aktuality: "accurate: 100 entities for 1558 source rows (-93.6%)"
  bb-dotacie: "smart-data-model: the mapping names no Smart Data Model (T-4319)"
