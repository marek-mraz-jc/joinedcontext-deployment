# The dataset map's basemap on dev (T-4639, T-4661): the tiles host's style (T-4638), which the
# page swaps for its own language (light-en.json, light-cs.json…); never OpenStreetMap's servers.
mapBasemap:
  style: https://tiles.{{ .Values.global.domain }}/styles/light-sk.json

# No Gemini card or guide on /assistants (owner 2026-10-19, T-4735): Google offers custom apps
# only to adults in the USA with a personal account, so the option is no use to our readers. Its
# sign-in through the gateway's OAuth works (tasks/evidence/T-4643/gemini-oauth.sh, 2026-10-18).
assistants:
  gemini: false
  # The hub's knowledge sources (T-4659): the gateway's JC_GATEWAY_HUB_KNOWLEDGE_SOURCES, each with
  # its seed KnowledgeSource's first start URL and languages (test_ckan_theme holds them equal).
  sources:
    - { publisher: banskabystrica, url: "https://www.banskabystrica.sk/", languages: [sk] }
    - { publisher: bbsk, url: "https://www.bbsk.sk/", languages: [sk] }
    - { publisher: zilina, url: "https://www.zilina.sk/", languages: [sk] }
    - { publisher: praha, url: "https://www.praha.eu/", languages: [cs] }
    - { publisher: helsinki, url: "https://www.hel.fi/", languages: [fi, sv, en] }
