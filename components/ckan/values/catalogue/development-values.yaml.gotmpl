---
# Checklist:
# - [x] Minimal Resources
# - [x] Minimal storage
# - [x] 1 Replica

ckan:
  replicaCount: 1
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: '2'
      memory: 2Gi

solr:
  storage:
    size: 5Gi
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: '1'
      memory: 1Gi

redis:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 200m
      memory: 128Mi

# The demo's publishers (owner, 2026-10-12: "Pridaj obrázky"): a plain badge with initials, no
# coat of arms, since the instance is a demo and not affiliated with any of them; the words
# stand where a publisher set none in CKAN.
organizations:
  hel-fi:
    initials: HEL
    colour: '#0000bf'
    description:
      en: Open data of the Helsinki region, live from HSL public transport, Fintraffic parking and the city's own services, through joinedcontext endpoints.
      sk: Otvorené údaje regiónu Helsinki, naživo z verejnej dopravy HSL, parkovísk Fintraffic a mestských služieb, cez endpointy joinedcontext.
  praha:
    initials: PHA
    colour: '#b4232a'
    description:
      en: Open data of the City of Prague, published through joinedcontext endpoints.
      sk: Otvorené údaje hlavného mesta Prahy, publikované cez endpointy joinedcontext.
  zilina:
    initials: ZA
    colour: '#1f6f43'
    description:
      en: Open data of the City of Žilina and the University of Žilina, published through joinedcontext endpoints.
      sk: Otvorené údaje mesta Žilina a Žilinskej univerzity, publikované cez endpointy joinedcontext.
  banskabystrica:
    initials: BB
    colour: '#00579c'
  bbsk:
    initials: BBSK
    colour: '#7a1f5c'
