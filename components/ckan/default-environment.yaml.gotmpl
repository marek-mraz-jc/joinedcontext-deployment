---
ckan:
  catalogue:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "ckan") }}
    # The catalogue is published on its own host, because CKAN builds every link it renders
    # from one site URL and a path prefix would need CKAN's own root_path as well.
    # opendata since T-4679 (owner 2026-10-18); data.{domain} answers 301 (apisix-routes.yaml).
    subDomain: opendata
    # The publicId of a `ckan` or `public` AssistantDeployment whose widget every catalogue page offers
    # (AG-114, T-3058); empty, or without the assistant component, the pages offer none.
    assistant: ""
    # The catalogue's own languages (T-4280), `{default, offered}` as in `global.branding.languages`,
    # which they replace for the catalogue alone; empty takes the branding block's.
    languages: {}
    # The instance's own words (T-4636), read by the theme and by its assistant's seed:
    # `title` per language (the page header, the home page, the browser tab), `tagline` per
    # language (the line under the home page's title; empty: the theme's), `logo` a file in the
    # theme's public directory (empty: the joinedcontext.com lockup), `issued` the day the
    # catalogue went public, its DCAT `dct:issued` (`YYYY-MM-DD`; empty: none, T-4733).
    site:
      title: {}
      tagline: {}
      logo: ""
      issued: ""
    # The MCP connector page's "Try it" questions per language, about this instance's publishers.
    samples: {}
