---
portal:
  portal:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "portal") }}
    # Where an App's Deployment, Service, Secret and NetworkPolicy are applied (AP-15, AP-18).
    # The Portal's own namespace by default: it is the one namespace the Portal is granted
    # anything in, and an installation that wants apps apart from the platform sets this and
    # creates that namespace itself.
    appsNamespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "portal") }}
    # The Secret holding the age identity the reconciler decrypts a Pipeline's `secretRef`
    # with (CC-06, ADR-N-012), mounted read-only at /etc/jc/age/keys.txt. Empty means this
    # installation has no secret backend and refuses every reference, with the reason. The
    # identity is operator-supplied: generated once, kept out of Git, and its public recipient
    # is what encrypts the `*.enc.yaml` files of the configuration repository. See the
    # component README.
    sopsAgeSecret: ''
    # A GitHub copy of every generated application's repository (AP-79, T-2475): the forge keeps
    # it current with a push mirror. An empty owner means no copy. The token is operator-supplied,
    # never generated: a Secret of this name with key `token` in the Portal's namespace, declared in
    # the environment's managedSecrets as a ref+sops value (components/secrets/README.md section 2).
    # It needs to create repositories under the owner and push to them, and nothing else.
    appMirror:
      githubOwner: ''
      secret: github-app-mirror
  # Each project's own namespace for its pod-backed Apps, `{instanceSlug}-{project}-apps`
  # (AP-116): the cluster-wide rights the Portal creates them with and the admission policy that
  # keeps those rights to such namespaces (AP-117). Off means no pod-backed App runs: the Portal
  # gets no release name and says so on every App that needs a pod.
  namespaces:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "portal") }}
