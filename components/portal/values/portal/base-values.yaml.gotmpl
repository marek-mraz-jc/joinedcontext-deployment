---
{{- $global := .Values.global }}
{{- $thisPortal := index .Values "portal" "portal" }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> /api/v1/health
# - [x] Graceful shutdown
# - [x] Standard labels
# - [x] ServiceAccount with least privilege where required
# - [x] Named ports -> 8080 container mapped to 8080 service
# - [ ] Ingress with TLS -> not applicable, portal is fronted by APISIX

fullnameOverride: portal

# The Portal's pods by address: the gateway admits the Portal's tokenless MQTT capture subscriber
# only from what this name resolves to (JC_GATEWAY_MQTT_PORTAL_HOST, ADR-N-048 §2.10, T-4880).
headlessService:
  name: portal-pods

# The reconciler applies an App's four objects, so this pod needs an identity at the API server
# and a Role that grants those four kinds in one namespace and nothing else (AP-13, T-0411).
# Without the token the client finds no ServiceAccount mount and deploys nothing, which is the
# same fail-closed path as running outside a cluster.
serviceAccount:
  create: true
  automountServiceAccountToken: true

rbac:
  namespace: {{ $thisPortal.appsNamespace | quote }}
  rules:
    # The release namespace holds the platform's own workloads; Apps go to `{release}-{project}-apps`
    # under `{release}-portal-apps` (AP-116). Here the Portal only rolls the pipeline runner when its
    # Secret changes (reconciler/daemon.rs), a server-side apply patch of that one Deployment (T-5094).
    - apiGroups: ["apps"]
      resources: ["deployments"]
      resourceNames: ["pipeline-runner"]
      verbs: ["get", "patch"]
    # Secrets (T-2479, T-4798). This namespace holds the platform's credentials (database,
    # Keycloak, forge), whose names are in the charts, so the Portal reads one Secret here by
    # name: the pull Secret it copies into each apps namespace. It applies (patch, create for a
    # new one) the Secrets it hands over, `pipeline-secrets` and `artifact-store-reader-{org}`,
    # and deletes none. RBAC cannot name a prefix: the admission policy
    # `{release}-portal-secrets` (charts/namespaces) bounds what it may write to those names.
    {{- if has "gitea" .Values.components }}
    - apiGroups: [""]
      resources: ["secrets"]
      resourceNames: ["app-registry"]
      verbs: ["get"]
    {{- end }}
    - apiGroups: [""]
      resources: ["secrets"]
      verbs: ["create", "patch"]
nameOverride: portal-portal

{{- $branding := $global.branding | default dict }}
{{- /* Empty unless the installation supplied an age identity: an environment file older than
       the setting renders without a secret backend instead of failing to render. */}}
{{- $ageSecret := dig "sopsAgeSecret" "" $thisPortal }}
{{- /* The GitHub copy of application repositories (AP-79); off without an owner, and off
       without a forge, which is what it copies. */}}
{{- $appMirror := dig "appMirror" dict $thisPortal }}
{{- $mirrorOwner := and (has "gitea" .Values.components) (dig "githubOwner" "" $appMirror) }}
{{- $images := index .Values.images "portal" "portal" }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

containerPort: 8080

service:
  enabled: true
  type: ClusterIP
  port: 8080
  targetPort: 8080
  name: http
{{- if has "agent-runner" .Values.components }}
  # The internal listener (AG-52): the proxy resolves a run's ticket and posts its events
  # here. Not routed by the edge; the NetworkPolicy opens it to the proxy alone.
  extraPorts:
    - name: internal
      port: 9090
      targetPort: 9090
      protocol: TCP
{{- end }}

probes:
  # Readiness waits for the mirror (OPS-51): 503 until this replica's first sync. Liveness
  # stays on the unconditional health route, so a slow first sync never restarts the pod.
  readiness:
    path: /api/v1/ready
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /api/v1/health
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 10

# The Keycloak client secret is generated by the secrets component and the matching
# Keycloak confidential client is created by realm configuration (T-0031).
envSecret:
  PGPASSWORD:
    secret: db-portal
    key: password
  # The relay App mail goes out through (T-3583, AP-168): an operator-supplied SOPS reference in
  # the environment's managedSecrets, the relay's smtps URL with its login. Absent, the Portal
  # sends no mail and its email route answers 503. The in-cluster catcher takes its place below.
{{- if not (index .Values.portal "mail-catcher" "enabled") }}
  JC_PORTAL_SMTP_URL:
    secret: portal-mail-relay
    key: url
    optional: true
{{- end }}
  JC_PORTAL_COOKIE_KEY:
    secret: portal-cookie-key
    key: key
  # The key a rotation retired, still opening the cookies it sealed until
  # `rotate-secret.sh --drop-previous` removes it (OPS-45, T-2842). Absent outside a rotation.
  JC_PORTAL_COOKIE_KEY_PREVIOUS:
    secret: portal-cookie-key
    key: previous
    optional: true
  # The key the Portal hashes a data subject with for erasure requests and their log (DM-124,
  # T-5697): its own secret, so rotating the artifact store credential keeps every logged hash
  # matching. An operator-supplied SOPS reference in the environment's managedSecrets; absent, the
  # Portal hashes with the artifact store's key, as every hash made before this key existed; an
  # erasure proposed before the key is first set is proposed again after.
  JC_PORTAL_ERASURE_KEY:
    secret: portal-erasure-key
    key: key
    optional: true
{{- if has "gitea" .Values.components }}
  # Minted by the forge's bootstrap Job, not generated: a token the forge accepts is one the
  # forge issued (T-0399).
  JC_GITEA_TOKEN:
    secret: gitea-token-portal
    key: token
{{- if .Values.gitea.forge.appsOrganization }}
  # The applications' own machine user (PF-106): their repositories, packages and builds.
  JC_GITEA_APPS_TOKEN:
    secret: gitea-token-apps
    key: token
{{- end }}
{{- end }}
{{- if $mirrorOwner }}
  # Operator-supplied (AP-79): it creates the GitHub repositories and is the forge's push
  # credential for them, handed over once when a mirror is set up.
  JC_APP_MIRROR_GITHUB_TOKEN:
    secret: {{ dig "secret" "github-app-mirror" $appMirror | quote }}
    key: token
{{- end }}
{{- if has "agent-runner" .Values.components }}
{{- end }}
{{- if has "ckan" .Values.components }}
  # The reconciler publishes every Endpoint's `publish.ckan` block with it (EP-62, EP-67): the
  # variable a CkanInstance's `apiTokenRef.envVar` names. Minted by the catalogue's own Job, which
  # is why the catalogue is deployed before the Portal (T-2469).
  CKAN_API_TOKEN:
    secret: ckan-api-token
    key: token
{{- end }}
{{- if has "artifact-store" .Values.components }}
  # The store's root credential (T-0422, PF-32). The reconciler is the only holder: it derives
  # a scoped writer and reader per organization from it and hands those out, so no other
  # workload ever carries a key that can read another organization's artifacts.
  JC_PORTAL_ARTIFACT_STORE_ACCESS_KEY:
    secret: artifact-store-root
    key: ACCESS_KEY_ID
  JC_PORTAL_ARTIFACT_STORE_SECRET_KEY:
    secret: artifact-store-root
    key: ACCESS_SECRET_KEY
{{- end }}
{{- if has "wasm-host" .Values.components }}
  # The `wasm` Apps' database login (AP-149): the Portal makes every App's schema and roles.
  APPS_DB_PASSWORD:
    secret: db-apps-admin
    key: password
{{- end }}

# Kubernetes expands $(VAR) references in container env definitions when the referenced variable appears earlier in the list.
env:
  JC_PORTAL_BIND: "0.0.0.0:8080"
  {{- if dig "portal" "ui" "enabled" false .Values }}
  # Every page and asset is read from the `portal-ui` bundle (T-2485, T-5297); GET /api/v1/version
  # says whether it was built against this binary's API.
  JC_PORTAL_UI_URL: "http://portal-ui:8080"
  {{- end }}
  # How often the reconciler runs without a push (whole seconds). A merge still syncs at once
  # through the forge's webhook. Each run republishes the open-data catalogue through the
  # public edge, so a short period on a large catalogue is a bot of our own (T-4717).
  JC_PORTAL_SYNC_INTERVAL: {{ $thisPortal | get "syncInterval" 60 | quote }}
  # The Portal lives on its own host behind the edge login (ADR-N-019); the apex redirects
  # here. The forge's public URL below stays on the apex, where /git/* is served.
  JC_PORTAL_PUBLIC_URL: "https://portal.{{ $global.domain }}"
  # Apps are served on the apex (AP-26), never on the Portal host: there an app's
  # `connect-src 'self'` would be the Portal API and the session cookie would ride along. With
  # this set the Portal answers /apps/* on its own host with a 308 to the apex (T-2476).
  JC_PORTAL_APPS_URL: "https://{{ $global.domain }}"
  # The builds `status.build` names, fetched from the forge's package registry and unpacked
  # under their digest (AP-102). The image's own /srv/apps is read-only and keeps the bundles it
  # ships; this is the pod's one writable app directory, and a restart fetches again.
  JC_PORTAL_APPS_CACHE_DIR: /var/cache/jc/apps
  # APISIX logs the person in and hands the Portal the user's access token as X-Access-Token,
  # after clearing the header from every client request; with this set the Portal accepts it
  # as it accepts `Authorization: Bearer`. Only a deployment with the edge in front sets it
  # (ADR-N-019 §3.4, AP-28).
  JC_TRUST_EDGE_TOKEN: "true"
  JC_OIDC_ISSUER: "https://idm.{{ $global.domain }}/realms/{{ $global.instanceSlug }}"
{{- if eq .Values.keycloak.app.pathPrefix "/" }}
  # Tokens and admin calls go to the Keycloak Service, not through the public edge and its
  # per-address limit (T-4432, T-4450); tokens are still checked against the public issuer.
  # An origin only, so it holds while Keycloak serves the realm at the issuer's own path.
  JC_KEYCLOAK_ADMIN_URL: "http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local:80"
{{- end }}
  JC_OIDC_CLIENT_ID: "portal-api"
  # `portal-api` is federated (PF-47, T-2868): the Portal sends this pod's projected token,
  # read on every token request, and holds no client secret.
  JC_OIDC_CLIENT_ASSERTION_FILE: /var/run/secrets/jc/keycloak/token
  # The sender of App mail; the App's title is the name beside it (T-3583, AP-168).
  JC_PORTAL_MAIL_FROM: "noreply@{{ $global.domain }}"
{{- if index .Values.portal "mail-catcher" "enabled" }}
  # The in-cluster catcher, in the clear inside the namespace: no credential, so no Secret.
  JC_PORTAL_SMTP_URL: "smtp://mail-catcher.{{ index .Values.portal "mail-catcher" "namespace" }}.svc.cluster.local:1025"
{{- end }}
  JC_PORTAL_KEYCLOAK_ADMIN_CLIENT_ID: "portal-reconciler"
  # The reconciler's own client (PF-63): it writes the realm's platform-owned groups and nothing
  # else. Federated (PF-47, T-2868): its proof is a token of this ServiceAccount, which the Portal
  # mints per request; the namespaces part makes the account and lets this pod mint for it.
  JC_PORTAL_KEYCLOAK_ADMIN_CLIENT_SERVICE_ACCOUNT: "portal-reconciler"
  JC_PORTAL_DATABASE_URL: "postgresql://portal:$(PGPASSWORD)@postgres-cluster-rw.{{ .Values.postgres.cluster.namespace }}.svc.cluster.local:5432/portal"
{{- if has "gitea" .Values.components }}
  # The configuration repository (CC-02, CC-08). All four go together or none does: the client
  # refuses a partial set at start-up rather than running with a forge it half knows about.
  # In-cluster, because under a self-signed cluster issuer the public host is served with the
  # cluster CA and this client does not carry JC_OIDC_CA_FILE's exemption.
  JC_GITEA_URL: "http://gitea-http.{{ .Values.gitea.forge.namespace }}.svc.cluster.local:3000"
  JC_GITEA_OWNER: {{ $global.configRepo.owner | quote }}
  JC_GITEA_REPO: {{ $global.configRepo.name | quote }}
  # The gateway's forge user (PF-106), made a reader of every project repository the Portal
  # opens in layout 2; the bootstrap Job mints the gateway's token on it.
  JC_GITEA_READER: "jc-gateway"
{{- if .Values.gitea.forge.appsOrganization }}
  # The generated applications' own organization (PF-106), with JC_GITEA_APPS_TOKEN above.
  JC_GITEA_APPS_OWNER: {{ .Values.gitea.forge.appsOrganization | quote }}
{{- end }}
  # Where a browser reaches the forge: the "Source" link of a manifest opens here, and a
  # browser resolves no .svc.cluster.local name. Same prefix as the forge's ROOT_URL.
  JC_GITEA_PUBLIC_URL: "https://{{ $global.domain }}{{ .Values.gitea.forge.pathPrefix | trimSuffix "/" }}"
{{- end }}
{{- if has "ckan" .Values.components }}
  # The catalogue's own public URL, which every CkanInstance of this deployment names, and its
  # Service, which the reconciler publishes through instead (T-5314): through the edge every
  # publication spent the visitors' per-address limit (184 organization lookups in two minutes
  # on prod). Linkerd carries the token between the two pods.
  JC_PORTAL_CKAN_URL: "https://{{ .Values.ckan.catalogue.subDomain }}.{{ $global.domain }}"
  JC_PORTAL_CKAN_API_URL: "http://ckan.{{ .Values.ckan.catalogue.namespace }}.svc.cluster.local:5000"
{{- end }}
{{- if $mirrorOwner }}
  # The GitHub organization or user every application repository is copied to (AP-79).
  JC_APP_MIRROR_GITHUB_OWNER: {{ $mirrorOwner | quote }}
{{- end }}
  # What this installation is called and what it looks like (UI-30, OPS-46). The file below
  # comes from the ConfigMap; a missing or unreadable one is neutral defaults, never a crash,
  # so the Portal starts on an environment that configured no branding at all.
  JC_BRANDING_FILE: /etc/jc/branding/branding.yaml
  # The operator's bounds on an Organization's limits (PF-97), from the same ConfigMap.
  JC_PORTAL_ORGANIZATION_BOUNDS_FILE: /etc/jc/branding/organization-bounds.yaml
  # The price table of Administration → Costs (T-5126), from the same ConfigMap.
  JC_PORTAL_COST_PRICES_FILE: /etc/jc/branding/cost-prices.yaml
  # The validation checks' last results, one digest per check, which
  # scripts/publish-health.py writes into the ConfigMap jc-validation-results (OPS-53).
  JC_HEALTH_DIR: /etc/jc/health
  # What this deployment provides, for Organization → Setup (T-2748, API/01 §25): the Portal
  # cannot see Keycloak's theme or SMTP server or the database's backups, so the deployment
  # says it here from the same values that configure them. Absent reads as not done.
{{- if has "keycloak" .Values.components }}
  JC_SETUP_LOGIN_THEME: "joinedcontext"
{{- $smtp := dig "keycloak" "config" "smtp" dict .Values }}
  JC_SETUP_SMTP: {{ dig "enabled" false $smtp | toString | quote }}
{{- end }}
  JC_SETUP_BACKUPS: {{ dig "postgres" "cluster" "backups" "enabled" false .Values | toString | quote }}
  # What an App compiles into and where it is applied (AP-13, AP-15, AP-18, T-0411). Both go
  # together: without them the reconciler reads apps and deploys nothing, which is what a
  # Portal outside a cluster does. The host and the realm are not variables of their own; the
  # Portal reads them off its public URL and its OIDC issuer.
  JC_PORTAL_APPS_NAMESPACE: {{ $thisPortal.appsNamespace | quote }}
  JC_PORTAL_ORG_DOMAIN: {{ $global.orgDomain | quote }}
{{- if .Values.portal.namespaces.enabled }}
  # A project's pod-backed Apps run in {release}-{project}-apps, which the Portal creates and
  # binds itself in as this ServiceAccount (AP-116); the namespaces part grants that and fences
  # it (AP-117). Without the release name no pod-backed App runs.
  JC_PORTAL_RELEASE: {{ $global.instanceSlug | quote }}
  JC_PORTAL_SERVICE_ACCOUNT: "portal"
  # Where an App pod asks JC_ME_URL for its caller's roles: this Portal's public listener on
  # its Service in the cluster, which the App's NetworkPolicy admits and the public host is
  # not (AP-109, AP-134, T-3037). Without it the Portal renders no pod-backed App.
  JC_PORTAL_SERVICE_URL: "http://portal.{{ $thisPortal.namespace }}.svc.cluster.local:8080"
{{- if has "gitea-runner" .Values.components }}
  # A run tests each version in {release}-app-tests on the lane's own builder image before it
  # offers publication (SDK-38); the namespaces part creates that namespace and the Portal's Role.
{{- $builder := index .Values.images "gitea-runner" "runner" }}
  JC_PORTAL_APP_TESTS_NAMESPACE: {{ printf "%s-app-tests" $global.instanceSlug | quote }}
  JC_PORTAL_APP_TESTS_IMAGE: {{ printf "%s:%s@%s" $builder.repository $builder.tag $builder.digest | quote }}
  # A `wasm` App's version also runs its server's `cargo test`, on the rust runner (T-3618).
{{- $rust := index .Values.images "gitea-runner" "rust" }}
  JC_PORTAL_APP_TESTS_RUST_IMAGE: {{ printf "%s:%s@%s" $rust.repository $rust.tag $rust.digest | quote }}
{{- end }}
{{- end }}
{{- if and (has "gitea-runner" .Values.components) (index .Values "gitea-runner" "build-pods" "enabled") }}
  # An App's `build` job runs in a pod of that App alone, which this Portal starts in the
  # runner's namespace on the runner images, each with the App's own cache claim (AP-130,
  # AP-131); the Role there is components/gitea-runner's build-pods part.
  {{- $runners := index .Values.images "gitea-runner" }}
  JC_PORTAL_BUILD_NAMESPACE: {{ index .Values "gitea-runner" "build-pods" "namespace" | quote }}
  JC_PORTAL_BUILD_IMAGE_NODE: "{{ $runners.runner.repository }}@{{ required "gitea-runner.runner needs its image digest" $runners.runner.digest }}"
  JC_PORTAL_BUILD_IMAGE_RUST: "{{ $runners.rust.repository }}@{{ required "gitea-runner.rust needs its image digest" $runners.rust.digest }}"
{{- end }}
{{- if has "apisix" .Values.components }}
  # The only namespace whose APISIX pods an App pod admits (AP-108).
  JC_PORTAL_APISIX_NAMESPACE: {{ .Values.apisix.apisix.namespace | quote }}
{{- end }}
{{- if has "gitea" .Values.components }}
  # A fullstack App's image is {registry}/{JC_GITEA_APPS_OWNER or JC_GITEA_OWNER}/app-{name}@{digest} (AP-108): the
  # node pulls it from https://{domain}/v2/, which the edge routes to the forge, with the
  # read:package Secret the gitea bootstrap Job writes into the apps namespace.
  JC_PORTAL_APPS_REGISTRY: {{ $global.domain | quote }}
  JC_PORTAL_APPS_PULL_SECRET_NAME: "app-registry"
{{- end }}
  # The client an invitation's link returns through (PF-108, T-3237): `portal-ui`'s redirect URIs
  # already cover every Portal page (components/portal/keycloak-clients.yaml), so the invitee
  # lands on the project's home page once their password is set and no redirect rule widens.
  JC_PORTAL_INVITATION_CLIENT_ID: "portal-ui"
{{- if has "model-tools" .Values.components }}
  # The generator behind the LinkML editor (DM-18, DM-19): the live preview, the Smart Data
  # Models import and the draft from a sample file all go here; without it those three
  # answer 503 and the editor still edits.
  JC_PORTAL_MODEL_TOOLS_URL: "http://model-tools.{{ index .Values "model-tools" "tools" "namespace" }}.svc.cluster.local:8080"
{{- end }}
{{- if has "functions" .Values.components }}
  # The runtime of generated applications' functions (SDK-23): the Portal calls it with its own
  # client-credentials token (audience jc-functions); without it the function route answers 503.
  JC_FUNCTIONS_URL: "http://jc-functions.{{ .Values.functions.runtime.namespace }}.svc.cluster.local:8080"
{{- end }}
{{- if has "assistant" .Values.components }}
  # The knowledge assistant's administration paths (API/01 §34, T-3057), asked with the Portal's
  # own token (audience jc-assistant); without it the knowledge routes answer 503.
  JC_PORTAL_KNOWLEDGE_URL: "http://jc-assistant.{{ .Values.assistant.worker.namespace }}.svc.cluster.local:8080"
{{- end }}
{{- if has "context-gateway" .Values.components }}
  # The space surface a declared Subscription is written through (T-0931, CC-72): the reconciler
  # posts to `{this}/cs/{space}/ngsi-ld/v1/subscriptions` with its own client-credentials token,
  # so the space's policy decides the write and the gateway injects the tenant. Without it a
  # Subscription manifest is read, served and written into no broker.
  JC_PORTAL_GATEWAY_URL: "http://context-gateway.{{ index .Values "context-gateway" "gateway" "namespace" }}.svc.cluster.local:8080"
  # Every gateway pod by address (the headless Service): a space move waits until each one's
  # /metrics shows the hold before it copies (F-POR4-014).
  JC_PORTAL_GATEWAY_PODS_URL: "http://context-gateway-pods.{{ index .Values "context-gateway" "gateway" "namespace" }}.svc.cluster.local:8080"
  # Whose token the internal listener answers on `/internal/previews` (T-1500, PF-46, AG-52): the
  # gateway's own Keycloak client, whose tokens an audience mapper binds to `portal-internal`.
  # Unset, that route refuses every call — a Portal without a gateway must not fall back to
  # trusting the NetworkPolicy on port 9090 alone.
  JC_PORTAL_GATEWAY_CLIENT_ID: "context-gateway"
{{- end }}
{{- if has "context-broker" .Values.components }}
  # Where a declared ContextSourceRegistration is written (T-0345, PF-48): the reconciler posts
  # it to `{this}/ngsi-ld/v1/csourceRegistrations` with the hub space as NGSILD-Tenant, on the
  # internal hop and no other (SP-08). It is also the address the registration tells the broker
  # to read a member at, because a hub reads a member's tenant on this same broker. Without it
  # a ContextSourceRegistration manifest is read, served and federated nowhere.
  JC_PORTAL_BROKER_URL: "http://context-broker.{{ (index .Values "context-broker" "broker" "namespace") }}.svc.cluster.local:8080"
  # Every ContextBroker beside `main`, `{broker}` its name (ADR-N-046 §2.3, T-3989): the release
  # components/context-broker adds per entry of global.contextBrokers. The variable above stays
  # the implicit `main`, whose Service keeps its old name.
  JC_PORTAL_BROKER_URL_TEMPLATE: "http://context-broker-{broker}.{{ (index .Values "context-broker" "broker" "namespace") }}.svc.cluster.local:8080"
  # The broker's `/q` admin credential the view writer sends (T-3640, T-3642), from the Secret
  # components/context-broker/secrets.yaml generates for both namespaces.
  JC_PORTAL_BROKER_ADMIN_TOKEN_FILE: /var/run/secrets/jc/broker-admin/token
{{- end }}
{{- if has "pipeline-runner" .Values.components }}
  # The pipeline test (PL-43): a candidate pipeline runs once as an ephemeral stream on the
  # project's runner, and the runner posts what it produced back to the Portal's internal
  # listener; without the pair the studio's "Test mapping" answers 503.
  JC_PORTAL_PIPELINE_RUNNER_URL: "http://pipeline-runner.{{ index .Values "pipeline-runner" "runner" "namespace" }}.svc.cluster.local:4195"
  JC_PORTAL_PIPELINE_TEST_CAPTURE_URL: "http://portal.{{ $thisPortal.namespace }}.svc.cluster.local:9090"
  # Whose identity a stream presents (PL-19, T-1508): `project` keeps every stream on its
  # project's `pipelines` client; `pipeline` sends each to the token service as its own
  # pipeline, so no stream names a secret the runner's API could serve back (T-4044). Switched by
  # pipeline-runner.identities.streams, with the token service and the accounts on.
  {{- $pipelineRunner := index .Values "pipeline-runner" }}
  JC_PORTAL_PIPELINE_IDENTITY: {{ if and $pipelineRunner.tokens.enabled $pipelineRunner.identities.enabled $pipelineRunner.identities.streams }}"pipeline"{{ else }}"project"{{ end }}
  {{- if (index .Values "pipeline-runner" "identities" "enabled") }}
  # Where the reconciler keeps each Pipeline's own Kubernetes ServiceAccount and whose subjects
  # their federated clients trust (PL-19, T-1508); the identities part grants it that namespace.
  JC_PORTAL_PIPELINE_NAMESPACE: {{ index .Values "pipeline-runner" "identities" "pipelineNamespace" | quote }}
  {{- end }}
  # And whose token that capture answers (T-2271, AG-52): the project's own runner client, whose
  # tokens an audience mapper binds to `portal-internal`. The test's id is 130 random bits and a
  # capability of its own; this names the caller as well, so a call with no identity is a 401 and
  # not a 404 that only says "no such test".
  # The runner's own client, which `components/pipeline-runner/keycloak-clients.yaml` names
  # `{project}-pipelines` from that component's own `project`.
  JC_PORTAL_PIPELINE_RUNNER_CLIENT_ID: "{{ required "pipeline-runner.runner.project names the project whose streams this runner carries; only the development profile falls back to the demo city (T-1720, CC-73)" (index .Values "pipeline-runner" "runner").project }}-pipelines"
{{- end }}
  # The basemap under generated maps (AP-67): the Portal fetches, caches and serves the tiles,
  # so a sandboxed preview never talks to the tile host. OpenStreetMap's tile policy asks for a
  # cache and an identifying User-Agent, and the route keeps both; the egress rule below is 443.
  JC_BASEMAP_URL: "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
  JC_BASEMAP_ATTRIBUTION: "© OpenStreetMap contributors"
{{- if has "artifact-store" .Values.components }}
  # Where the artifact store answers and which bucket it keeps (PF-29, Architecture/17 §4).
  # With the root credential below, the reconciler mints one writer and one reader per
  # Organization on every sync; without either half it issues nothing and touches no store.
  JC_PORTAL_ARTIFACT_STORE_ENDPOINT: "http://artifact-store.{{ index .Values "artifact-store" "store" "namespace" }}.svc.cluster.local:9000"
  JC_PORTAL_ARTIFACT_STORE_BUCKET: {{ index .Values "artifact-store" "store" "bucket" | default "jc-artifacts" | quote }}
{{- end }}
{{- if has "wasm-host" .Values.components }}
  # Server WASM Apps (ADR-N-044): their database, the shards the Portal places them on, the
  # bucket of their components and files, and the namespace where it writes each shard's
  # placement and store key (AP-149, AP-157, AP-158).
  JC_PORTAL_APPS_DB_URL: "postgresql://jc_apps_admin:$(APPS_DB_PASSWORD)@apps-db-rw.{{ index .Values "apps-db" "cluster" "namespace" }}.svc.cluster.local:5432/apps?sslmode=require"
  JC_PORTAL_WASM_SHARDS: {{ index .Values "apps-db" "cluster" "shards" | default 2 | quote }}
  JC_PORTAL_APPS_BUCKET: {{ index .Values "wasm-host" "bucket" | default "apps" | quote }}
  JC_PORTAL_WASM_HOST_NAMESPACE: {{ index .Values "wasm-host" "shard-0" "namespace" | quote }}
  {{- if (index .Values "wasm-host" "identities" "enabled") }}
  # Where the reconciler keeps each wasm App's job ServiceAccount, whose subject the App's job
  # client trusts (AP-159, T-3372); the identities part grants it that namespace.
  JC_PORTAL_APP_IDENTITY_NAMESPACE: {{ index .Values "wasm-host" "identities" "appNamespace" | quote }}
  {{- end }}
{{- end }}
{{- if has "context-gateway" .Values.components }}
  # Where the reconciler writes each space's personal-data key as the Secret the gateway mounts,
  # with the Role context-gateway's portal-access part grants it there (DM-121).
  JC_PORTAL_GATEWAY_NAMESPACE: {{ index .Values "context-gateway" "gateway" "namespace" | quote }}
{{- end }}
{{- if has "mqtt-brokers" .Values.components }}
  # Where the reconciler stamps one release per MqttBroker from the chart's template, with the
  # Role mqtt-brokers grants it there (ADR-N-048, T-3994).
  JC_PORTAL_MQTT_NAMESPACE: {{ index .Values "mqtt-brokers" "brokers" "namespace" | quote }}
{{- end }}
{{- if has "agent-runner" .Values.components }}
  # The agent runner (AG-33, AG-40): the two go together or the Portal refuses to start.
  # A `static` run is built by the Portal itself and schedules nothing in the namespace; the
  # workspace runs of T-0540 will.
  JC_AGENTS_NAMESPACE: {{ $thisPortal.appsNamespace | quote }}
  JC_AGENT_PROXY_BASE: "http://agent-proxy.{{ index .Values "agent-runner" "proxy" "namespace" }}.svc.cluster.local:8080"
  # Whose token the run callbacks answer (T-2271, AG-52): the credential proxy's own Keycloak
  # client, whose tokens the `portal-internal-audience` mapper binds to this listener. It replaced
  # `JC_AGENT_PROXY_TOKEN`, one string both sides held; unset, those routes refuse every call.
  JC_PORTAL_AGENT_PROXY_CLIENT_ID: "{{ (index .Values "agent-runner" "proxy").project }}-agent-proxy"
  # A workspace's NetworkPolicy admits the Portal's own pod, in this namespace and no other
  # (AG-39): without it the rule would name the label alone, and a pod's labels are written by
  # whoever owns the namespace it sits in.
  JC_PORTAL_NAMESPACE: {{ $thisPortal.namespace | quote }}
{{- end }}
{{- if eq ($global.ingress.clusterIssuer | default "") "selfsigned-ca" }}
  # OIDC discovery goes to the PUBLIC issuer, because the `iss` claim carries the public host.
  # Under a self-signed cluster issuer that host is served with the cluster CA, and the portal
  # binary trusts the Mozilla bundle alone, so discovery fails at the handshake and the pod
  # exits. The prepare component already copies the CA into every platform namespace as Secret
  # `custom-ca-cert`; this hands that one root to the discovery client and nothing else.
  JC_OIDC_CA_FILE: /etc/jc/ca/ca.crt
{{- end }}
{{- if $ageSecret }}
  # The one secret backend of this installation (CC-06, OPS-37, ADR-N-012): the reconciler
  # decrypts the `*.enc.yaml` files of the configuration repository it staged, with the age
  # identity mounted below. A Pipeline's `secretRef` resolves from those files and from nowhere
  # else; without this setting every reference is refused with "no secret backend is
  # configured", which is correct and useless. OpenBao is the other backend and the
  # multi-tenant answer; an installation configures one, never both.
  JC_PORTAL_SOPS_AGE_KEY_FILE: /etc/jc/age/keys.txt
{{- end }}

{{- $clusterCa := eq ($global.ingress.clusterIssuer | default "") "selfsigned-ca" }}
extraVolumes:
  # One build per application: the Portal removes an app's older build once the new one is in
  # place. Past the limit the kubelet evicts the pod, so it is sized for the whole catalog
  # (a bundle unpacks to 256 MiB at most, most to a few MiB).
  - name: apps-cache
    emptyDir:
      sizeLimit: 2Gi
  # Written by scripts/publish-health.py after each check, never by this release: optional, so a
  # Portal starts before anything is published, and the kubelet fills it in when it is (OPS-53).
  - name: validation-results
    configMap:
      name: jc-validation-results
      optional: true
  # The token `portal-api` proves itself with (PF-47, T-2868): bound to the realm as its
  # audience, so it opens nothing else, and ten minutes long; the kubelet renews it in place.
  - name: keycloak-token
    projected:
      sources:
        - serviceAccountToken:
            audience: "https://idm.{{ $global.domain }}/realms/{{ $global.instanceSlug }}"
            expirationSeconds: 600
            path: token
{{- if $clusterCa }}
  - name: cluster-ca
    secret:
      secretName: custom-ca-cert
{{- end }}
{{- if has "context-broker" .Values.components }}
  - name: broker-admin-token
    secret:
      secretName: context-broker-admin-token
      defaultMode: 0440
      items:
        - key: token
          path: token
{{- end }}
{{- if $ageSecret }}
  # Operator-supplied: the identity is generated once, kept out of Git and handed to this
  # namespace alone. 0440 with the pod's fsGroup, so the Portal reads it and no other user in
  # the pod can; the file is read per resolution, never held.
  - name: age-identity
    secret:
      secretName: {{ $ageSecret | quote }}
      defaultMode: 0440
      # An installation that names the Secret and has not created it yet gets a Portal that
      # runs and refuses every reference with a reason, not a pod stuck in ContainerCreating.
      optional: true
{{- end }}
extraVolumeMounts:
  - name: apps-cache
    mountPath: /var/cache/jc/apps
  - name: keycloak-token
    mountPath: /var/run/secrets/jc/keycloak
    readOnly: true
  - name: validation-results
    mountPath: /etc/jc/health
    readOnly: true
{{- if $clusterCa }}
  - name: cluster-ca
    mountPath: /etc/jc/ca
    readOnly: true
{{- end }}
{{- if has "context-broker" .Values.components }}
  - name: broker-admin-token
    mountPath: /var/run/secrets/jc/broker-admin
    readOnly: true
{{- end }}
{{- if $ageSecret }}
  - name: age-identity
    mountPath: /etc/jc/age
    readOnly: true
{{- end }}

# One image serves every installation: the identity is mounted, not built in. The chart's
# checksum annotation restarts the pod when this changes, so a rebrand is a values edit and
# an apply (OPS-46). `logoSvg` is dropped from the served block and written as the file the
# block names, because the API serves the logo from beside the branding file.
configMap:
  enabled: true
  name: portal-branding
  mountPath: /etc/jc/branding
  data:
    branding.yaml: |
{{ omit $branding "logoSvg" | toYaml | indent 6 }}
    # The operator's bounds (PF-97): the Portal's own configuration beside its branding, so a
    # bound changed in the values restarts the Portal through the same checksum.
    organization-bounds.yaml: |
{{ dig "organizationBounds" dict $thisPortal | toYaml | indent 6 }}
    cost-prices.yaml: |
{{ dig "costPrices" dict $thisPortal | toYaml | indent 6 }}
{{- if and ($branding.logoSvg | default "") ($branding.logo | default "") }}
    {{ $branding.logo }}: |
{{ $branding.logoSvg | indent 6 }}
{{- end }}

podSecurityContext:
  {{ merge (dict "runAsUser" 1000) .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

podAnnotations:
  # The Portal resolves the PUBLIC issuer host, which CoreDNS points at the cluster's own
  # ingress controller, so a meshed Portal sends its own HTTPS back into the cluster on 443.
  # Linkerd's outbound proxy builds an HTTP balancer for that hop and the connection is reset
  # (`Connection reset by peer (os error 104)`), and the Portal exits before it ever serves:
  # discovery is the first thing it does. Marking 443 opaque on the ingress namespace and on its
  # Service does not help (ci-full 34784223904 still reset this hop with both); taking 443 out
  # of the outbound redirect does, and it makes the hop identical to the unmeshed profile.
  #
  # What it gives up, owner's decision (T-0418): where CoreDNS points the host at a meshed
  # ingress controller (k3d), proxy-to-proxy mTLS on this one hop. On dev the host is the node's
  # public address, which the mesh never gives an identity, so nothing is lost there. The
  # Portal's own TLS against a verified chain still carries the hop, its NetworkPolicy allows
  # 443 and nothing else outbound, and every in-cluster call stays meshed (Postgres 5432, the
  # gateway 8080).
  config.linkerd.io/skip-outbound-ports: "443"
  # The reason the cluster's `justify-api-token-access` policy asks for. T-0411 gave this pod a
  # ServiceAccount token and a Role so the reconciler can apply an App's objects, and wrote the
  # reason in a comment above — but the policy reads an ANNOTATION, so the new ReplicaSet was
  # refused at admission (`Pod mounts a Kubernetes API token without a justification`) and the
  # rollout never happened: the Deployment sat at UP-TO-DATE 0 while the old pod kept serving.
  # The justification belongs where it can be reviewed against the RBAC beside it.
  security.joinedcontext.com/api-access-reason: >-
    App reconciler: applies the four objects an App is made of — Deployment, Service, Secret and
    NetworkPolicy — in each project's apps namespace, under the ClusterRole `portal-apps` bound
    there (AP-13, AP-15, AP-18, AP-116); in its own namespace, under the Role in `rbac.rules`
    below, only the pipeline runner's restart patch and the Secrets it hands over (T-5094); and an App's build Job, its token Secret and its cache claim in the
    runner's namespace, under the Role `portal-build-pods` there (AP-130, AP-131, T-2794). It
    reads and writes nothing else at the API server.

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
