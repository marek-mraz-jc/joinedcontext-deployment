---
{{- $global := .Values.global }}
# Checklist:
# - [x] Minimal Resources
# - [x] Minimal storage -> stateless broker pods
# - [x] 1 Replica

replicaCount: 1

resources:
  requests:
    cpu: 100m
    # T-4473: dev, kubectl top 2026-10-17 21:22-22:22Z: median 368, peak 591Mi.
    memory: 448Mi
  limits:
    cpu: '1'
    # 1Gi: a Load take's pipeline upserts 4 000 vehicles per poll, and at 512Mi the broker was
    # OOM-killed six seconds after each restart while the runner replayed its batches. At 1Gi
    # it was killed again on 2026-09-25 at 14:20Z with every seeded pipeline running.
    memory: 1536Mi
