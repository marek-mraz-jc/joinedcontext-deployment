---
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> /q/ready and /q/health
# - [x] Graceful shutdown
# - [x] Standard labels
# - [x] ServiceAccount with least privilege where required
# - [x] Named ports -> 9090 container mapped to 8080 service
# - [ ] Ingress with TLS -> not applicable, broker is cluster-internal only

fullnameOverride: context-broker
nameOverride: context-broker-broker

{{- $images := index .Values.images "context-broker" "broker" }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

containerPort: 9090

service:
  enabled: true
  type: ClusterIP
  port: 8080
  targetPort: 9090
  name: http

probes:
  readiness:
    path: /q/ready
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /q/health
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 10

envSecret:
  PGPASSWORD:
    secret: db-antares
    key: password

# ponytail: no NATS on the cluster, so the broker runs its matcher in-process. Antares
# refuses that combination with a postgres store unless the deployment is a single
# process, because two matchers on one database fire every notification twice. One
# replica is the ceiling until a NATS component lands and ANTARES_BUS becomes "nats".
# Kubernetes expands $(VAR) references in container env definitions when the referenced variable appears earlier in the list.
env:
  # The Prometheus recorder and /q/metrics with it: Antares constructs neither by default, so
  # without this the ServiceMonitor of components/monitoring scrapes a 404 (OPS-16).
  ANTARES_TELEMETRY: "1"
  ANTARES_STORE: "postgres"
  ANTARES_BUS: "local"
  ANTARES_ALLOW_SHARED_LOCAL: "1"
  ANTARES_REQUIRE_RLS: "1"
  ANTARES_MAX_CONNECTIONS: "512"
  ANTARES_DATABASE_URL: "postgresql://antares:$(PGPASSWORD)@postgres-cluster-rw.{{ .Values.postgres.cluster.namespace }}.svc.cluster.local:5432/antares"
  # The jc build's surfaces (T-3642): the endpoint views, MCP and the engine's access document,
  # each under /x/views/{view}/. The LinkML schema is no surface: the Portal PUTs it to
  # /q/schemas/{tenant} (T-3628), which takes nothing while ANTARES_SCHEMA_MAX_BYTES is unset.
  ANTARES_API_SURFACES: "admin,views,mcp,access"
  ANTARES_SCHEMA_MAX_BYTES: "1048576"
  # The verified caller the gateway forwards (platform T-3641); `x-jc-did` a data-space
  # participant, which the gateway strips from every client request (platform T-3800, T-3816).
  # The joinedcontext engine decides every request by them and the Portal's rule documents
  # (T-3768): a request naming nobody is the cluster's own and is refused outside the Context
  # Source clauses; the gateway's own hops speak as its client (T-3767).
  ANTARES_POLICY: "joinedcontext"
  ANTARES_POLICY_SUBJECT_HEADERS: "x-jc-subject,x-jc-groups,x-jc-roles,x-jc-client,x-jc-restricted,x-jc-did"
  ANTARES_ADMIN_TOKEN_FILE: /var/run/secrets/antares/admin/token
  # A scraper cannot send the admin secret; the metrics carry no tenant data. Prometheus is not
  # admitted to the broker yet: its namespace is the operator's, and a rule naming it by pod
  # label alone would let any pod that labels itself reach the API (T-3771).
  ANTARES_ADMIN_METRICS: "open"

extraVolumes:
  - name: admin-token
    secret:
      secretName: context-broker-admin-token
      items:
        - key: token
          path: token

extraVolumeMounts:
  - name: admin-token
    mountPath: /var/run/secrets/antares/admin
    readOnly: true

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}
  runAsUser: 65532

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
