---
{{- $global := .Values.global }}
# Checklist:
# - [x] Resources (requests and limits)
# - [x] Larger Storage -> stateless broker pods
# - [ ] 2+ Replicas or HorizontalPodAutoscaler -> one process per database, see below
# - [x] Rolling updates maxUnavailable: 0, maxSurge: 1 -> default in workload chart
# - [ ] PodDisruptionBudget -> a single-replica PDB would block every node drain

# Stays at one: ANTARES_BUS=local (see base-values) allows exactly one broker process
# per database. Raising this needs a NATS bus first.
replicaCount: 1

resources:
  requests:
    cpu: 200m
    memory: 256Mi
  limits:
    cpu: '2'
    memory: 1Gi
