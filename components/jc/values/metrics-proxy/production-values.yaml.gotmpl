---
# Checklist:
# - [x] Resources: prom-label-proxy holds no state; it streams each answer through
# - [x] 1 Replica (one replica: a read path of dashboards, no write; a restart costs a panel retry)

replicaCount: 1

resources:
  requests:
    cpu: 10m
    memory: 16Mi
  limits:
    cpu: 200m
    memory: 64Mi
