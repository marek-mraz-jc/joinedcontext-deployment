{{- $global := .Values.global }}
{{- $jc := .Values.jc.server }}
{{- /* The server WASM Apps (ADR-N-044): with wasm-host in the environment the Portal inside jc
       places Apps on its shards, writes each shard's placement and store key there and proxies an
       App host's /api/* to the shard. */}}
{{- $wasm := has "wasm-host" .Values.components }}
{{- if and $wasm (not (and (has "apps-db" .Values.components) (has "artifact-store" .Values.components))) }}
{{- fail "jc with wasm-host needs apps-db (the Apps' rows) and artifact-store (their components) in the same environment" }}
{{- end }}
{{- $pg := printf "postgres-cluster-rw.%s.svc.cluster.local" .Values.postgres.cluster.namespace }}
{{- /* The App pods of components/app-pods, when the environment lists it: the Portal proxies
       each App's host to its Service, and the pod reads its Endpoint on jc's apps listener (8083,
       the gateway's Endpoint reads alone), never on the public listener the edge holds. The
       import window opens neither. */}}
{{- $pods := list }}
{{- $podClients := list }}
{{- if and (has "app-pods" .Values.components) (not (dig "importWindow" false $jc)) }}
{{- range $name, $pod := index .Values "app-pods" }}
{{- if and (kindIs "map" $pod) $pod.enabled }}
{{- $pods = append $pods (printf "%s=http://app-%s.%s.svc.cluster.local:8080" $name $name $pod.namespace) }}
{{- $podClients = append $podClients (dict "serviceAccount" (printf "app-%s" $name) "namespace" $pod.namespace) }}
{{- end }}
{{- end }}
{{- end }}
{{- /* The metricsProxy part's address: daiya's datasource `prometheus` and the one address it may reach. */}}
{{- $proxy := .Values.jc.metricsProxy }}
{{- $proxyUrl := printf "http://jc-metrics-proxy.%s.svc.cluster.local:8080" $proxy.namespace }}
{{- /* The hops jc takes X-Forwarded-For from: the edge's pod network, named by the environment.
       Without it every caller is the edge's address and per-address limits are one bucket. */}}
{{- $proxies := $jc.trustedProxies | default list }}
{{- /* jc-prod's cutover (default-environment.yaml.gotmpl realmImport, importWindow). */}}
{{- $realm := dig "realmImport" dict $jc }}
{{- $window := dig "importWindow" false $jc }}
{{- /* The window serves slug mounts on loopback whatever the environment's mode. */}}
{{- $mode := ternary "slug" (dig "mode" "slug" $jc) $window }}
{{- $modules := list "shako" "daiya" "dataroom" "ekiben" }}
{{- $assistant := dig "assistant" dict $jc }}
{{- /* The window opens no path to the App runtime: no API token, no store or apps-db login. */}}
{{- $wasmOn := and $wasm (not $window) }}
{{- /* Nor to the MQTT brokers: no internal listener, no API token. */}}
{{- $mqtt := and (has "mqtt-brokers" .Values.components) (not $window) }}
{{- if not $proxies }}
{{- fail "jc.server.trustedProxies: name the pod network the edge (APISIX) runs in, e.g. [\"10.42.0.0/16\"] on k3s, in the environment's jc values" }}
{{- end }}
{{- range $proxies }}
{{- if or (hasSuffix "/0" .) (not (contains "/" .)) }}
{{- fail (printf "jc.server.trustedProxies: %q is refused: give the edge's pod network as a CIDR narrower than /0" .) }}
{{- end }}
{{- end }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`; writable: /tmp, the state dir
#       (an emptyDir the init container fills from Secret jc-setup) and the data volume
# - [x] Health probes -> readiness /api/v1/health (the Portal, built last), liveness /streams/ping
# - [x] Graceful shutdown -> jc drains on SIGTERM
# - [x] Standard labels
# - [x] ServiceAccount with least privilege -> no API token, but with wasm-host or mqtt-brokers:
#       then the token reaches only the Role of components/wasm-host portal-access (each shard's
#       placement and store key, by name) and the brokers chart's Role in the brokers' namespace
# - [x] Named ports -> 8080 public (every mount), 9091 admin (/metrics behind its token, /healthz)
# - [x] Ingress with TLS -> APISIX routes jc.{domain} (apisix-routes.yaml)

fullnameOverride: jc
nameOverride: jc-server

{{- $images := index .Values.images "jc" "server" | default dict }}
{{- if not $images.digest }}
{{- fail "jc.server: components/jc/images.yaml pins no digest yet; pin the one the monorepo's image.yml signed before deploying jc" }}
{{- end }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

args: ["--config", "/etc/jc/jc.toml"]

containerPort: 8080

{{- if or $wasmOn $mqtt }}
# The Portal's API client (KubeClient::in_cluster). With wasm-host its reconciler writes each WASM
# shard's placement ConfigMap and store-key Secret in the host's namespace (AP-157, AP-158); with
# mqtt-brokers it stamps the brokers under the brokers chart's Role portal-mqtt-brokers, in the
# brokers' namespace alone. Those Roles grant nothing else.
serviceAccount:
  automountServiceAccountToken: true
{{- end }}

service:
  # The import window renders no Service, so neither the edge nor a pod finds jc's endpoints.
  enabled: {{ not $window }}
  type: ClusterIP
  port: 8080
  targetPort: 8080
  name: http
{{- if or $mqtt $pods }}
  extraPorts:
{{- end }}
{{- if $mqtt }}
  # The MQTT brokers' CONNECT and publish checks (ADR-N-048) on 8082, the port the brokers chart's
  # Linkerd Server names: no APISIX route names it, and the NetworkPolicy and that Server admit
  # the broker pods alone.
    - name: mqtt-auth
      port: 8082
      targetPort: 8082
      protocol: TCP
{{- end }}
{{- if $pods }}
  # The App pods' Endpoint reads (JCBIN_APPS_LISTEN): no APISIX route names it, and the
  # NetworkPolicy and the Linkerd Server jc-apps admit the App pods alone.
    - name: apps
      port: 8083
      targetPort: 8083
      protocol: TCP
{{- end }}
# Every pod, Ready or not: the edge route jc-identity reaches kaisatsu through it while the Portal
# of the same pod still waits on the realm (apisix-routes.yaml).
{{- if not $window }}
headlessService:
  name: jc-pods
{{- end }}

# The admin listener: /metrics behind the admin token (every module's series), open /healthz.
metrics:
  enabled: true
  port: 9091
  name: admin

probes:
  # The window's loopback listener answers no kubelet probe.
  enabled: {{ not $window }}
  readiness:
    # The Portal answers once jc has built it after serving (503 until then), so a ready pod
    # serves every mount.
    path: /api/v1/health
    {{- if eq $mode "host" }}
    # Host mode routes by name: the kubelet's request names the Portal's host.
    host: "portal.{{ $global.domain }}"
    {{- end }}
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  # The first start applies the Portal's realm and creates the forge repository before the
  # Portal answers: up to 5 minutes before liveness counts.
  startup:
    periodSeconds: 10
    failureThreshold: 30
  liveness:
    # ekiben's /ping: open, answered by the process itself, no module dependency.
    path: /streams/ping
    {{- if eq $mode "host" }}
    host: "localhost:8080"
    {{- end }}
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3

# One process: Antares keeps process-wide statics and jc's modules their in-memory stores
# (bins/jc/STATUS.md), so a second replica is a second, divergent installation.
replicaCount: 1
# Stays at one (ANTARES_BUS=local, env below): Recreate stops the old process before the new one
# starts, so two matchers never share jc_antares (policy-exceptions.yaml).
updateStrategy: Recreate

# Before DNS points the public names at this cluster (jc-prod on dev ahead of the cutover), jc's own
# reads of its public URLs (the Portal fetching kaisatsu's discovery at idm.{domain}) would reach the
# old installation: `edgeAddress` pins every routed host to this cluster's ingress address.
{{- with (dig "edgeAddress" "" $jc) }}
hostAliases:
  - ip: {{ . | quote }}
    hostnames:
    {{- range $jc.hosts }}
      - {{ if . }}{{ . }}.{{ end }}{{ $global.domain }}
    {{- end }}
{{- end }}

configMap:
  enabled: true
  mountPath: /etc/jc
  data:
    jc.toml: |
      role = "all"
      {{- if $window }}
      # Import window: only `kubectl port-forward` (the pod's loopback) reaches jc.
      listen = "127.0.0.1:8080"
      {{- else }}
      listen = "0.0.0.0:8080"
      {{- end }}
      admin_listen = "0.0.0.0:9091"
      admin_token_file = "/run/jc/admin/token"
      {{- if $window }}
      # Import window: the rehearsal kit's shape (CLUSTER-IMPORT.md 6): slug mounts on
      # http://localhost:8080, which the kit reaches through `kubectl port-forward 8080:8080` and
      # the Portal reaches on the pod's own loopback for kaisatsu's discovery (the window routes
      # nothing through the edge).
      mode = "slug"
      base_host = "localhost:8080"
      scheme = "http"
      {{- else if eq $mode "host" }}
      mode = "host"
      base_host = "{{ $global.domain }}"
      scheme = "https"
      {{- else }}
      mode = "slug"
      base_host = "{{ $jc.subDomain }}.{{ $global.domain }}"
      scheme = "https"
      {{- end }}
      log_format = "json"
      state_dir = "/var/lib/jc/state"
      # Only a peer inside these networks may name the caller in X-Forwarded-For.
      trusted_proxies = {{ $proxies | toJson }}

      {{- if eq $mode "host" }}
      # Every old host name (bins/jc CUTOVER.md section 4, tests/fixtures/dev-mounts.toml).
      [mounts.kaisatsu]
      host = "idm.{{ $global.domain }}"
      path_prefix = ""

      [[mounts.portal]]
      host = "portal.{{ $global.domain }}"
      path_prefix = ""

      # Every App host: the Portal serves App {name} alone on {name}.apps.{domain} (edge-session-design
      # S4a); jc sets JC_PORTAL_APPS_URL and JC_PORTAL_SERVE_APP_HOSTS from this entry.
      [[mounts.portal]]
      host = "*.apps.{{ $global.domain }}"

      [mounts.dataroom]
      host = "opendata.{{ $global.domain }}"
      path_prefix = ""

      [mounts.daiya]
      host = "{{ $global.domain }}"
      path_prefix = "/grafana"

      [[mounts.shako]]
      host = "{{ $global.domain }}"
      path_prefix = "/git"

      # The Portal's own forge address (JC_SHAKO_URL below): in host mode jc points the Portal at
      # shako's public base, which the edge refuses (/git stays inside the pod) and which needs
      # jc Ready before the Portal is built. A request naming this host through the edge meets the
      # same /git block on the host-less apex route.
      [[mounts.shako]]
      host = "localhost:8080"
      path_prefix = "/git"

      # ekiben and the broker stay inside the pod too: on loopback only, never on a public name.
      [[mounts.ekiben]]
      host = "localhost:8080"
      path_prefix = "/streams"

      [[mounts.antares]]
      host = "localhost:8080"
      path_prefix = "/broker"

      [mounts.assistant]
      host = "assistant.{{ $global.domain }}"
      path_prefix = ""

      [mounts.viz]
      host = "viz.{{ $global.domain }}"
      path_prefix = ""

      # The gateway's own host first: its issuer and absolute URLs.
      [[mounts.gateway]]
      host = "api.{{ $global.domain }}"
      path_prefix = ""
      {{- range list "/cs" "/api/endpoint" "/api/mcp" "/catalog" "/catalog.jsonld" "/catalog.ttl" }}

      [[mounts.gateway]]
      host = "{{ $global.domain }}"
      path_prefix = "{{ . }}"
      {{- end }}
      {{- range list "/cs" "/api/endpoint" "/api/mcp" }}

      [[mounts.gateway]]
      host = "portal.{{ $global.domain }}"
      path_prefix = "{{ . }}"
      {{- end }}

      {{- else }}
      # The Portal's UI and redirects assume the root of its host (bins/jc/STATUS.md stage 7).
      [mounts.portal]
      path_prefix = ""
      {{- end }}

      [kaisatsu]
      database_url_file = "/etc/jc/kaisatsu-database-url"
      db_password_file = "/run/jc/db/kaisatsu-app/password"
      db_max_connections = {{ $jc.kaisatsuPool }}
      {{- if $realm }}
      # The export's realm (seed-realm below), its $(file:...) secrets only under import_secrets_dir.
      import_dir = "/var/lib/jc-realms"
      import_secrets_dir = "/run/jc/realm-secrets"
      {{- end }}

      [ekiben]
      file_root = "/var/lib/jc-data/streams"

      [shako]
      repo_root = "/var/lib/jc-data/git"

      # A [dataroom] section must name its organization and catalogue: jc's defaults.
      [dataroom]
      org_id = "00000000-0000-7000-8000-000000000001"
      catalogue_id = "00000000-0000-7000-8000-000000000010"
      {{- with (dig "dataroomAliases" dict $jc) }}

      [dataroom.aliases]
      {{- range $from, $to := . }}
      {{ $from | quote }} = {{ $to | quote }}
      {{- end }}
      {{- end }}
      {{- with (dig "catalogueHidden" dict $jc) }}

      # prod's publish-gate hidden list (bins/jc/docs/catalogue-hidden.toml).
      [dataroom.hidden]
      {{- range $slug, $why := . }}
      {{ $slug | quote }} = {{ $why | quote }}
      {{- end }}
      {{- end }}
      {{- range $modules }}

      [{{ . }}.database]
      url = "postgres://{{ . }}_app@{{ $pg }}:5432/jc_{{ . }}"
      password_file = "/run/jc/db/{{ . }}-app/password"
      max_connections = {{ dig "modulePool" 3 $jc }}
      migrate_url = "postgres://{{ . }}_migrate@{{ $pg }}:5432/jc_{{ . }}"
      migrate_password_file = "/run/jc/db/{{ . }}-migrate/password"
      {{- end }}

      [assistant.database]
      url = "postgres://jc_assistant@{{ $pg }}:5432/jc_assistant"
      password_file = "/run/jc/db/assistant/password"
      max_connections = {{ dig "assistantPool" 3 $jc }}
      {{- with (dig "realm" "" $realm) }}

      [identity]
      realm = {{ . | quote }}
      {{- end }}
      {{- if (dig "catalogueHarvest" false $jc) }}

      # prod's two catalogue harvests, copied from the monorepo (files/harvest-sources.toml); each
      # reads od-datasets.json beside jc.toml.
      # A source reads its datasets' Endpoint doors on this instance's own gateway (api.{domain} in
      # host mode, refused unless listed) and links the datasets under this instance's catalogue.
{{ readFile "../../files/harvest-sources.toml" | replace "https://opendata.dev.joinedcontext.com/" (printf "https://opendata.%s/" $global.domain) | replace "allowed_hosts = [" (printf "allowed_hosts = [%q, " (printf "api.%s" $global.domain)) | indent 6 }}
      {{- end }}
      {{- if $proxy.enabled }}

      # Organization 1's datasource `prometheus` on the metricsProxy part, the one address it may
      # reach over http (every query pinned to this namespace's series there).
      [daiya]
      provisioning_dir = "/etc/jc-daiya"
      prometheus_reach = "{{ $proxyUrl }}"
      {{- end }}
    {{- if (dig "catalogueHarvest" false $jc) }}
    # The datasets prod converted (files/od-datasets.json, the monorepo's bins/jc/docs copy).
    od-datasets.json: |
{{ readFile "../../files/od-datasets.json" | indent 6 }}
    {{- end }}
    {{- if $proxy.enabled }}
    # The runner's shared resources (`-r`: project caches, source rate limits) and the GTFS-RT schema a
    # stream's `import_paths: [/proto]` reads, as the pipeline-runner component and up.sh give them.
    # Without them hsl-service-alerts and hsl-departures were refused: lstat .../streams/proto (jc-prod).
    ekiben-resources.yaml: |
{{ readFile "../../../pipeline-runner/streams/resources.yaml" | indent 6 }}
    gtfs-realtime.proto: |
{{ readFile "../../../pipeline-runner/streams/gtfs-realtime.proto" | indent 6 }}
    daiya-prometheus.yaml: |
      apiVersion: 1
      datasources:
        - name: Prometheus
          uid: prometheus
          type: prometheus
          access: proxy
          orgId: 1
          url: {{ $proxyUrl }}
          editable: false
          jsonData:
            timeInterval: 15s
    {{- end }}
    # kaisatsu's request role on its database; the password comes from its own file.
    kaisatsu-database-url: "postgres://kaisatsu_app@{{ $pg }}:5432/jc_kaisatsu"

# The Portal's and Antares' own settings, which jc passes through unchanged.
envSecret:
  # The CkanInstances' apiTokenRef (envVar CKAN_API_TOKEN): jc's own dataroom publisher token.
  CKAN_API_TOKEN:
    secret: jc-setup
    key: catalogue-token
{{- if eq $mode "host" }}
  JC_SHAKO_TOKEN:
    secret: jc-setup
    key: shako-token
  JC_SHAKO_APPS_TOKEN:
    secret: jc-setup
    key: shako-token
  JC_SHAKO_WEBHOOK_SECRET:
    secret: jc-setup
    key: forge-webhook-secret
  JC_PORTAL_PIPELINE_RUNNER_TOKEN:
    secret: jc-setup
    key: ekiben-token
{{- end }}
  PORTAL_DB_PASSWORD:
    secret: db-jc-portal
    key: password
  BROKER_DB_PASSWORD:
    secret: db-jc-antares
    key: password
{{- if $wasmOn }}
  # The wasm Apps' database login (AP-149): the Portal makes every App's schema and roles.
  APPS_DB_PASSWORD:
    secret: db-apps-admin
    key: password
  # The artifact store's root credential (PF-32): the reconciler derives each shard's key from it.
  JC_PORTAL_ARTIFACT_STORE_ACCESS_KEY:
    secret: artifact-store-root
    key: ACCESS_KEY_ID
  JC_PORTAL_ARTIFACT_STORE_SECRET_KEY:
    secret: artifact-store-root
    key: ACCESS_SECRET_KEY
{{- end }}
env:
  # The image sets JCBIN_LISTEN=0.0.0.0:8080 and JCBIN_STATE_DIR=/var/lib/jc (bins/jc/Dockerfile),
  # and jc's environment beats jc.toml: name both as jc.toml does, or the window listens on every
  # address and jc tries to chmod the volume root it does not own.
  JCBIN_LISTEN: {{ ternary "127.0.0.1:8080" "0.0.0.0:8080" $window | quote }}
  JCBIN_STATE_DIR: "/var/lib/jc/state"
  # jc holds these in-process tokens per boot in memory unless given a file: the ones Secret
  # jc-setup keeps, read from its volume (jc deletes an in-memory token's file from the state dir
  # at start, setup.rs remove_stale), so the cluster import, the smoke suites and the Apps'
  # catalogue publishing read the value jc checks (up.sh does the same).
  JCBIN_SHAKO_TOKEN_FILE: "/run/jc/setup/shako-token"
  JCBIN_EKIBEN_TOKEN_FILE: "/run/jc/setup/ekiben-token"
  JCBIN_DAIYA_PORTAL_PASSWORD_FILE: "/run/jc/setup/dashboards-password"
  JCBIN_DATAROOM_PORTAL_TOKEN_FILE: "/run/jc/setup/catalogue-token"
  JCBIN_EKIBEN_RESOURCES_FILE: "/etc/jc/ekiben-resources.yaml"
  # Concurrent OGC file exports: jc 446484ae raised the default from 2 to 6 (each streams page by
  # page, up to 512 MiB / 120 s). The one node runs at 85-90 % memory: keep the old cap until measured.
  ANTARES_EXPORT_FILES: "2"
  {{- with $global.orgDomain }}
  # The organization's domain in every minted id (urn:ngsi-ld:{Type}:{orgDomain}:...): unset, jc
  # derives it from the Portal's host, and jc-prod's pipelines minted portal.smartcity... copies
  # beside the imported hel.fi entities (2026-11-10). ekiben's runners read the Portal's.
  JC_PORTAL_ORG_DOMAIN: {{ . | quote }}
  JC_GATEWAY_ORG_DOMAIN: {{ . | quote }}
  JC_ASSISTANT_ORG_DOMAIN: {{ . | quote }}
  {{- end }}
  {{- if eq $mode "host" }}
  # The Portal's forge on jc's loopback ([[mounts.shako]] localhost:8080 above). Naming the URL
  # turns off jc's fill of the whole group, so the group is named here (siblings.rs JC_SHAKO_URL).
  JC_SHAKO_URL: "http://localhost:8080/git"
  JC_SHAKO_PUBLIC_URL: "https://{{ $global.domain }}/git"
  JC_SHAKO_APPS_OWNER: "jc-apps"
  JC_PORTAL_PIPELINE_RUNNER_URL: "http://localhost:8080/streams"
  JC_PORTAL_PIPELINES_BATCH_CONCURRENCY: "3"
  JC_PORTAL_BROKER_URL: "http://localhost:8080/broker"
  JC_PORTAL_BROKER_ADMIN_TOKEN_FILE: "/run/jc/setup/antares-admin-token"
  {{- end }}
  {{- if $realm }}
  # The imported deployment's configuration repository, as the rehearsal kit points jc at it.
  JC_SHAKO_OWNER: "joinedcontext"
  JC_SHAKO_REPO: "configuration"
  {{- else if eq $mode "host" }}
  JC_SHAKO_OWNER: "jc"
  JC_SHAKO_REPO: "config"
  {{- end }}
  # One jc process per database: Antares' in-process bus runs one matcher per process, so jc
  # rolls by Recreate (updateStrategy below) and declares itself the only one.
  ANTARES_BUS: "local"
  ANTARES_ALLOW_SHARED_LOCAL: "1"
  JC_PORTAL_DATABASE_URL: "postgresql://jc_portal:$(PORTAL_DB_PASSWORD)@{{ $pg }}:5432/jc_portal"
  ANTARES_STORE: "postgres"
  ANTARES_DATABASE_URL: "postgresql://jc_antares:$(BROKER_DB_PASSWORD)@{{ $pg }}:5432/jc_antares"
  ANTARES_PG_POOL: {{ $jc.antaresPool | quote }}
  {{- if dig "jc" "functions" "enabled" false .Values }}
  # The App functions runtime beside jc (values/functions); the Portal calls it with its token.
  JC_FUNCTIONS_URL: "http://jc-functions.{{ .Values.jc.functions.namespace }}.svc.cluster.local:8080"
  {{- end }}
  {{- if (dig "ageKeySecret" "" $jc) }}
  # The age identity that decrypts each project's SOPS secrets, so a secretRef resolves in jc.
  JCBIN_PORTAL_AGE_KEY_FILE: "/run/jc/age/key"
  {{- end }}
  {{- if $assistant }}
  # The model key's file (a file only: jc refuses the key in the environment).
  JCBIN_MODEL_KEY_FILE: "/run/jc/model/key"
  {{- end }}
  {{- if $window }}
  # Import window only: the import's writes carry no subject. Never outside it (tests/test_jc_component.py).
  ANTARES_POLICY: "allow-all"
  {{- end }}
  # The builds the Portal fetches from shako's package registry (the own-repository Apps, prod's
  # builds imported by jc-migrate), checked against status.build before they are unpacked. On the
  # data volume: /var/lib/jc is the 1 MiB memory state dir.
  JC_PORTAL_APPS_CACHE_DIR: /var/lib/jc-data/apps-cache
  {{- if $wasmOn }}
  # Server WASM Apps (ADR-N-044): their database, the shards the Portal places them on, the
  # bucket of their components and files, and the namespace where it writes each shard's
  # placement and store key (AP-149, AP-157, AP-158), as components/portal sets them.
  JC_PORTAL_ARTIFACT_STORE_ENDPOINT: "http://artifact-store.{{ index .Values "artifact-store" "store" "namespace" }}.svc.cluster.local:9000"
  JC_PORTAL_ARTIFACT_STORE_BUCKET: {{ index .Values "artifact-store" "store" "bucket" | default "jc-artifacts" | quote }}
  JC_PORTAL_APPS_DB_URL: "postgresql://jc_apps_admin:$(APPS_DB_PASSWORD)@apps-db-rw.{{ index .Values "apps-db" "cluster" "namespace" }}.svc.cluster.local:5432/apps?sslmode=require"
  JC_PORTAL_WASM_SHARDS: {{ index .Values "apps-db" "cluster" "shards" | default 2 | quote }}
  JC_PORTAL_APPS_BUCKET: {{ index .Values "wasm-host" "bucket" | default "apps" | quote }}
  JC_PORTAL_WASM_HOST_NAMESPACE: {{ index .Values "wasm-host" "shard-0" "namespace" | quote }}
  {{- end }}
  {{- with $pods }}
  # The ui-rust Apps whose pod runs beside jc (components/app-pods): the Portal proxies their hosts,
  # and the pods read their Endpoints on the apps listener, the gateway's GET/HEAD
  # /api/endpoint/... alone (an env key, so a jc without it starts and listens on nothing more).
  JC_PORTAL_APP_PODS: {{ join "," . | quote }}
  JCBIN_APPS_LISTEN: "0.0.0.0:8083"
  {{- end }}
  # jemalloc as the image sets it (bins/jc/Dockerfile), kept here so the pod spec says it.
  _RJEM_MALLOC_CONF: "background_thread:true,narenas:4,dirty_decay_ms:1000,muzzy_decay_ms:0"
{{- if $mqtt }}
  {{- $brokers := index .Values "mqtt-brokers" "brokers" "namespace" }}
  # The MQTT edge brokers (ADR-N-048). The gateway's CONNECT check on its internal listener; the
  # tokenless CONNECTs it admits from jc's own pods (ekiben's DataSource reads, the Portal's
  # capture) and from the broker pods, which is where a meshed client of 1883 appears; the
  # Portal's identity, the one caller of the refusals route.
  JC_GATEWAY_INTERNAL_BIND: "0.0.0.0:8082"
  JC_GATEWAY_MQTT_RUNNER_HOST: "jc-pods.{{ $jc.namespace }}.svc.cluster.local"
  JC_GATEWAY_MQTT_PORTAL_HOST: "jc-pods.{{ $jc.namespace }}.svc.cluster.local"
  JC_GATEWAY_MQTT_BROKER_HOST: "mqtt-broker-pods.{{ $brokers }}.svc.cluster.local"
  JC_GATEWAY_MQTT_PORTAL_IDENTITY: "jc.{{ $jc.namespace }}"
  # Where the Portal stamps one release per MqttBroker from the chart's broker-template.
  JC_PORTAL_MQTT_NAMESPACE: {{ $brokers | quote }}
  # A DataSource on a platform broker reads tcp://<release>.${JC_MQTT_NAMESPACE}.svc:1883, so
  # ekiben's JC_MQTT_NAMESPACE is the brokers' namespace (it also keeps an outside broker's
  # client id apart per installation).
  EKIBEN_VAR_JC_MQTT_NAMESPACE: {{ $brokers | quote }}
  # ekiben refuses a private address unless the name is listed: each broker's 1883 alone, never
  # its HTTP API (6060), which only the Portal reads; `project=` admits only that project's
  # streams. ponytail: one entry per MqttBroker the environment names (jc.server.mqttBrokers);
  # a broker added in the Portal needs a line there.
  JC_EKIBEN_PRIVATE_HOSTS: {{ $hosts := list }}{{ range $jc.mqttBrokers | default list }}{{ $hosts = append $hosts (printf "%s=%s.%s.svc.cluster.local:1883" .project .release $brokers) }}{{ end }}{{ join "," $hosts | quote }}
{{- end }}

# The generated secrets of jc's first-start setup (bins/jc/src/setup.rs) live in Secret jc-setup,
# so a new pod reads the same values: the init container copies them into the state dir as
# 0600 files of the pod's user (jc refuses a state dir it cannot make 0700, which a Secret
# volume is not), then kaisatsu's migrations run as kaisatsu_migrate.
extraInitContainers:
  - name: seed-state
    image: {{ printf "%s@%s" .Values.images.jc.seed.repository .Values.images.jc.seed.digest | quote }}
    command:
      - /bin/sh
      - -c
      - |
        set -eu
        install -d -m 0700 /var/lib/jc/state
        for f in /run/jc/setup/*; do install -m 0600 "$f" "/var/lib/jc/state/$(basename "$f")"; done
    securityContext:
      {{- .Values.securityDefaults.securityContext | toYaml | nindent 6 }}
    resources:
      requests: { cpu: 10m, memory: 16Mi }
      limits: { cpu: 100m, memory: 32Mi }
    volumeMounts:
      - { name: state, mountPath: /var/lib/jc }
      - { name: setup, mountPath: /run/jc/setup, readOnly: true }
  - name: kaisatsu-migrate
    image: {{ printf "%s@%s" $images.repository $images.digest | quote }}
    command:
      - /usr/local/bin/kaisatsu
      - migrate
      - --database-url
      - "postgres://kaisatsu_migrate@{{ $pg }}:5432/jc_kaisatsu"
      - --db-password-file
      - /run/jc/db/kaisatsu-migrate/password
    securityContext:
      {{- .Values.securityDefaults.securityContext | toYaml | nindent 6 }}
    resources:
      requests: { cpu: 20m, memory: 32Mi }
      limits: { cpu: 500m, memory: 128Mi }
    volumeMounts:
      - { name: db-kaisatsu-migrate, mountPath: /run/jc/db/kaisatsu-migrate, readOnly: true }
  {{- if $realm }}
  # The export's realm: realm.json.gz unpacked to the import dir, each realm secret a 0600 file
  # under import_secrets_dir (a Secret volume holds links, which ekiben refuses), the
  # <project>-pipelines copies, and jc's own client secrets into the state dir (CLUSTER-IMPORT.md 4).
  - name: seed-realm
    image: {{ printf "%s@%s" .Values.images.jc.seed.repository .Values.images.jc.seed.digest | quote }}
    command:
      - /bin/sh
      - -c
      - |
        set -eu
        for f in /run/jc/realm-secrets-src/*; do install -m 0600 "$f" "/run/jc/realm-secrets/$(basename "$f")"; done
        while read -r client name; do
          [ -n "$client" ] || continue
          install -m 0600 "/run/jc/realm-secrets/$name" "/run/jc/realm-secrets/$client"
        done < /run/jc/realm-src/pipeline-clients.txt
        while read -r file name; do
          [ -n "$file" ] || continue
          install -m 0600 "/run/jc/realm-secrets/$name" "/var/lib/jc/state/$file"
        done < /run/jc/realm-src/state-secrets.txt
        gunzip -c /run/jc/realm-src/realm.json.gz > "/var/lib/jc-realms/{{ $realm.realm }}.json"
        chmod 0600 "/var/lib/jc-realms/{{ $realm.realm }}.json"
    securityContext:
      {{- .Values.securityDefaults.securityContext | toYaml | nindent 6 }}
    resources:
      requests: { cpu: 10m, memory: 16Mi }
      limits: { cpu: 200m, memory: 64Mi }
    volumeMounts:
      - { name: state, mountPath: /var/lib/jc }
      - { name: realms, mountPath: /var/lib/jc-realms }
      - { name: realm-secrets, mountPath: /run/jc/realm-secrets }
      - { name: realm-src, mountPath: /run/jc/realm-src, readOnly: true }
      - { name: realm-secrets-src, mountPath: /run/jc/realm-secrets-src, readOnly: true }
  {{- end }}

extraVolumes:
  # Tokens and the gateway's project checkouts ({state}/gateway: org cache, archives, assembly;
  # 70 MB in prod's rehearsal). 1Mi gave ENOSPC and no Endpoint served (jc-prod, 2026-11-10); a
  # disk volume on {state}/gateway cannot work, because jc chmods that directory 0700 and a
  # volume's root is not its own. tmpfs counts against jc's memory limit.
  - name: state
    emptyDir:
      medium: Memory
      sizeLimit: 192Mi
  - name: setup
    secret:
      secretName: jc-setup
      defaultMode: 0440
  - name: admin-token
    secret:
      secretName: jc-admin-token
      defaultMode: 0440
  - name: db-kaisatsu-app
    secret:
      secretName: db-jc-kaisatsu-app
      defaultMode: 0440
      items: [{ key: password, path: password }]
  - name: db-kaisatsu-migrate
    secret:
      secretName: db-jc-kaisatsu
      defaultMode: 0440
      items: [{ key: password, path: password }]
  - name: db-assistant
    secret:
      secretName: db-jc-assistant
      defaultMode: 0440
      items: [{ key: password, path: password }]
  {{- with (dig "ageKeySecret" "" $jc) }}
  - name: age-key
    secret:
      secretName: {{ . }}
      defaultMode: 0400
      items: [{ key: key, path: key }]
  {{- end }}
  {{- with (dig "modelKeySecret" "" $assistant) }}
  - name: model-key
    secret:
      secretName: {{ . }}
      defaultMode: 0440
      items: [{ key: key, path: key }]
  {{- end }}
  {{- range $modules }}
  - name: db-{{ . }}-app
    secret:
      secretName: db-jc-{{ . }}-app
      defaultMode: 0440
      items: [{ key: password, path: password }]
  - name: db-{{ . }}-migrate
    secret:
      secretName: db-jc-{{ . }}
      defaultMode: 0440
      items: [{ key: password, path: password }]
  {{- end }}
  {{- if $realm }}
  - name: realms
    emptyDir:
      medium: Memory
      sizeLimit: 16Mi
  - name: realm-secrets
    emptyDir:
      medium: Memory
      sizeLimit: 8Mi  # 900+ secret files at 4 KiB tmpfs pages each
  - name: realm-src
    secret:
      secretName: {{ $realm.secret }}
      defaultMode: 0440
  - name: realm-secrets-src
    secret:
      secretName: {{ $realm.secretsSecret }}
      defaultMode: 0440
  {{- end }}
  {{- if $proxy.enabled }}
  # daiya's provisioning root: the datasource file of this pod's ConfigMap under datasources/.
  - name: daiya-provisioning
    configMap:
      name: jc
      items: [{ key: daiya-prometheus.yaml, path: datasources/prometheus.yaml }]
  {{- end }}

extraVolumeMounts:
  - { name: state, mountPath: /var/lib/jc }
  # A file, not a symlink (subPath): ekiben confines /proto to its file root and lstats the path.
  - { name: config, mountPath: /var/lib/jc-data/streams/proto/gtfs-realtime.proto, subPath: gtfs-realtime.proto, readOnly: true }
  {{- if $proxy.enabled }}
  - { name: daiya-provisioning, mountPath: /etc/jc-daiya, readOnly: true }
  {{- end }}
  - { name: admin-token, mountPath: /run/jc/admin, readOnly: true }
  - { name: setup, mountPath: /run/jc/setup, readOnly: true }
  - { name: db-kaisatsu-app, mountPath: /run/jc/db/kaisatsu-app, readOnly: true }
  - { name: db-assistant, mountPath: /run/jc/db/assistant, readOnly: true }
  {{- if (dig "ageKeySecret" "" $jc) }}
  - { name: age-key, mountPath: /run/jc/age, readOnly: true }
  {{- end }}
  {{- if (dig "modelKeySecret" "" $assistant) }}
  - { name: model-key, mountPath: /run/jc/model, readOnly: true }
  {{- end }}
  {{- range $modules }}
  - { name: db-{{ . }}-app, mountPath: /run/jc/db/{{ . }}-app, readOnly: true }
  - { name: db-{{ . }}-migrate, mountPath: /run/jc/db/{{ . }}-migrate, readOnly: true }
  {{- end }}
  {{- if $realm }}
  - { name: realms, mountPath: /var/lib/jc-realms, readOnly: true }
  - { name: realm-secrets, mountPath: /run/jc/realm-secrets, readOnly: true }
  {{- end }}

# shako's repositories and ekiben's file root (jc.toml above).
persistence:
  enabled: true
  size: {{ $jc.dataSize }}
  mountPath: /var/lib/jc-data
  storageClass: {{ $global.storage.storageClass.rwo | default "" | quote }}

{{- with (dig "retainHours" 0 $jc) }}
# The cutover's temporal rule (owner 2026-11-09, CLUSTER-IMPORT.md 6.6): every hour, delete history
# older than {{ . }} h, audit rows kept, KeyPerformanceIndicator whole. The statement of the
# monorepo's deploy/rehearsal/rehearsal.py retain_sql, with now() for the cutoff.
cronJobs:
  - name: jc-retain
    schedule: "17 * * * *"
    podLabels:
      app.kubernetes.io/name: jc-retain
    podSpec:
      securityContext:
        {{- $.Values.securityDefaults.podSecurityContext | toYaml | nindent 8 }}
      containers:
        - name: retain
          image: {{ printf "%s@%s" $.Values.images.postgres.roleJob.repository $.Values.images.postgres.roleJob.digest | quote }}
          securityContext:
            {{- $.Values.securityDefaults.securityContext | toYaml | nindent 12 }}
          resources:
            requests: { cpu: 20m, memory: 32Mi }
            limits: { cpu: 500m, memory: 128Mi }
          env:
            - { name: HOME, value: /tmp }
            - { name: PGHOST, value: {{ $pg | quote }} }
            - { name: PGDATABASE, value: jc_antares }
            - { name: PGUSER, value: jc_antares }
            - name: PGPASSWORD
              valueFrom: { secretKeyRef: { name: db-jc-antares, key: password } }
          volumeMounts:
            - { name: tmp, mountPath: /tmp }
          command:
            - psql
            - -AX
            - -v
            - ON_ERROR_STOP=1
            - -c
            - |
              BEGIN;
              SELECT set_config('antares.service', 'on', true);
              DELETE FROM public.attr_instances h WHERE h.observed_at < now() - interval '{{ . }} hours' AND NOT coalesce(h.provenance @> '{"audit": true}', false) AND NOT EXISTS (SELECT 1 FROM public.temporal_entities te WHERE te.tenant_id = h.tenant_id AND te.id = h.entity_id AND EXISTS (SELECT 1 FROM unnest(te.types) t WHERE t ~ '(^|[/#:])(KeyPerformanceIndicator)$'));
              DELETE FROM public.attr_rows h WHERE h.observed_at < now() - interval '{{ . }} hours' AND NOT coalesce(h.provenance @> '{"audit": true}', false) AND NOT EXISTS (SELECT 1 FROM public.iri_ids i JOIN public.temporal_entities te ON te.tenant_id = i.tenant_id AND te.id = i.iri WHERE i.tenant_id = h.tenant_id AND i.id = h.entity_no AND EXISTS (SELECT 1 FROM unnest(te.types) t WHERE t ~ '(^|[/#:])(KeyPerformanceIndicator)$'));
              COMMIT;
      volumes:
        - { name: tmp, emptyDir: { sizeLimit: 16Mi } }
{{- end }}

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

{{- if or $mqtt $pods }}
# The brokers and the App pods reach the Linkerd inbound proxy (4143) for 8082 and 8083, and the
# proxy would hand them 8080 too (the namespace admits every meshed identity). On 8080 it admits
# APISIX's alone, which is what the NetworkPolicy lets reach it, so the X-Forwarded-For trust
# stays the edge's (tests/test_jc_component.py). No HTTPRoute: the kubelet's probes stay authorized.
meshAuthorization:
  port: 8080
  clients:
    - serviceAccount: apisix
      namespace: {{ .Values.apisix.apisix.namespace }}
  {{- with $podClients }}
  # 8083, the apps listener, admits the App pods' identities alone: a port with no Server would
  # fall back to the namespace default, which admits every meshed identity.
  extraPorts:
    - name: apps
      port: 8083
      clients:
        {{- toYaml . | nindent 8 }}
  {{- end }}
{{- end }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
