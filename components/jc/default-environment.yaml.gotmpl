---
jc:
  server:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    # The public host every mount answers on (slug mode: /login, /opendata, /dashboards and the
    # Portal at the root): jc.{domain}, so nothing collides with the separate components' hosts
    # while both run on one cluster.
    subDomain: jc
    # host: every old host name keeps answering (bins/jc CUTOVER.md section 4): the Portal on
    # portal.{domain}, kaisatsu on idm., the gateway on api. and its paths on the apex and portal.,
    # dataroom on opendata., daiya at {domain}/grafana, shako at {domain}/git. `subDomain` is then
    # unused and `hosts` lists every host the edge routes to jc ("" is the apex) and its
    # certificate names; a host no mount claims answers jc's 404.
    mode: slug
    hosts: ["", idm, portal, api, opendata, data, assistant, viz]
    # The installation's sign-in host, a label of `hosts` (T-6991 §5): on the installation
    # certificate, checked at render. Empty: none named.
    loginHost: ''
    # Organizations on hosts of their own (T-6991 §1, §8; T-7005). Each entry is `{name, host: auto}`
    # or `{name, catalogueId, domain?, hosts: {portal, opendata?, api?, mcp?}, resolved?, certificate?}`:
    # `hosts` (and `resolved`) are labels under `domain` (default global.domain). jc.toml gets the
    # entries today's jc reads (catalogueId and all four hosts), the edge a route per host under
    # global.domain, organization-tls.yaml a Certificate per resolved host (absent: every host), one
    # `jc-org-<name>` with `certificate: organization` once all resolve. E.g.
    # {name: bbsk, catalogueId: <uuid>, hosts: {portal: smartcity.bbsk, opendata: opendata.bbsk, api: api.bbsk, mcp: mcp.bbsk, idm: idm.bbsk}}
    organizations: []
    # Organization Certificates already issued (kubectl get certificate): any other counts as new,
    # and a render with more than certificateStage new fails, so a cut-over is staged.
    issuedCertificates: []
    certificateStage: 10
    # Pool ceilings on the shared postgres-cluster (tests/test_postgres_connection_budget.py):
    # kaisatsu's request role, Antares' store. The Portal's pool is compiled in (5).
    kaisatsuPool: 4
    antaresPool: 8
    # Each database serves as a login apart from its owner: Antares as jc_antares_app (cross-Tenant
    # work as jc_antares_maint, T-7310), the Portal as jc_portal_app (T-7179), the assistant as
    # jc_assistant_app (T-7488); each owner only migrates. A jc image from 712cff15 (T-7488) on refuses
    # to start without it, and an older one refuses the assistant's migrate_url: flip it in the same
    # commit as the pin that crosses 712cff15. The switch goes once both clusters run such an image.
    # On for jc-dev with its serverJcDev pin ddfd9107; jc-prod (server e942ebb8) stays off.
    roleSplit: {{ eq .Environment.Name "jc-dev" }}
    # shako's, daiya's, dataroom's and ekiben's request roles, each (plus one migration login at start).
    modulePool: 3
    # The assistant's pool on jc_assistant (it migrates as the same role).
    assistantPool: 3
    # The knowledge assistant (bins/jc/src/modules/assistant.rs): on with a model key, which jc's own
    # proxy calls the provider with; off (404 on its mount) without. The key comes from a Secret
    # (secretRef, never in Git): assistant: {modelKeySecret: jc-model-key}. Each Deployment's
    # costPerDayUsd (its project's manifest) caps what it spends.
    assistant: {}
    # Secret (key `key`) with the age identity the projects' SOPS files name; unset: no secretRef
    # of a project resolves.
    ageKeySecret: ""
    # prod's catalogue harvests (hub-bbsk, nkod-banskabystrica): their hosts on the harvest
    # allow-list and files/od-datasets.json beside jc.toml; the sources themselves are Organization
    # smartcity's default Portal manifest since T-6898. Egress: public 443.
    catalogueHarvest: false
    # The operator's price table for Administration -> Costs (T-7009, as portal.costPrices T-5126):
    # { currency, perUsd, nodes: [{name, monthly}], volumes, fixed }. {} renders no file and the page
    # says no table is set.
    costPrices: {}
    # kaisatsu second-factor floor (T-6894): "" leaves jc's default (optional), "required" makes every
    # person enrol a TOTP. jc before c418ee1e refuses the key: set it only with a pin that carries it.
    secondFactor: ""
    # Hours of temporal history kept (KPI whole, audit rows kept), deleted by CronJob jc-retain;
    # 0 keeps everything.
    retainHours: 0
    # jc-prod's cutover (CLUSTER-IMPORT.md): the realm of the export, applied at start from the
    # Secrets the deployer makes from the bundle's realm render (never in Git):
    #   realmImport: {realm: smartcity, secret: jc-realm, secretsSecret: jc-realm-secrets}
    # `jc-realm` holds realm.json.gz, state-secrets.txt and pipeline-clients.txt; `jc-realm-secrets`
    # one key per line of realm-vars.txt. Unset: jc applies only its own realm.
    realmImport: {}
    # The import window (CLUSTER-IMPORT.md section 6): jc on loopback only, Antares allow-all, no
    # probes, no Service endpoints. Only during the import through `kubectl port-forward`; off again
    # before DNS moves (RUNBOOK-cutover step 1).
    importWindow: false
    # shako's repositories and ekiben's file root.
    dataSize: 5Gi
    # The role split (T-7009, bins/jc deploy/rehearsal/split.sh): `server` runs the core (kaisatsu,
    # antares, gateway, portal, model-tools, assistant, viz, ekiben) with Antares' bus on the `nats`
    # part, and calls shako, daiya and dataroom, each a part of its own, through [remote] with a
    # token of realm jc-split; each answers it at its [door]. Needs realmImport (the realm's import
    # dir) and jc.shako, jc.daiya, jc.dataroom and jc.nats enabled with it.
    split: false
  # The split's role Deployments (values/role) and NATS (values/nats): off unless jc.server.split.
  # `resources` per role: requests about 1.25x the role's share of jc's one-process RSS (T-7014).
  shako:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    resources:
      requests: { cpu: 20m, memory: 416Mi }
      limits: { cpu: '1', memory: 1Gi }
  daiya:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    resources:
      requests: { cpu: 20m, memory: 320Mi }
      limits: { cpu: '1', memory: 768Mi }
  dataroom:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    resources:
      requests: { cpu: 20m, memory: 448Mi }
      limits: { cpu: '1', memory: 1Gi }
  nats:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
  # The App functions runtime beside jc (values/functions): its realm is realmImport's, its
  # gateway and identity jc's public hosts (host mode), reached over the edge (edgeAddress).
  functions:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
  # A Prometheus of another instance on the same cluster, read through prom-label-proxy with every
  # query pinned to namespace=<this namespace>: jc's daiya gets datasource `prometheus` (org 1) on
  # the proxy and may reach that one address ([daiya] prometheus_reach). Off: no proxy, no datasource.
  metricsProxy:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    # http://<prometheus service>.<namespace>.svc.cluster.local:9090
    upstream: ''
  # Scoped cluster logins for the s1 automation (T-7496, charts/logins): the orgs watch's read-only
  # ServiceAccount. Only jc-dev and jc-prod run the watch.
  logins:
    enabled: {{ has .Environment.Name (list "jc-dev" "jc-prod") }}
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    # The namespace of the Prometheus the watch reads with promtool ('' = none).
    prometheusNamespace: 'dev'
