---
jc:
  server:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    # The public host every mount answers on (slug mode: /id, /opendata, /dashboards and the
    # Portal at the root): jc.{domain}, so nothing collides with the separate components' hosts
    # while both run on one cluster.
    subDomain: jc
    # host: every old host name keeps answering (bins/jc CUTOVER.md section 4): the Portal on
    # portal.{domain}, kaisatsu on idm., the gateway on api. and its paths on the apex and portal.,
    # dataroom on opendata., daiya at {domain}/grafana, shako at {domain}/git. `subDomain` is then
    # unused and `hosts` lists every host the edge routes to jc ("" is the apex) and its
    # certificate names; a host no mount claims answers jc's 404.
    mode: slug
    hosts: ["", idm, portal, api, opendata, data, assistant, viz]
    # Pool ceilings on the shared postgres-cluster (tests/test_postgres_connection_budget.py):
    # kaisatsu's request role, Antares' store. The Portal's pool is compiled in (5).
    kaisatsuPool: 4
    antaresPool: 8
    # shako's repositories and ekiben's file root.
    dataSize: 5Gi
  # A Prometheus of another instance on the same cluster, read through prom-label-proxy with every
  # query pinned to namespace=<this namespace>: jc's daiya gets datasource `prometheus` (org 1) on
  # the proxy and may reach that one address ([daiya] prometheus_reach). Off: no proxy, no datasource.
  metricsProxy:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "jc") }}
    # http://<prometheus service>.<namespace>.svc.cluster.local:9090
    upstream: ''
