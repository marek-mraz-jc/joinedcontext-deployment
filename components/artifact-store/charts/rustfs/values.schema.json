{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "values of rustfs (T-4956: an unknown key is a typo and fails the render)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "bootstrapImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "bucket": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "credentialsSecret": {
      "type": "string"
    },
    "accessKeyIdKey": {
      "type": "string"
    },
    "secretAccessKeyKey": {
      "type": "string"
    },
    "objectLock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultRetentionDays": {
          "type": "number"
        }
      }
    },
    "appsBucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "retiredPrefix": {
          "type": "string"
        },
        "retiredExpiryDays": {
          "type": "number"
        }
      }
    },
    "backupBucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefix": {
          "type": "string"
        },
        "expiryDays": {
          "type": "number"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "number"
        }
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "number"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "serviceMesh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    }
  }
}
