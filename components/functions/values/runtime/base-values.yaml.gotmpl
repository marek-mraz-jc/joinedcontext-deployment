{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> /healthz
# - [x] Graceful shutdown
# - [x] Standard labels
# - [x] ServiceAccount with least privilege where required -> no API token
# - [x] Named ports -> 8080 container mapped to 8080 service
# - [ ] Ingress with TLS -> not applicable, reached from the Portal alone

fullnameOverride: jc-functions
nameOverride: functions-runtime

{{- $images := index .Values.images "functions" "runtime" }}
image:
  repository: {{ $images.repository }}
  tag: {{ $images.tag | quote }}
  digest: {{ $images.digest }}
  pullPolicy: IfNotPresent

# The image's entrypoint is the gateway; the runtime is the binary beside it.
command:
  - /usr/local/bin/jc-functions

containerPort: 8080

service:
  enabled: true
  type: ClusterIP
  port: 8080
  targetPort: 8080
  name: http

probes:
  readiness:
    path: /healthz
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3
  liveness:
    path: /healthz
    periodSeconds: 15
    timeoutSeconds: 3
    failureThreshold: 3
    initialDelaySeconds: 5

# No credential: the runtime verifies the Portal's token (audience jc-functions, azp portal-api)
# and passes each caller's own token to the gateway (SDK-23).
env:
  JC_FUNCTIONS_BIND: "0.0.0.0:8080"
  JC_OIDC_ISSUER: "https://idm.{{ $global.domain }}/realms/{{ $global.instanceSlug }}"
  # The signing keys over the in-cluster Service, as the gateway reads them.
  JC_OIDC_JWKS_URL: "http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local:80{{ .Values.keycloak.app.pathPrefix | trimSuffix "/" }}/realms/{{ $global.instanceSlug }}/protocol/openid-connect/certs"
  JC_FUNCTIONS_CALLER: portal-api
  JC_FUNCTIONS_AUDIENCE: jc-functions
  JC_GATEWAY_URL: "http://context-gateway.{{ index .Values "context-gateway" "gateway" "namespace" }}.svc.cluster.local:8080"

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
