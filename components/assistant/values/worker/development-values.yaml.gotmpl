# Checklist:
# - [x] Minimal Resources -> one crawl at a time; kreuzberg holds a PDF and its text in memory
# - [x] Minimal storage -> the index lives in PostgreSQL
# - [x] 1 Replica -> the queue would let more claim jobs, one is what a city's sites need

replicaCount: 1

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    cpu: '1'
    memory: 1Gi
