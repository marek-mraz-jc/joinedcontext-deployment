---
pipeline-runner:
  runner:
    enabled: true
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "pipeline-runner") }}
    project: helsinki
    # The development profile's streams are values/runner/development-values.yaml.gotmpl.
    streams: {}
  # Scheduled pipelines (PL-04, PL-26, PL-27): one CronJob per pipeline, each pod alive only
  # for the fetch. Off until there is a pipeline to run — an enabled release with no pipelines
  # is a Helm release that owns nothing.
  scheduled:
    enabled: false
    namespace: {{ include "jc.namespace" (dict "global" .Values.global "suffix" "pipeline-runner") }}
    project: helsinki
    # name: { periodSeconds | schedule, config } — see components/pipeline-runner/README.md
    pipelines: {}
