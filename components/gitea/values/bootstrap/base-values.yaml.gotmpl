---
{{- $global := .Values.global }}
{{- $repo := $global.configRepo }}
# Checklist:
# - [x] Runs as non-root with `readOnlyRootFilesystem` -> /tmp is the one writable path
# - [ ] Health probes -> not applicable, a Job either exits 0 or is retried
# - [x] Standard labels
# - [x] ServiceAccount with least privilege -> two Secrets by name, nothing else
# - [ ] Named ports, Service, Ingress -> not applicable, it listens on nothing

# The forge in-cluster, not its public URL. Under a self-signed cluster issuer the public
# host is served with the cluster CA and curl in this image trusts the Mozilla bundle only,
# so a public URL fails at the handshake for the same reason the Portal needs JC_OIDC_CA_FILE.
giteaUrl: "http://gitea-http.{{ .Values.gitea.forge.namespace }}.svc.cluster.local:3000"

{{- /* Every team the forge's group map can land a person in, so the team exists before the
       first login tries to join it (PF-79). */}}
teams:
{{- range $group, $teams := .Values.gitea.forge.groupTeams | default dict }}
{{- range $teams }}
  {{ . }}: {}
{{- end }}
{{- end }}
{{- if not (.Values.gitea.forge.groupTeams | default dict) }} {}
{{- end }}

repo:
  owner: {{ $repo.owner | quote }}
  name: {{ $repo.name | quote }}
  branch: {{ $repo.branch | quote }}

# A token minted at run time cannot be copied by the secrets component, so the Job writes each
# one where it is read. Under `singleNamespace: true` these are all the same string and the
# chart renders one Role; under `false` each consumer has its own.
tokens:
  portal:
    namespaces:
      - {{ .Values.gitea.bootstrap.namespace }}
      {{- if has "portal" .Values.components }}
      - {{ .Values.portal.portal.namespace }}
      {{- end }}
  gateway:
    namespaces:
      - {{ .Values.gitea.bootstrap.namespace }}
      {{- if has "context-gateway" .Values.components }}
      - {{ index .Values "context-gateway" "gateway" "namespace" }}
      {{- end }}

# The same image the forge runs, so the Job pulls nothing the node does not already have and
# there is one digest to re-pin instead of two. It carries curl, sed and base64 and runs as
# uid 1000; it does not carry jq, which is why nothing here parses a response body it has not
# first checked the shape of.
{{- $image := index .Values.images "gitea" "forge" }}
image:
  repository: "{{ $image.registry }}/{{ $image.repository }}"
  tag: "{{ $image.tag }}-rootless"
  digest: {{ $image.digest }}
  pullPolicy: IfNotPresent

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

serviceMesh:
  enabled: {{ and ($global.serviceMesh.enable | default false) (eq ($global.serviceMesh.type | default "") "linkerd") }}
