---
# The projects' seed (T-3998): one ConfigMap per project, gitea-seed-<project>, mounted by the
# bootstrap Job beside the organization's files, which stay in gitea-bootstrap. A release of its
# own for the reason the sample apps have theirs (T-3175): Helm keeps a release in one Secret of
# at most 1 MiB, and the Helsinki transit seed took gitea-bootstrap past its budget.
configMaps: gitea-seed
apps: {}

{{- /* dev's seeds rendered for a production instance that reads dev's values (T-4678): its own
       hosts, the owner where the seeds name the demo steward, and no other demo person. */}}
{{- if and (eq .Values.global.profile "production") .Values.global.valuesProfile }}
rewrites:
  # The seeds name the catalogue opendata.dev.joinedcontext.com, so the domain rule below moves it too (T-4679).
  - from: 'dev\.joinedcontext\.com'
    to: {{ .Values.global.domain | quote }}
  - from: 'demo\.steward@[A-Za-z0-9.-]+'
    to: {{ .Values.global.initialUserEmail | quote }}
  - from: '(?m)^[ \t]*- user: demo\.[a-z]+@[A-Za-z0-9.-]+[ \t]*\r?\n'
    to: ''
{{- end }}
