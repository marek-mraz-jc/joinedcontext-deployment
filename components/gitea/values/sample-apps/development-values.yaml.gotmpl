# The sample applications' files (T-2599), one ConfigMap each, read by the bootstrap Job
# (values/bootstrap names the same files). JSON strings, not block scalars: a block scalar
# rewrites trailing newlines, and a file the seed changed on the way would never match the blob
# already on the forge, so every run would commit again.
# An app lives in the release its name hashes to (gitea-sample-apps, -2, -3; T-3333), its
# ConfigMap named gitea-sample-apps-<app> whichever it is, so the Job and the smoke find it.
{{- $shard := .Release.Name | trimPrefix "gitea-sample-apps" | trimPrefix "-" | default "1" | atoi }}
apps:
{{- $apps := readFile "../../apps/index.yaml" | fromYaml }}
{{- range $app, $files := $apps.apps }}
{{- if eq (add1 (mod (adler32sum $app | atoi) 3)) $shard }}
  {{ $app }}:
{{- range $files }}
    {{ . | replace "/" "__" | quote }}: {{ readFile (printf "../../apps/%s/%s" $app .) | toJson }}
{{- end }}
{{- end }}
{{- end }}
