{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "joinedcontext deployment component schema",
  "type": "object",
  "required": ["component", "parts"],
  "properties": {
    "component": {
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "description": "The releases built from this component's charts.yaml and values; empty for a component whose helmfile writes its releases itself (prepare, runtime-policies)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "description": "Per-release helm wait timeout in seconds; overrides helmDefaults.timeout"
          },
          "valuesFrom": {
            "type": "string",
            "minLength": 1,
            "description": "Another part of the same component whose values/<part>/ directory this release renders with; the release keeps its own name"
          },
          "extraLabels": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z0-9_.-]+$": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^.]+\\.[^.]+$",
              "description": "Must be in the format 'component.part'",
              "examples": ["postgres.operator", "kafka.cluster"]
            },
            "uniqueItems": true
          },
          "hooks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["events", "command"],
              "properties": {
                "events": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "description": "List of hook events (e.g. presync, preapply, sync, postsync)"
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Executable/command for the hook"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Arguments passed to the command; multiline scripts can be a single string item"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
