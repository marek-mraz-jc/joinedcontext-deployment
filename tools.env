# The versions of every tool CI and `just` render, validate and apply with (docs/analysis/iac-practices.md R3).
# One KEY=value per line, no quotes, no spaces: .github/actions/tools appends the file to $GITHUB_ENV.
# Renovate bumps each version through the comment above it, no earlier than 7 days after the release.
# A bump leaves the checksum stale on purpose: the download step fails until a reviewer pins the sha256 of
# the new asset (`curl -fsSL <url> | sha256sum`, or the release's own checksum file).

# renovate: datasource=github-releases depName=helmfile/helmfile
HELMFILE_VERSION=v1.8.1
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.0
# renovate: datasource=github-releases depName=databus23/helm-diff
HELM_DIFF_VERSION=v3.15.15
# The cluster's Kubernetes version (k3s v1.33.7+k3s1, hetzner-kit): kubeconform validates against its schemas.
# It moves with the cluster, not with upstream releases, so Renovate leaves it alone.
KUBERNETES_VERSION=1.33.7

# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_CHECKSUM=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
# renovate: datasource=github-releases depName=open-policy-agent/conftest extractVersion=^v(?<version>.+)$
CONFTEST_VERSION=0.69.0
CONFTEST_CHECKSUM=96fc2fbf11f0afde51256647127e6f00a64ce839a4d9a0a1aef2426c0e6f4b3f
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v(?<version>.+)$
GITLEAKS_VERSION=8.29.0
GITLEAKS_CHECKSUM=39e07ad810336fd0ae80d0bd61c60d0521f628173e7583583b5df4a38738522c
# renovate: datasource=github-releases depName=kyverno/kyverno
KYVERNO_VERSION=v1.19.0
KYVERNO_CHECKSUM=f5b4dc73c8e2f3f66e8e0034dc370e6eb6c4617eff7d5ae3838d2200034eb421
# renovate: datasource=github-releases depName=getsops/sops
SOPS_VERSION=v3.13.3
SOPS_CHECKSUM=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
# renovate: datasource=github-releases depName=FiloSottile/age
AGE_VERSION=v1.2.1
AGE_CHECKSUM=7df45a6cc87d4da11cc03a539a7470c15b1041ab2b396af088fe9990f7c79d50
# renovate: datasource=github-releases depName=aquasecurity/trivy extractVersion=^v(?<version>.+)$
TRIVY_VERSION=0.75.0
TRIVY_CHECKSUM=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
# renovate-config-validator in ci.yml.
# renovate: datasource=npm depName=renovate
RENOVATE_VERSION=44.155.1
