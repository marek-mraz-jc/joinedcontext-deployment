<https://joinedcontext.com/models/sdm/extensions/TrafficSignalJunction> a owl:Ontology ;
    rdfs:label "TrafficSignalJunction" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "TrafficSignalJunction, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "One junction or crossing with traffic lights or warning lights: where it is, its installation number, its signal kind and whether it is in service. Extends dataModel.PointOfInterest/PointOfInterest: the pinned Smart Data Models hold no traffic signal or signalised junction, and PointOfInterest's category lists services and amenities." .

linkml:topValue a owl:DatatypeProperty ;
    rdfs:label "value" .

