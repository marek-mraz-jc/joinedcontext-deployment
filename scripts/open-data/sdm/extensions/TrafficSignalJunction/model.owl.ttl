jc:TrafficSignalJunction a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TrafficSignalJunction" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:signalKind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:junctionNumber ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
        jc:Entity ;
    skos:definition "One junction or crossing with traffic lights or warning lights: where it is, its installation number, its signal kind and whether it is in service." ;
    skos:exactMatch jc:TrafficSignalJunction ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/TrafficSignalJunction> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.PointOfInterest/PointOfInterest/schema.json" .

