    skos:definition "A petition filed with the publisher and how it was settled." ;
    skos:exactMatch jc:Petition ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/Petition> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.CPSV-AP/Evidence/schema.json" .

