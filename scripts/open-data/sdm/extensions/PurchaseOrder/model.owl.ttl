        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:mena ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:suma ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
