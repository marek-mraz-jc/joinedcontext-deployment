    rdfs:label "PurchaseOrder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dodavatel ],
