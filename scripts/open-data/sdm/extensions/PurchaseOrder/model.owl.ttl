            owl:maxCardinality 1 ;
            owl:onProperty jc:isPartOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:iCO ],
        jc:Entity ;
    skos:definition "An order the publisher issued and published." ;
    skos:exactMatch jc:PurchaseOrder ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/PurchaseOrder> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.CPSV-AP/Cost/schema.json" .

