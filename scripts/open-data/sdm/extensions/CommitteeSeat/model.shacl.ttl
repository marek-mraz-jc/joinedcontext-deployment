@prefix geojson: <https://purl.org/geojson/vocab#> .
@prefix jc: <https://joinedcontext.com/models/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix ns1: <https://w3id.org/linkml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdm: <https://smartdatamodels.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://joinedcontext.com/models/sdm/extensions/CommitteeSeat> ns1:generator_version "linkml-1.11.1" .

jc:CommitteeSeat a sh:NodeShape ;
    rdfs:comment "A seat of a council committee; the citizens' names are kept out." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path ngsi-ld:observedAt ],
        [ sh:datatype xsd:string ;
            sh:description "The source column `Pozícia`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jc:pozicia ],
        [ sh:datatype xsd:string ;
            sh:description "The source column `Poznámka`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path jc:poznamka ],
        [ sh:description "The service the row was read from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path sdm:source ],
        [ sh:datatype xsd:string ;
            sh:description "The source column `Názov_komisie`." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path sdm:name ],
        [ sh:description "The catalogue dataset the row belongs to, where its licence and its other rows are." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path jc:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:description "Who published the row, with the credit its licence asks for." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path sdm:dataProvider ],
        [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path geojson:geometry ] ;
    sh:targetClass jc:CommitteeSeat .

ngsi-ld:Entity a sh:NodeShape ;
    rdfs:comment "The root every NGSI-LD entity class specialises." ;
    sh:closed true ;
    sh:ignoredProperties ( sdm:dataProvider jc:poznamka jc:pozicia sdm:name sdm:source rdf:type jc:isPartOf ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ngsi-ld:observedAt ],
        [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path geojson:geometry ] ;
    sh:targetClass ngsi-ld:Entity .

