<https://joinedcontext.com/models/sdm/extensions/RiverBasin> a owl:Ontology ;
    rdfs:label "RiverBasin" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "RiverBasin, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "A river basin of the region. Extends dataModel.PointOfInterest/PointOfInterest: OpenStreetMap OSMWater requires osmId and osmType, which the region's register has not." .

