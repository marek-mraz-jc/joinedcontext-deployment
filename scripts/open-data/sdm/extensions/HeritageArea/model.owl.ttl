@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix jc: <https://joinedcontext.com/models/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jc:Boolean a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Boolean ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Curie a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Curie ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Date a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Date ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:DateOrDatetime a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:DateOrDatetime ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Decimal a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Decimal ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Double a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Double ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Entity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:observedAt ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:type ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:location ] ;
    skos:definition "The root every NGSI-LD entity class specialises." ;
    skos:exactMatch ngsi-ld:Entity ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:Float a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Float ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:HeritageArea a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "HeritageArea" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:heritageCategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dateModified ],
        jc:Entity ;
    skos:definition "One area of a city's cultural heritage map: its outline and its kind, such as a fortification or a historic park." ;
    skos:exactMatch jc:HeritageArea ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.PointOfInterest/PointOfInterest/schema.json" .

jc:Integer a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Integer ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Jsonpath a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Jsonpath ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Jsonpointer a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Jsonpointer ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Ncname a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Ncname ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Nodeidentifier a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Nodeidentifier ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Objectidentifier a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Objectidentifier ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Sparqlpath a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Sparqlpath ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Time a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Time ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Uriorcurie a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Uriorcurie ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:dataProvider a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataProvider" ;
    skos:definition "Who published the row, with the credit its licence asks for." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.PointOfInterest/7e5e24963a142b9bf6fd15b144a0e24588217608/context.jsonld" .

jc:dateModified a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dateModified" ;
    rdfs:range jc:Datetime ;
    skos:definition "When the publisher last changed the record, or the station last reported." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.PointOfInterest/7e5e24963a142b9bf6fd15b144a0e24588217608/context.jsonld" .

jc:description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    skos:definition "A short description, per language." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.PointOfInterest/7e5e24963a142b9bf6fd15b144a0e24588217608/context.jsonld" .

jc:heritageCategory a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "heritageCategory" ;
    skos:definition "What kind of protected or valued cultural landscape the area is: a strongpoint of the First World War land fortifications, or one of the kinds of the city's landscape culture map." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" .

jc:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    skos:definition "The entity id, urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:jsonld_keyword "@id" ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "location" ;
    rdfs:range jc:String ;
    skos:definition "Where the entity is, as GeoJSON geometry." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "GeoProperty" ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    skos:definition "The name, per language." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.PointOfInterest/7e5e24963a142b9bf6fd15b144a0e24588217608/context.jsonld" .

jc:observedAt a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "observedAt" ;
    rdfs:range jc:Datetime ;
    skos:definition "When the observation the entity reports was made." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source" ;
    rdfs:range jc:Uri ;
    skos:definition "The service the row was read from." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.PointOfInterest/7e5e24963a142b9bf6fd15b144a0e24588217608/context.jsonld" .

jc:type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "type" ;
    skos:definition "The entity type, one class of a published data model." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/HeritageArea> ;
    jc:jsonld_keyword "@type" ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:String a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:String ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Uri a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Uri ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Datetime a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Datetime ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

<https://joinedcontext.com/models/sdm/extensions/HeritageArea> a owl:Ontology ;
    rdfs:label "HeritageArea" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "HeritageArea, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "One area of a city's cultural heritage map: its outline and its kind, such as a fortification or a historic park. Extends dataModel.PointOfInterest/PointOfInterest: PointOfInterest's category lists services and amenities, not the kinds of a heritage map, and no Smart Data Model holds a heritage area." .

linkml:topValue a owl:DatatypeProperty ;
    rdfs:label "value" .

