<https://joinedcontext.com/models/sdm/extensions/RadonRiskArea> a owl:Ontology ;
    rdfs:label "RadonRiskArea" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "RadonRiskArea, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "One area of a radon risk map and the risk category of its ground. Extends dataModel.PointOfInterest/PointOfInterest: Environment has no model of a mapped ground property; EnvironmentObserved is a measurement at a time." .

