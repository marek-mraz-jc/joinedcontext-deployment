@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jc:Article a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Article" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:isPartOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:modifiedGmt ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dateGmt ],
        jc:Entity ;
    skos:definition "A news article the publisher posted." ;
    skos:exactMatch jc:Article ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/Article> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.CPSV-AP/Evidence/schema.json" .

jc:Entity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:observedAt ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:type ] ;
    skos:definition "The root every NGSI-LD entity class specialises." ;
    skos:exactMatch ngsi-ld:Entity ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/Article> ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:boolean a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:boolean ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

