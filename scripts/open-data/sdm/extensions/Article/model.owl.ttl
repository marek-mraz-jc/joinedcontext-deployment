<https://joinedcontext.com/models/sdm/extensions/Article> a owl:Ontology ;
    rdfs:label "Article" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "Article, an extension of dataModel.CPSV-AP/Evidence" ;
    skos:definition "A news article the publisher posted. Extends dataModel.CPSV-AP/Evidence: CPSV-AP Evidence is the official model of a document a public body issues (identifier, name, relatedDocumentation); no subject holds news." .

linkml:topValue a owl:DatatypeProperty ;
    rdfs:label "value" .

