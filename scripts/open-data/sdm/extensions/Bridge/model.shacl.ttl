ngsi-ld:Entity a sh:NodeShape ;
    rdfs:comment "The root every NGSI-LD entity class specialises." ;
    sh:closed true ;
    sh:ignoredProperties ( jc:rokZasadnejRekonstrukcie jc:vlastnik jc:vynimocnaZatazitelnostT jc:okres jc:dataset rdf:type jc:hodnotenie jc:ojedinelaZatazitelnostT jc:identifikacneCislo sdm:name jc:komunikacia jc:normalnaZatazitelnostT sdm:source jc:ulica jc:pocetDilCelkov jc:zatazitelnostNaJednuNapravu jc:docasnostMosta jc:legislativnyStav jc:dlzkaPremosteniaM jc:rokKonstrukcie jc:typPamiatky jc:triedaCesty jc:spravca jc:aktualnyStavebnotechnickyStav jc:obec jc:vyhradnaZatazitelnostT jc:predmetPremostenia sdm:dataProvider jc:typKomunikacie jc:materialNosnejKonstrukcie jc:druhNosnejKonstrukcie ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ngsi-ld:observedAt ],
        [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path geojson:geometry ] ;
    sh:targetClass ngsi-ld:Entity .

