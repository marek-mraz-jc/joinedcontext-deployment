<https://joinedcontext.com/models/sdm/extensions/Bridge> a owl:Ontology ;
    rdfs:label "Bridge" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "Bridge, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "A bridge on a road the region owns or manages. Extends dataModel.PointOfInterest/PointOfInterest: Transportation Road and RoadSegment require roadClass, refRoad, startPoint and endPoint, which a structure register has not; PointOfInterest is a located named thing." .

