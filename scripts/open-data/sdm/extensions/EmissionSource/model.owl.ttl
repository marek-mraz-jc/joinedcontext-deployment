            owl:qualifiedCardinality 1 ] .

jc:Float a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Float ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

<https://joinedcontext.com/models/sdm/extensions/EmissionSource> a owl:Ontology ;
    rdfs:label "EmissionSource" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "EmissionSource, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "One stationary source of air pollution of a city's emission register: where it is, its fuel and its yearly emissions. Extends dataModel.PointOfInterest/PointOfInterest: Environment's AirQualityObserved and EnvironmentObserved hold concentrations measured at a station; no model holds a register entry of yearly emissions." .

linkml:topValue a owl:DatatypeProperty ;
    rdfs:label "value" .

