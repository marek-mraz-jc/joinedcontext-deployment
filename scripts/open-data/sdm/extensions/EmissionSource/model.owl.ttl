        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Date ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:DateOrDatetime a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:DateOrDatetime ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Decimal a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Decimal ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:Double a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Double ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:EmissionSource a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "EmissionSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:vocEmission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:pm25Emission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:coEmission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:so2Emission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:noxEmission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:registerCategory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:fuelType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:pm10Emission ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
        jc:Entity ;
    skos:definition "One stationary source of air pollution of a city's emission register: where it is, its fuel and its yearly emissions." ;
    skos:exactMatch jc:EmissionSource ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/EmissionSource> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.PointOfInterest/PointOfInterest/schema.json" .

jc:Entity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:observedAt ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:location ] ;
    skos:definition "The root every NGSI-LD entity class specialises." ;
    skos:exactMatch ngsi-ld:Entity ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/EmissionSource> ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:Integer a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:Integer ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

