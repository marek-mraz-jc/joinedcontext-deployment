<https://joinedcontext.com/models/sdm/extensions/AdministrativeArea> a owl:Ontology ;
    rdfs:label "AdministrativeArea" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "AdministrativeArea, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "A region, district or municipality: its boundary or centroid and its NUTS and LAU codes. Extends dataModel.PointOfInterest/PointOfInterest: OpenStreetMap OSMBoundary requires osmId and osmType, which the region's register has not." .

