ngsi-ld:Entity a sh:NodeShape ;
    rdfs:comment "The root every NGSI-LD entity class specialises." ;
    sh:closed true ;
    sh:ignoredProperties ( jc:iDN4 jc:nUTS2CODE jc:fLON jc:fLAT jc:lAU2CODE jc:nUTS1 jc:nUTS1CODE jc:iDN3 jc:typObce jc:nM2 jc:nM3 jc:lAU1 jc:dOW jc:lAU1CODE sdm:source rdf:type jc:nUTS2 jc:iDN2 sdm:name jc:dataset jc:nUTS3CODE jc:fACC jc:vYMERA sdm:dataProvider jc:nUTS3 jc:lAU2 ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ngsi-ld:observedAt ],
        [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path geojson:geometry ] ;
    sh:targetClass ngsi-ld:Entity .

