ngsi-ld:Entity a sh:NodeShape ;
    rdfs:comment "The root every NGSI-LD entity class specialises." ;
    sh:closed true ;
    sh:ignoredProperties ( jc:spravcaMostu jc:spravca jc:najblizsiKM jc:kraj sdm:name jc:typPodjazdu jc:okres jc:rokStavby jc:triedaPK jc:vynimocnaZatazitelnostT jc:material jc:vlastnikUseku jc:druhZabezpecenia sdm:dataProvider jc:dataset jc:celkovaDlzkaPodjazdu jc:vyhradnaZatazitelnostT jc:druhKonstrukcie jc:spravcaUseku jc:predmetPremostenia jc:jICZSR jc:vlastnikMostu jc:typSpravcu jc:vlastnik rdf:type jc:normanaZatazitelnostT sdm:source jc:minVyskaPodjazdu jc:pocetKolaji jc:materialPriepustu jc:cisloPK jc:stavebnoTechnickyStav ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path geojson:geometry ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ngsi-ld:observedAt ] ;
    sh:targetClass ngsi-ld:Entity .

