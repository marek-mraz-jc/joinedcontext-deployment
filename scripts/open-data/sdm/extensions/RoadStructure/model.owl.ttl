<https://joinedcontext.com/models/sdm/extensions/RoadStructure> a owl:Ontology ;
    rdfs:label "RoadStructure" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "RoadStructure, an extension of dataModel.PointOfInterest/PointOfInterest" ;
    skos:definition "An underpass, culvert, expansion joint or level crossing on a regional road. Extends dataModel.PointOfInterest/PointOfInterest: as Bridge: a located structure of a road, not a road." .

