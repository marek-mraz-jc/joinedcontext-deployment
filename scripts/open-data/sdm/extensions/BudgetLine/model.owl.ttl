@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix jc: <https://joinedcontext.com/models/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ngsi-ld: <https://uri.etsi.org/ngsi-ld/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jc:BudgetLine a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "BudgetLine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:fiscalYear ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:dataProvider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:adjustedAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:budgetPurpose ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:budgetItem ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:approvedAmount ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:budgetFunction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:budgetArea ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:source ],
        jc:Entity ;
    skos:definition "One line of a city budget in the national budget classification, with the approved and the adjusted amount." ;
    skos:exactMatch jc:BudgetLine ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:upstream_source "https://smart-data-models.github.io/dataModel.CPSV-AP/Cost/schema.json" .

jc:Entity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:observedAt ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty jc:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jc:location ] ;
    skos:definition "The root every NGSI-LD entity class specialises." ;
    skos:exactMatch ngsi-ld:Entity ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:adjustedAmount a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "adjustedAmount" ;
    rdfs:range jc:float ;
    skos:definition "The amount after the year's budget changes so far, in the same unit as the approved one." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:approvedAmount a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "approvedAmount" ;
    rdfs:range jc:float ;
    skos:definition "The amount the council approved, as the city publishes it. The city's documentation names no unit; the 2026 expenditure lines add up to 119 054 085, which is the size of Prague's budget in thousands of CZK." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:boolean a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:boolean ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:budgetArea a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "budgetArea" ;
    skos:definition "The city's own area of the line (oblast), its code and name joined, such as 09 Školství; absent on a correction line the city files under none." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:budgetFunction a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "budgetFunction" ;
    skos:definition "The section of the national budget classification (paragraf, ODPA), code and name." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:budgetItem a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "budgetItem" ;
    skos:definition "The item of the national budget classification (položka), code and name. Items 1xxx to 4xxx are revenue, 5xxx and 6xxx expenditure, 8xxx financing." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:budgetPurpose a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "budgetPurpose" ;
    skos:definition "The earmark of the line (účelový znak), code and name." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:curie a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange jc:curie ;
            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:dataProvider a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "dataProvider" ;
    skos:definition "Who published the row, with the credit its licence asks for." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.CPSV-AP/a05d1663475fc0f79361bc9bc2550c3f24df1ba0/context.jsonld" .

jc:date a owl:Class,
