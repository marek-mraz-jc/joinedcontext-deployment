            owl:onProperty linkml:topValue ;
            owl:qualifiedCardinality 1 ] .

jc:fiscalYear a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "fiscalYear" ;
    rdfs:range jc:integer ;
    skos:definition "The budget year." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" .

jc:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    skos:definition "The entity id, urn:ngsi-ld:{Type}:{orgDomain}:{space}:{localId}." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:jsonld_keyword "@id" ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "ETSI NGSI-LD core context v1.8" .

jc:identifier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "identifier" ;
    skos:definition "The budget line's own key, the year and its codes of area, function, item and purpose (`mhmp-2026-00-612100-5011-000000000`), the identifier the BudgetLine extension requires." ;
    skos:inScheme <https://joinedcontext.com/models/sdm/extensions/BudgetLine> ;
    jc:ngsi_ld_kind "Property" ;
    jc:upstream_source "https://raw.githubusercontent.com/smart-data-models/dataModel.CPSV-AP/a05d1663475fc0f79361bc9bc2550c3f24df1ba0/context.jsonld" .

jc:jsonpath a owl:Class,
