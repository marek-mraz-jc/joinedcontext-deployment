<https://joinedcontext.com/models/sdm/extensions/BudgetLine> a owl:Ontology ;
    rdfs:label "BudgetLine" ;
    dcterms:license "https://joinedcontext.com/licenses/cc-by-4.0" ;
    dcterms:title "BudgetLine, an extension of dataModel.CPSV-AP/Cost" ;
    skos:definition "One line of a city budget in the national budget classification, with the approved and the adjusted amount. Extends dataModel.CPSV-AP/Cost: CPSV-AP Cost is the official model of an amount a public body sets (identifier, value, currency); no subject holds a budget line." .

linkml:topValue a owl:DatatypeProperty ;
    rdfs:label "value" .

