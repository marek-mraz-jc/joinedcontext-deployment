ngsi-ld:Entity a sh:NodeShape ;
    rdfs:comment "The root every NGSI-LD entity class specialises." ;
    sh:closed true ;
    sh:ignoredProperties ( jc:layer sdm:name sdm:source jc:stav rdf:type jc:alps jc:spr jc:sourceId jc:farba jc:isPartOf sdm:dataProvider jc:ctt jc:povrch jc:typ jc:fNazov jc:zdroj jc:fName jc:obnRok jc:nazov jc:dlzka jc:spravca ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "When the observation the entity reports was made." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ngsi-ld:observedAt ],
        [ sh:datatype xsd:string ;
            sh:description "Where the entity is, as GeoJSON geometry." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path geojson:geometry ] ;
    sh:targetClass ngsi-ld:Entity .

